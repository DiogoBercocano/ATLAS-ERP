<?xml version="1.0" encoding="utf-8"?>
<!--
  Hardening da pasta de uploads — defense in depth (camada requestFiltering).

  Objetivo: garantir que qualquer request a /Content/images/* só passe se for
  um verbo seguro e uma extensão de imagem conhecida — independente de qual
  handler ou módulo esteja ativo.

  POR QUE SÓ requestFiltering AQUI:
    <handlers> e <staticContent> estão sujeitos a section-locking no IIS real
    (overrideModeDefault="Deny" em applicationHost.config). Defini-los em
    subdiretório causa 500.19 em produção. A solução correta é defini-los via
    <location path="Content/images"> no Web.config raiz — o app-root tem
    autoridade irrestrita sobre qualquer path da aplicação.

  <requestFiltering> tem overrideModeDefault="Allow" em todas as versões do IIS
  e IIS Express — seguro definir em subdiretório.

  VER TAMBÉM: Web.config raiz — <location path="Content/images"> para:
    - Restrição de handler (StaticFile-only, <clear/>)
    - Cache-Control de 7 dias
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- Apenas verbos de leitura. POST/PUT/DELETE são bloqueados antes de qualquer handler. -->
        <verbs allowUnlisted="false">
          <add verb="GET"     allowed="true" />
          <add verb="HEAD"    allowed="true" />
          <add verb="OPTIONS" allowed="true" />
        </verbs>
        <!--
          Whitelist de extensões: apenas imagens reconhecidas.
          Bloqueia: .aspx .ashx .php .exe .dll .config e qualquer extensão não listada.
          Mesmo que um arquivo malicioso passe pelo UploadValidator, esta camada impede
          que o IIS sequer aceite a request — antes de chegar ao handler.
        -->
        <fileExtensions allowUnlisted="false">
          <add fileExtension=".jpg"  allowed="true" />
          <add fileExtension=".jpeg" allowed="true" />
          <add fileExtension=".png"  allowed="true" />
          <add fileExtension=".gif"  allowed="true" />
          <add fileExtension=".webp" allowed="true" />
          <add fileExtension=".svg"  allowed="true" />
          <add fileExtension=".ico"  allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
