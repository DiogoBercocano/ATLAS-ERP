<?xml version="1.0" encoding="utf-8"?>

<!-- Transformações aplicadas em builds Release (msbuild /p:Configuration=Release). -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <!-- Hardening HTTP em produção:
         - Força redirect para HTTPS
         - HSTS já habilitado por padrão (e só emite sob HTTPS)
         - Preload do HSTS (descomente apenas após registro em hstspreload.org)
    -->
    <add key="Security:RequireHttps" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <!--
    <add key="Security:HstsPreload" value="true"
         xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    -->
  </appSettings>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />

    <!-- Cookies só sob HTTPS em produção. -->
    <httpCookies xdt:Transform="SetAttributes(requireSSL)" requireSSL="true" />

    <!-- customErrors em On para nunca expor stack trace em produção,
         mesmo quando acessado de localhost no servidor. -->
    <customErrors mode="On" xdt:Transform="SetAttributes(mode)" />
  </system.web>
</configuration>
