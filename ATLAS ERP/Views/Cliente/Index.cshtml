@model ATLAS_ERP.Infrastructure.PagedResult<ATLAS_ERP.Models.Cliente>
@{
    ViewBag.Title = "Clientes - Atlas ERP";
    var paged = Model ?? ATLAS_ERP.Infrastructure.PagedResult<ATLAS_ERP.Models.Cliente>.Empty(20);
    var lista = paged.Items;
}

@section bgGlows {
    <div class="bg-glow" style="width:400px;height:400px;top:-100px;right:5%;background:rgba(30,60,130,0.18);"></div>
}

@section styles {
<style>
    :root { --expand-bg:#0d1a2e; }
    .main { padding:32px 40px; }
    .topbar { display:flex; align-items:center; justify-content:space-between; margin-bottom:28px; }
    .page-title { font-family:'Syne',sans-serif; font-size:22px; font-weight:700; }
    .page-subtitle { font-size:13px; color:var(--muted); margin-top:2px; }
    .btn-primary { display:inline-flex; align-items:center; gap:8px; background:var(--accent); color:white; text-decoration:none; font-size:13px; font-weight:500; padding:10px 20px; border-radius:10px; transition:background .18s, transform .15s; box-shadow:0 4px 16px rgba(59,130,246,0.25); border:none; cursor:pointer; }
    .btn-primary:hover { background:#2563eb; transform:translateY(-1px); }
    .btn-primary svg { width:15px; height:15px; }

    .tr-main { border-top:1px solid var(--border); cursor:pointer; transition:background .15s; }
    .tr-main:hover { background:var(--card-hover); }
    .tr-main.expanded { background:var(--card-hover); }
    .tr-main td { padding:14px 20px; font-size:14px; }
    .expand-chevron { display:flex; align-items:center; justify-content:center; width:24px; height:24px; border-radius:6px; background:var(--accent-soft); color:var(--accent-light); transition:transform .22s, background .15s; flex-shrink:0; }
    .expand-chevron svg { width:13px; height:13px; }
    .tr-main.expanded .expand-chevron { transform:rotate(180deg); background:rgba(59,130,246,0.2); }
    .tr-expand { display:none; background:var(--expand-bg); border-top:1px solid var(--border); }
    .tr-expand.open { display:table-row; }
    .expand-panel { padding:20px 24px 20px 60px; display:flex; align-items:center; justify-content:space-between; gap:24px; }
    .expand-details { display:flex; gap:28px; flex-wrap:wrap; }
    .expand-field { display:flex; flex-direction:column; gap:3px; }
    .expand-label { font-size:10px; text-transform:uppercase; letter-spacing:.08em; color:var(--faint); font-weight:500; }
    .expand-value { font-size:13px; color:var(--text); }
    .expand-actions { display:flex; gap:8px; flex-shrink:0; }
    .btn-act { display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:500; padding:8px 14px; border-radius:8px; border:1px solid; cursor:pointer; white-space:nowrap; transition:background .15s, transform .12s; background:none; font-family:inherit; }
    .btn-act:hover { transform:translateY(-1px); }
    .btn-act svg { width:13px; height:13px; }
    .btn-act-edit { border-color:rgba(201,168,76,0.25); color:var(--gold); background:var(--gold-soft); }
    .btn-act-edit:hover { background:rgba(201,168,76,0.2); }
    .btn-act-delete { border-color:rgba(248,113,113,0.25); color:var(--red); background:var(--red-soft); }
    .btn-act-delete:hover { background:rgba(248,113,113,0.2); }

    .status-badge { display:inline-flex; align-items:center; gap:5px; font-size:11px; padding:3px 10px; border-radius:20px; }
    .status-badge.ativo { background:var(--green-soft); color:var(--green); }
    .status-badge.inativo { background:var(--red-soft); color:var(--red); }
    .status-dot { width:5px; height:5px; border-radius:50%; background:currentColor; }
    .row-avatar { width:28px; height:28px; border-radius:50%; background:var(--accent-soft); border:1px solid var(--border-md); display:inline-flex; align-items:center; justify-content:center; font-family:'Syne',sans-serif; font-size:11px; font-weight:700; color:var(--accent-light); margin-right:8px; vertical-align:middle; }

    .modal-row-2 { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
    .modal-danger-icon { width:48px; height:48px; border-radius:50%; background:var(--red-soft); border:2px solid rgba(248,113,113,0.2); display:flex; align-items:center; justify-content:center; margin:0 auto 16px; color:var(--red); }
    .modal-danger-icon svg { width:20px; height:20px; }
    .modal-btn-delete { flex:1; height:44px; background:var(--red); border:none; border-radius:9px; font-family:'Syne',sans-serif; font-size:14px; font-weight:600; color:white; cursor:pointer; transition:background .2s, transform .15s; }
    .modal-btn-delete:hover { background:#ef4444; transform:translateY(-1px); }
    select.modal-input { cursor:pointer; }

    @@media (max-width:700px) { .expand-panel { flex-direction:column; padding:16px; } }
</style>
}

<main class="main">

    <div class="topbar">
        <div>
            <div class="page-title">Clientes</div>
            <div class="page-subtitle">Gerencie os clientes da empresa</div>
        </div>
        <a href="/Cliente/Create" class="btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="16" /><line x1="8" y1="12" x2="16" y2="12" />
            </svg>
            Novo Cliente
        </a>
    </div>

    <div class="table-card">
        <div class="table-header">
            <span class="table-title">Todos os Clientes</span>
            <span class="badge-count">@paged.TotalItems registro(s)</span>
        </div>

        <div class="search-bar">
            <form action="/Cliente" method="get" style="display:contents">
            <div class="search-wrap">
                <input type="text" class="search-input" id="searchInput" name="search"
                       value="@paged.Search"
                       placeholder="Buscar (Enter para busca completa)..." />
                <span class="search-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>
                </span>
            </div>
            </form>
        </div>

        @if (lista.Count > 0)
        {
            <table id="tabelaClientes">
                <thead>
                    <tr>
                        <th style="width:36px;"></th>
                        <th>Nome</th>
                        <th>Documento</th>
                        <th>Telefone</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in lista)
                    {
                        var rowId = "row-" + c.ClienteId;
                        var expId = "exp-" + c.ClienteId;
                        var cLimite = c.LimiteCredito.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                        var cAtivo = c.Ativo ? "true" : "false";

                        <tr class="tr-main" id="@rowId">
                            <td style="padding-left:20px;">
                                <div class="expand-chevron">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9" /></svg>
                                </div>
                            </td>
                            <td>
                                <span class="row-avatar">@(c.Nome?.Length > 0 ? c.Nome[0].ToString().ToUpper() : "?")</span>
                                @c.Nome
                            </td>
                            <td class="td-muted">@(c.Documento ?? "—")</td>
                            <td class="td-muted">@(c.Telefone ?? "—")</td>
                            <td>
                                <span class="status-badge @(c.Ativo ? "ativo" : "inativo")">
                                    <span class="status-dot"></span>
                                    @(c.Ativo ? "Ativo" : "Inativo")
                                </span>
                            </td>
                        </tr>

                        <tr class="tr-expand" id="@expId">
                            <td colspan="5">
                                <div class="expand-panel">
                                    <div class="expand-details">
                                        <div class="expand-field"><span class="expand-label">ID</span><span class="expand-value">#@c.ClienteId</span></div>
                                        <div class="expand-field"><span class="expand-label">Nome</span><span class="expand-value">@c.Nome</span></div>
                                        <div class="expand-field"><span class="expand-label">Documento</span><span class="expand-value">@(c.Documento ?? "—")</span></div>
                                        <div class="expand-field"><span class="expand-label">E-mail</span><span class="expand-value">@(c.Email ?? "—")</span></div>
                                        <div class="expand-field"><span class="expand-label">Telefone</span><span class="expand-value">@(c.Telefone ?? "—")</span></div>
                                        <div class="expand-field"><span class="expand-label">Endereço</span><span class="expand-value">@(c.Endereco ?? "—")</span></div>
                                        <div class="expand-field"><span class="expand-label">Limite de Crédito</span><span class="expand-value">R$ @c.LimiteCredito.ToString("N2")</span></div>
                                        <div class="expand-field"><span class="expand-label">Status</span><span class="expand-value">@(c.Ativo ? "Ativo" : "Inativo")</span></div>
                                    </div>
                                    <div class="expand-actions">
                                        <button type="button" class="btn-act btn-act-edit js-cli-edit"
                                                data-id="@c.ClienteId" data-nome="@(c.Nome ?? "")"
                                                data-doc="@(c.Documento ?? "")" data-email="@(c.Email ?? "")"
                                                data-tel="@(c.Telefone ?? "")" data-end="@(c.Endereco ?? "")"
                                                data-limite="@cLimite" data-ativo="@cAtivo">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                            Editar
                                        </button>
                                        <button type="button" class="btn-act btn-act-delete js-cli-del"
                                                data-id="@c.ClienteId" data-nome="@(c.Nome ?? "")">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M9 6V4h6v2"/></svg>
                                            Excluir
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">Nenhum cliente cadastrado ainda.</div>
        }

        @Html.Partial("_PaginationControls", (ATLAS_ERP.Infrastructure.IPagedResult)paged)
    </div>

</main>

<!-- MODAL EDITAR -->
<div class="modal-overlay" id="modalEditar">
    <div class="modal">
        <button class="modal-close" id="editarClose">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <div class="modal-title">Editar Cliente</div>
        <div class="modal-sub">Atualize os dados do cadastro</div>
        <div class="modal-divider"></div>
        <form method="POST" action="/Cliente/Edit">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editId" name="ClienteId" value="" />
            <div class="modal-form-group">
                <label class="modal-form-label">Nome</label>
                <input type="text" id="editNome" name="Nome" class="modal-input" placeholder="Nome completo" required />
            </div>
            <div class="modal-row-2">
                <div class="modal-form-group">
                    <label class="modal-form-label">Documento (CPF/CNPJ)</label>
                    <input type="text" id="editDocumento" name="Documento" class="modal-input" placeholder="000.000.000-00" />
                </div>
                <div class="modal-form-group">
                    <label class="modal-form-label">Telefone</label>
                    <input type="text" id="editTelefone" name="Telefone" class="modal-input" placeholder="(00) 00000-0000" />
                </div>
            </div>
            <div class="modal-form-group">
                <label class="modal-form-label">E-mail</label>
                <input type="email" id="editEmail" name="Email" class="modal-input" placeholder="cliente@email.com" />
            </div>
            <div class="modal-form-group">
                <label class="modal-form-label">Endereço</label>
                <input type="text" id="editEndereco" name="Endereco" class="modal-input" placeholder="Rua, número, bairro, cidade" />
            </div>
            <div class="modal-row-2">
                <div class="modal-form-group">
                    <label class="modal-form-label">Limite de Crédito</label>
                    <input type="number" id="editLimite" name="LimiteCredito" class="modal-input" placeholder="0.00" step="0.01" min="0" />
                </div>
                <div class="modal-form-group">
                    <label class="modal-form-label">Status</label>
                    <select id="editAtivo" name="Ativo" class="modal-input">
                        <option value="true">Ativo</option>
                        <option value="false">Inativo</option>
                    </select>
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" class="modal-btn-cancel" id="editarCancel">Cancelar</button>
                <button type="submit" class="modal-btn-submit">Salvar alterações</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL EXCLUIR -->
<div class="modal-overlay" id="modalExcluir">
    <div class="modal" style="max-width:380px;text-align:center;">
        <button class="modal-close" id="excluirClose">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <div class="modal-danger-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M9 6V4h6v2"/></svg>
        </div>
        <div class="modal-title">Excluir cliente?</div>
        <div class="modal-sub" id="excluirNome" style="margin-top:4px;"></div>
        <p style="font-size:13px;color:var(--faint);margin:10px 0 22px;">Esta ação não pode ser desfeita.</p>
        <form method="POST" action="/Cliente/Delete">
            @Html.AntiForgeryToken()
            <input type="hidden" id="excluirId" name="clienteId" value="" />
            <div class="modal-actions">
                <button type="button" class="modal-btn-cancel" id="excluirCancel">Cancelar</button>
                <button type="submit" class="modal-btn-delete">Sim, excluir</button>
            </div>
        </form>
    </div>
</div>

@section scripts {
<script nonce="@Html.CspNonce()">
    function toggleRow(rowId, expId) {
        var row = document.getElementById(rowId);
        var exp = document.getElementById(expId);
        var isOpen = exp.classList.contains('open');
        document.querySelectorAll('.tr-expand.open').forEach(function(el) { el.classList.remove('open'); });
        document.querySelectorAll('.tr-main.expanded').forEach(function(el) { el.classList.remove('expanded'); });
        if (!isOpen) { exp.classList.add('open'); row.classList.add('expanded'); }
    }

    function abrirEditar(id, nome, doc, email, tel, end, limite, ativo) {
        document.getElementById('editId').value        = id;
        document.getElementById('editNome').value      = nome;
        document.getElementById('editDocumento').value = doc;
        document.getElementById('editEmail').value     = email;
        document.getElementById('editTelefone').value  = tel;
        document.getElementById('editEndereco').value  = end;
        document.getElementById('editLimite').value    = limite;
        document.getElementById('editAtivo').value     = ativo;
        fechar('modalExcluir');
        abrir('modalEditar');
    }

    function abrirExcluir(id, nome) {
        document.getElementById('excluirId').value    = id;
        document.getElementById('excluirNome').textContent = nome;
        fechar('modalEditar');
        abrir('modalExcluir');
    }

    function abrir(id) { document.getElementById(id).classList.add('open'); }
    function fechar(id) { document.getElementById(id).classList.remove('open'); }
    function fecharFora(e, id) { if (e.target === document.getElementById(id)) fechar(id); }

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') ['modalEditar','modalExcluir'].forEach(fechar);
    });

    document.getElementById('modalEditar').addEventListener('click', function(e) { fecharFora(e, 'modalEditar'); });
    document.getElementById('modalExcluir').addEventListener('click', function(e) { fecharFora(e, 'modalExcluir'); });
    document.getElementById('editarClose').addEventListener('click', function() { fechar('modalEditar'); });
    document.getElementById('editarCancel').addEventListener('click', function() { fechar('modalEditar'); });
    document.getElementById('excluirClose').addEventListener('click', function() { fechar('modalExcluir'); });
    document.getElementById('excluirCancel').addEventListener('click', function() { fechar('modalExcluir'); });

    document.getElementById('searchInput').addEventListener('input', filtrarTabela);

    var tbl = document.getElementById('tabelaClientes');
    if (tbl) tbl.addEventListener('click', function(e) {
        if (e.target.closest('.js-cli-edit, .js-cli-del')) return;
        var row = e.target.closest('.tr-main');
        if (!row) return;
        toggleRow(row.id, row.id.replace('row-', 'exp-'));
    });

    document.addEventListener('click', function(e) {
        var btnEdit = e.target.closest('.js-cli-edit');
        if (btnEdit) { e.stopPropagation(); abrirEditar(btnEdit.dataset.id, btnEdit.dataset.nome||'', btnEdit.dataset.doc||'', btnEdit.dataset.email||'', btnEdit.dataset.tel||'', btnEdit.dataset.end||'', btnEdit.dataset.limite||'0', btnEdit.dataset.ativo||'false'); return; }
        var btnDel = e.target.closest('.js-cli-del');
        if (btnDel) { e.stopPropagation(); abrirExcluir(btnDel.dataset.id, btnDel.dataset.nome||''); }
    });

    function filtrarTabela() {
        var input = document.getElementById('searchInput').value.toLowerCase();
        document.querySelectorAll('.tr-main').forEach(function(row) {
            var text  = row.textContent.toLowerCase();
            var expId = row.id.replace('row-','exp-');
            var exp   = document.getElementById(expId);
            var show  = text.indexOf(input) > -1;
            row.style.display = show ? '' : 'none';
            if (exp) exp.style.display = show ? '' : 'none';
        });
    }
</script>
}
