@model ATLAS_ERP.Models.Produto
@{
    ViewBag.Title = "Novo Produto - Atlas ERP";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Atlas ERP – Novo Produto</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg: #050d1a;
            --panel: #0b1525;
            --card: #0f1e35;
            --card-hover: #132540;
            --border: rgba(100,160,255,0.10);
            --border-md: rgba(100,160,255,0.18);
            --accent: #3b82f6;
            --accent-soft: rgba(59,130,246,0.12);
            --accent-glow: rgba(59,130,246,0.20);
            --accent-light: #60a5fa;
            --gold: #c9a84c;
            --gold-soft: rgba(201,168,76,0.12);
            --green: #34d399;
            --green-soft: rgba(52,211,153,0.12);
            --red: #f87171;
            --red-soft: rgba(248,113,113,0.10);
            --orange: #fb923c;
            --orange-soft: rgba(251,146,60,0.12);
            --purple: #a78bfa;
            --purple-soft: rgba(167,139,250,0.12);
            --teal: #2dd4bf;
            --teal-soft: rgba(45,212,191,0.12);
            --pink: #f472b6;
            --pink-soft: rgba(244,114,182,0.12);
            --text: #e8f0fe;
            --muted: #7a9cc8;
            --faint: #3d5270;
            --sidebar-w: 320px;
            --radius: 14px;
        }

        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100%; }
        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg); color: var(--text);
            display: flex; min-height: 100vh;
        }

        /* BG */
        .bg-layer { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
        .bg-dots {
            position: absolute; inset: 0;
            background-image: radial-gradient(circle, rgba(59,130,246,0.10) 1px, transparent 1px);
            background-size: 36px 36px;
            mask-image: radial-gradient(ellipse 80% 70% at 60% 30%, black, transparent);
        }
        .bg-glow { position: absolute; border-radius: 50%; filter: blur(100px); }

        /* SIDEBAR */
        .sidebar {
            width: var(--sidebar-w); height: 100vh;
            background: var(--panel); border-right: 1px solid var(--border);
            position: fixed; top: 0; left: 0;
            display: flex; flex-direction: column;
            padding: 28px 16px; z-index: 100;
        }
        .sidebar-logo { display: flex; align-items: center; justify-content: center; margin-bottom: 36px; }
        .sidebar-logo a { display: flex; align-items: center; justify-content: center; width: 100%; }
        .sidebar-logo img { width: 300px; max-width: 100%; }
        .sidebar-divider { height: 1px; background: var(--border); margin: 8px 0 16px; }
        .menu-label {
            font-size: 10px; font-weight: 500; color: var(--faint);
            text-transform: uppercase; letter-spacing: .10em;
            padding: 0 12px; margin-bottom: 6px;
        }
        .menu-item {
            display: flex; align-items: center; gap: 10px;
            color: var(--muted); text-decoration: none; font-size: 14px;
            padding: 10px 12px; border-radius: 10px; margin-bottom: 2px;
            transition: background .18s, color .18s; position: relative;
        }
        .menu-item svg { width: 16px; height: 16px; flex-shrink: 0; opacity: .7; }
        .menu-item:hover { background: var(--card); color: var(--text); }
        .menu-item:hover svg { opacity: 1; }
        .menu-item.active { background: var(--accent-soft); color: var(--accent-light); font-weight: 500; }
        .menu-item.active svg { opacity: 1; }
        .menu-item.active::before {
            content: ''; position: absolute; left: 0; top: 20%; bottom: 20%;
            width: 3px; background: var(--accent); border-radius: 0 3px 3px 0;
        }
        .menu-item.danger { color: var(--red); }
        .menu-item.danger:hover { background: var(--red-soft); }
        .sidebar-spacer { flex: 1; }
        .sidebar-user {
            display: flex; align-items: center; gap: 10px;
            padding: 12px; border-radius: 10px;
            border: 1px solid var(--border); background: var(--card);
        }
        .user-avatar {
            width: 34px; height: 34px; border-radius: 50%;
            background: var(--accent-soft); border: 1px solid var(--border-md);
            display: flex; align-items: center; justify-content: center;
            font-family: 'Syne', sans-serif; font-size: 13px; font-weight: 700;
            color: var(--accent-light); flex-shrink: 0;
        }
        .user-name { font-size: 13px; font-weight: 500; color: var(--text); }
        .user-role { font-size: 11px; color: var(--faint); }

        /* MAIN */
        .main {
            margin-left: var(--sidebar-w); flex: 1;
            display: flex; flex-direction: column;
            min-height: 100vh; position: relative; z-index: 1;
        }

        /* PAGE HEADER */
        .page-header {
            position: sticky; top: 0; z-index: 50;
            background: rgba(5,13,26,0.92); backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--border);
            padding: 16px 36px;
            display: flex; align-items: center; justify-content: space-between;
        }
        .breadcrumb {
            display: flex; align-items: center; gap: 6px;
            font-size: 12px; color: var(--faint);
        }
        .breadcrumb a { color: var(--faint); text-decoration: none; transition: color .15s; }
        .breadcrumb a:hover { color: var(--muted); }
        .breadcrumb-sep { opacity: .5; }
        .breadcrumb-current { color: var(--muted); }
        .page-title {
            font-family: 'Syne', sans-serif;
            font-size: 20px; font-weight: 700; margin-top: 3px;
        }
        .btn-back {
            display: inline-flex; align-items: center; gap: 7px;
            color: var(--muted); text-decoration: none; font-size: 13px;
            background: var(--card); border: 1px solid var(--border);
            padding: 9px 16px; border-radius: 10px;
            transition: background .18s, color .18s;
        }
        .btn-back:hover { background: var(--card-hover); color: var(--text); }
        .btn-back svg { width: 14px; height: 14px; }

        /* CONTENT */
        .content-wrap {
            flex: 1; padding: 32px 36px;
            display: flex; gap: 28px; align-items: flex-start;
        }
        .form-area { flex: 1; min-width: 0; }

        /* SECTIONS */
        .section-card {
            background: var(--card); border: 1px solid var(--border);
            border-radius: var(--radius); padding: 28px 32px;
            margin-bottom: 20px; animation: fadeUp .45s ease both;
        }
        .section-card:nth-child(2) { animation-delay: .07s; }
        .section-card:nth-child(3) { animation-delay: .14s; }
        .section-head {
            display: flex; align-items: flex-start; gap: 14px;
            margin-bottom: 24px;
        }
        .section-num {
            width: 28px; height: 28px; border-radius: 8px;
            background: var(--accent-soft); border: 1px solid rgba(59,130,246,0.25);
            display: flex; align-items: center; justify-content: center;
            font-family: 'Syne', sans-serif; font-size: 12px; font-weight: 700;
            color: var(--accent-light); flex-shrink: 0; margin-top: 2px;
        }
        .section-title {
            font-family: 'Syne', sans-serif;
            font-size: 14px; font-weight: 700; color: var(--text);
        }
        .section-desc { font-size: 12px; color: var(--faint); margin-top: 2px; }

        /* FORM */
        .form-group { margin-bottom: 22px; }
        .form-group:last-child { margin-bottom: 0; }
        .form-label {
            display: block; font-size: 11px; font-weight: 500;
            color: var(--muted); margin-bottom: 8px;
            text-transform: uppercase; letter-spacing: .06em;
        }
        .form-label span { color: var(--red); margin-left: 2px; }

        .input-wrapper { position: relative; }
        .input-icon {
            position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
            color: var(--faint); pointer-events: none; display: flex;
        }
        .input-icon svg { width: 15px; height: 15px; }
        .input-suffix {
            position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
            font-size: 12px; color: var(--faint); pointer-events: none;
        }

        .form-control {
            width: 100%; height: 46px;
            background: var(--panel); border: 1px solid var(--border);
            border-radius: 10px; padding: 0 14px 0 42px;
            font-family: 'DM Sans', sans-serif; font-size: 14px; color: var(--text);
            outline: none; transition: border-color .2s, box-shadow .2s;
            -webkit-appearance: none;
        }
        .form-control::placeholder { color: var(--faint); }
        .form-control:hover { border-color: var(--border-md); }
        .form-control:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); }
        .form-control.no-icon { padding-left: 14px; }
        .form-control.has-suffix { padding-right: 52px; }

        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }

        .field-error { font-size: 12px; color: var(--red); margin-top: 5px; }
        .field-hint { font-size: 11px; color: var(--faint); margin-top: 5px; }

        .validation-summary {
            background: var(--red-soft); border: 1px solid rgba(248,113,113,0.2);
            border-radius: 10px; padding: 12px 16px; margin-bottom: 20px;
            font-size: 13px; color: var(--red);
        }

        /* CATEGORY CHIPS */
        .cat-grid {
            display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px;
            margin-bottom: 12px;
        }
        .cat-chip {
            display: flex; flex-direction: column; align-items: center; gap: 5px;
            padding: 12px 8px; border-radius: 10px;
            border: 1px solid var(--border);
            background: var(--panel); cursor: pointer;
            transition: all .18s; font-size: 11px; color: var(--muted);
            font-weight: 500; letter-spacing: .03em; text-align: center;
            user-select: none;
        }
        .cat-chip .cat-icon { font-size: 22px; line-height: 1; }
        .cat-chip:hover { border-color: var(--border-md); color: var(--text); background: var(--card-hover); }
        .cat-chip.selected { font-weight: 600; }

        .cat-chip[data-cat="Eletrônicos"].selected      { border-color: rgba(59,130,246,.4); background: var(--accent-soft); color: var(--accent-light); }
        .cat-chip[data-cat="Alimentos"].selected        { border-color: rgba(52,211,153,.4); background: var(--green-soft); color: var(--green); }
        .cat-chip[data-cat="Roupas"].selected           { border-color: rgba(244,114,182,.4); background: var(--pink-soft); color: var(--pink); }
        .cat-chip[data-cat="Ferramentas"].selected      { border-color: rgba(251,146,60,.4); background: var(--orange-soft); color: var(--orange); }
        .cat-chip[data-cat="Serviços"].selected         { border-color: rgba(167,139,250,.4); background: var(--purple-soft); color: var(--purple); }
        .cat-chip[data-cat="Bebidas"].selected          { border-color: rgba(45,212,191,.4); background: var(--teal-soft); color: var(--teal); }
        .cat-chip[data-cat="Limpeza"].selected          { border-color: rgba(59,130,246,.4); background: var(--accent-soft); color: var(--accent-light); }
        .cat-chip[data-cat="Outros"].selected           { border-color: rgba(201,168,76,.4); background: var(--gold-soft); color: var(--gold); }

        .cat-custom-wrap { margin-top: 6px; }
        .cat-custom-label { font-size: 11px; color: var(--faint); margin-bottom: 6px; }

        /* PRICE INPUT */
        .price-wrapper { position: relative; }
        .price-prefix {
            position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
            font-family: 'Syne', sans-serif; font-size: 13px; font-weight: 700;
            color: var(--green); pointer-events: none;
        }
        .price-input {
            padding-left: 42px !important;
            font-family: 'Syne', sans-serif !important;
            font-size: 22px !important; font-weight: 700 !important;
            color: var(--green) !important; height: 58px !important;
            letter-spacing: -.01em;
        }

        /* STOCK ROW */
        .stock-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

        /* TOGGLE */
        .toggle-row {
            display: flex; align-items: center; justify-content: space-between;
            padding: 16px 18px; border-radius: 10px;
            background: var(--panel); border: 1px solid var(--border);
            cursor: pointer; user-select: none;
            transition: border-color .2s;
        }
        .toggle-row:hover { border-color: var(--border-md); }
        .toggle-row.on { border-color: rgba(52,211,153,.3); background: rgba(52,211,153,.04); }

        .toggle-info {}
        .toggle-title { font-size: 14px; font-weight: 500; color: var(--text); }
        .toggle-sub { font-size: 12px; color: var(--faint); margin-top: 2px; }

        .toggle-switch {
            position: relative; width: 44px; height: 24px; flex-shrink: 0;
        }
        .toggle-switch input { opacity: 0; width: 0; height: 0; }
        .toggle-track {
            position: absolute; inset: 0; border-radius: 12px;
            background: var(--faint); transition: background .2s;
            cursor: pointer;
        }
        .toggle-switch input:checked + .toggle-track { background: var(--green); }
        .toggle-thumb {
            position: absolute; top: 3px; left: 3px;
            width: 18px; height: 18px; border-radius: 50%;
            background: white; transition: transform .2s;
            pointer-events: none;
        }
        .toggle-switch input:checked ~ .toggle-thumb { transform: translateX(20px); }

        /* HIDDEN INPUTS for model binding */
        .hidden-cat-input { display: none; }

        /* ─── PREVIEW ──────────────────────────────────── */
        .preview-aside { width: 310px; flex-shrink: 0; position: sticky; top: 84px; }

        .preview-card {
            background: var(--card); border: 1px solid var(--border);
            border-radius: var(--radius); overflow: hidden;
            animation: fadeUp .5s ease .12s both;
        }

        /* Product image area */
        .preview-img-area {
            height: 160px; position: relative; overflow: hidden;
            display: flex; align-items: center; justify-content: center;
            transition: background .4s;
        }
        .preview-img-bg {
            position: absolute; inset: 0;
            transition: opacity .4s;
        }
        .preview-cat-icon-big {
            font-size: 64px; line-height: 1; position: relative; z-index: 1;
            filter: drop-shadow(0 4px 16px rgba(0,0,0,.3));
            transition: all .3s;
        }
        .preview-status-pill {
            position: absolute; top: 12px; right: 12px; z-index: 2;
            padding: 4px 11px; border-radius: 20px; font-size: 11px; font-weight: 600;
            letter-spacing: .04em; text-transform: uppercase;
            transition: all .2s;
        }
        .pill-ativo   { background: var(--green-soft); color: var(--green); border: 1px solid rgba(52,211,153,.3); }
        .pill-inativo { background: var(--red-soft);   color: var(--red);   border: 1px solid rgba(248,113,113,.2); }

        .preview-cat-badge {
            position: absolute; bottom: 12px; left: 12px; z-index: 2;
            padding: 3px 10px; border-radius: 20px; font-size: 10px; font-weight: 600;
            letter-spacing: .05em; text-transform: uppercase;
            transition: all .2s;
        }

        .preview-body { padding: 20px 22px; }

        .preview-prod-name {
            font-family: 'Syne', sans-serif; font-size: 18px; font-weight: 700;
            color: var(--text); margin-bottom: 16px; min-height: 26px;
            line-height: 1.2;
        }
        .preview-prod-name.empty { color: var(--faint); font-weight: 400; font-style: italic; font-size: 14px; }

        .preview-price-row {
            display: flex; align-items: baseline; gap: 6px;
            margin-bottom: 18px;
        }
        .preview-price-label { font-size: 11px; color: var(--faint); text-transform: uppercase; letter-spacing: .05em; }
        .preview-price-val {
            font-family: 'Syne', sans-serif; font-size: 28px; font-weight: 800;
            color: var(--green); letter-spacing: -.02em;
            transition: all .2s;
        }
        .preview-price-val.empty { font-size: 16px; color: var(--faint); font-weight: 400; }

        .preview-divider { height: 1px; background: var(--border); margin: 0 0 16px; }

        .preview-stock-section {}
        .preview-stock-header {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 8px;
        }
        .preview-stock-label { font-size: 11px; color: var(--faint); text-transform: uppercase; letter-spacing: .05em; }
        .preview-stock-nums { font-size: 12px; font-weight: 500; }

        .stock-bar-track {
            height: 6px; border-radius: 3px; background: rgba(255,255,255,.06);
            overflow: hidden; margin-bottom: 6px;
        }
        .stock-bar-fill {
            height: 100%; border-radius: 3px;
            transition: width .4s cubic-bezier(.4,0,.2,1), background .3s;
        }
        .stock-bar-minmark {
            display: flex; align-items: center; gap: 4px;
            font-size: 10px; color: var(--faint);
        }
        .stock-bar-minmark::before {
            content: ''; width: 8px; height: 2px;
            background: var(--red); border-radius: 1px; flex-shrink: 0;
        }

        .preview-tip {
            background: rgba(59,130,246,.06); border: 1px solid rgba(59,130,246,.12);
            border-radius: 10px; padding: 14px 16px; margin-top: 14px;
            font-size: 12px; color: var(--faint); line-height: 1.5;
        }
        .preview-tip strong { color: var(--muted); }

        /* ACTION BAR */
        .action-bar {
            position: sticky; bottom: 0; z-index: 50;
            background: rgba(5,13,26,.95); backdrop-filter: blur(12px);
            border-top: 1px solid var(--border);
            padding: 14px 36px;
            display: flex; align-items: center; justify-content: space-between;
        }
        .action-hint { font-size: 12px; color: var(--faint); }
        .action-hint span { color: var(--red); }
        .action-btns { display: flex; gap: 12px; }
        .btn-cancel {
            height: 44px; padding: 0 22px;
            background: none; border: 1px solid var(--border); border-radius: 10px;
            color: var(--muted); font-family: 'DM Sans', sans-serif; font-size: 14px;
            cursor: pointer; text-decoration: none;
            display: inline-flex; align-items: center;
            transition: background .18s, color .18s;
        }
        .btn-cancel:hover { background: var(--card-hover); color: var(--text); }
        .btn-submit {
            height: 44px; padding: 0 28px;
            background: var(--accent); border: none; border-radius: 10px;
            font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 600;
            color: white; cursor: pointer; letter-spacing: .02em;
            transition: background .2s, transform .15s;
            box-shadow: 0 4px 16px rgba(59,130,246,.25);
            display: inline-flex; align-items: center; gap: 8px;
        }
        .btn-submit:hover { background: #2563eb; transform: translateY(-1px); }
        .btn-submit:active { transform: translateY(0); }
        .btn-submit svg { width: 15px; height: 15px; }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(18px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 1100px) { .preview-aside { display: none; } }
        @@media (max-width: 700px) {
            .sidebar { display: none; }
            .main { margin-left: 0; }
            .content-wrap { padding: 20px 16px; }
            .page-header, .action-bar { padding: 14px 16px; }
            .cat-grid { grid-template-columns: repeat(4, 1fr); }
            .form-row, .form-row-3, .stock-row { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

<div class="bg-layer">
    <div class="bg-dots"></div>
    <div class="bg-glow" style="width:500px;height:500px;top:-150px;right:3%;background:rgba(20,50,110,0.20);"></div>
    <div class="bg-glow" style="width:300px;height:300px;bottom:15%;left:25%;background:rgba(30,100,60,0.08);"></div>
</div>

<!-- SIDEBAR -->
<aside class="sidebar">
    <div class="sidebar-logo">
        <a href="/Admin/Dashboard">
            <img src="~/Content/images/logos/atlas_erp_diamante.svg" alt="Atlas ERP" />
        </a>
    </div>

    <span class="menu-label">Principal</span>

    <a href="/Admin/Dashboard" class="menu-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
            <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
        </svg>
        Dashboard
    </a>
    <a href="/Venda" class="menu-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        Vendas
    </a>
    <a href="/Produto" class="menu-item active">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
        </svg>
        Produtos
    </a>
    <a href="/Cliente" class="menu-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        Clientes
    </a>
    <a href="/Fornecedor" class="menu-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
        </svg>
        Fornecedores
    </a>
    <a href="/Usuario" class="menu-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
            <line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/>
        </svg>
        Funcion&aacute;rios
    </a>

    <div class="sidebar-divider"></div>
    <span class="menu-label">Sistema</span>
    <a href="/Auth/Logout" class="menu-item danger">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
        Sair
    </a>
    <div class="sidebar-spacer"></div>
    <div class="sidebar-user">
        @{
            var nomeUsuario = Session["UsuarioLogado"]?.ToString() ?? "Usuário";
            var inicial = nomeUsuario.Length > 0 ? nomeUsuario[0].ToString().ToUpper() : "U";
        }
        <div class="user-avatar">@inicial</div>
        <div>
            <div class="user-name">@nomeUsuario</div>
            <div class="user-role">Administrador</div>
        </div>
    </div>
</aside>

<!-- MAIN -->
<main class="main">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div>
            <div class="breadcrumb">
                <a href="/Admin/Dashboard">Dashboard</a>
                <span class="breadcrumb-sep">›</span>
                <a href="/Produto">Produtos</a>
                <span class="breadcrumb-sep">›</span>
                <span class="breadcrumb-current">Novo</span>
            </div>
            <div class="page-title">Novo Produto</div>
        </div>
        <a href="/Produto" class="btn-back">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
            Voltar
        </a>
    </div>

    @using (Html.BeginForm("Create", "Produto", FormMethod.Post, new { id = "formProduto" }))
    {
        @Html.AntiForgeryToken()

        <div class="content-wrap">

            <!-- FORM AREA -->
            <div class="form-area">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="validation-summary">@Html.ValidationSummary(false)</div>
                }

                <!-- SECTION 1: Identidade -->
                <div class="section-card">
                    <div class="section-head">
                        <div class="section-num">1</div>
                        <div>
                            <div class="section-title">Identidade do Produto</div>
                            <div class="section-desc">Nome e categoria para identificar o produto no sistema</div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Nome do produto <span>*</span></label>
                        <div class="input-wrapper">
                            @Html.TextBoxFor(m => m.Nome, new {
                                @class = "form-control",
                                id = "nomeInput",
                                placeholder = "Ex: Notebook Dell Inspiron 15",
                                autocomplete = "off",
                                maxlength = "150"
                            })
                            <span class="input-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                                </svg>
                            </span>
                        </div>
                        @Html.ValidationMessageFor(m => m.Nome, "", new { @class = "field-error" })
                    </div>

                    <div class="form-group">
                        <label class="form-label">Categoria</label>
                        <div class="cat-grid" id="catGrid">
                            <div class="cat-chip" data-cat="Eletrônicos" onclick="selectCat(this)">
                                <span class="cat-icon">💻</span>Eletr&ocirc;nicos
                            </div>
                            <div class="cat-chip" data-cat="Alimentos" onclick="selectCat(this)">
                                <span class="cat-icon">🍎</span>Alimentos
                            </div>
                            <div class="cat-chip" data-cat="Roupas" onclick="selectCat(this)">
                                <span class="cat-icon">👕</span>Roupas
                            </div>
                            <div class="cat-chip" data-cat="Ferramentas" onclick="selectCat(this)">
                                <span class="cat-icon">🔧</span>Ferramentas
                            </div>
                            <div class="cat-chip" data-cat="Serviços" onclick="selectCat(this)">
                                <span class="cat-icon">⚙️</span>Servi&ccedil;os
                            </div>
                            <div class="cat-chip" data-cat="Bebidas" onclick="selectCat(this)">
                                <span class="cat-icon">🥤</span>Bebidas
                            </div>
                            <div class="cat-chip" data-cat="Limpeza" onclick="selectCat(this)">
                                <span class="cat-icon">🧹</span>Limpeza
                            </div>
                            <div class="cat-chip" data-cat="Outros" onclick="selectCat(this)">
                                <span class="cat-icon">📦</span>Outros
                            </div>
                        </div>
                        <div class="cat-custom-wrap">
                            <div class="cat-custom-label">Ou digite uma categoria personalizada:</div>
                            <div class="input-wrapper">
                                <input type="text" id="catCustom" class="form-control no-icon"
                                       placeholder="Ex: Papelaria, Móveis, Higiene..."
                                       oninput="onCatCustomInput(this)"
                                       autocomplete="off" />
                            </div>
                        </div>
                        @Html.HiddenFor(m => m.Categoria, new { id = "categoriaHidden" })
                        @Html.ValidationMessageFor(m => m.Categoria, "", new { @class = "field-error" })
                    </div>
                </div>

                <!-- SECTION 2: Precificação -->
                <div class="section-card">
                    <div class="section-head">
                        <div class="section-num">2</div>
                        <div>
                            <div class="section-title">Precifica&ccedil;&atilde;o</div>
                            <div class="section-desc">Valor de venda praticado para este produto</div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Pre&ccedil;o de venda <span>*</span></label>
                        <div class="price-wrapper">
                            <span class="price-prefix">R$</span>
                            @Html.TextBoxFor(m => m.PrecoVenda, new {
                                @class = "form-control price-input",
                                id = "precoInput",
                                placeholder = "0,00",
                                autocomplete = "off",
                                inputmode = "decimal"
                            })
                        </div>
                        <div class="field-hint">Use v&iacute;rgula para decimais. Ex: 149,90</div>
                        @Html.ValidationMessageFor(m => m.PrecoVenda, "", new { @class = "field-error" })
                    </div>
                </div>

                <!-- SECTION 3: Estoque -->
                <div class="section-card">
                    <div class="section-head">
                        <div class="section-num">3</div>
                        <div>
                            <div class="section-title">Estoque &amp; Status</div>
                            <div class="section-desc">Controle de quantidade e disponibilidade</div>
                        </div>
                    </div>

                    <div class="stock-row">
                        <div class="form-group">
                            <label class="form-label">Estoque atual</label>
                            <div class="input-wrapper">
                                @Html.TextBoxFor(m => m.EstoqueAtual, new {
                                    @class = "form-control",
                                    id = "estoqueAtualInput",
                                    placeholder = "0",
                                    type = "number",
                                    min = "0"
                                })
                                <span class="input-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                                        <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                                    </svg>
                                </span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Estoque m&iacute;nimo</label>
                            <div class="input-wrapper">
                                @Html.TextBoxFor(m => m.EstoqueMinimo, new {
                                    @class = "form-control",
                                    id = "estoqueMinimoInput",
                                    placeholder = "0",
                                    type = "number",
                                    min = "0"
                                })
                                <span class="input-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-6"/>
                                    </svg>
                                </span>
                            </div>
                            <div class="field-hint">Alerta quando estoque for abaixo deste valor</div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="toggle-row" id="toggleRow" for="ativoCheck">
                            <div class="toggle-info">
                                <div class="toggle-title">Produto ativo</div>
                                <div class="toggle-sub" id="toggleSub">Este produto estar&aacute; dispon&iacute;vel para vendas</div>
                            </div>
                            <label class="toggle-switch">
                                @Html.CheckBoxFor(m => m.Ativo, new { id = "ativoCheck", onchange = "onAtivoChange(this)" })
                                <span class="toggle-track"></span>
                                <span class="toggle-thumb"></span>
                            </label>
                        </label>
                    </div>
                </div>

            </div>

            <!-- PREVIEW -->
            <aside class="preview-aside">
                <div class="preview-card">
                    <div class="preview-img-area" id="prevImgArea">
                        <div class="preview-img-bg" id="prevImgBg"></div>
                        <div class="preview-cat-icon-big" id="prevCatIcon">📦</div>
                        <div class="preview-status-pill pill-inativo" id="prevStatusPill">Inativo</div>
                        <div class="preview-cat-badge" id="prevCatBadge" style="display:none"></div>
                    </div>
                    <div class="preview-body">
                        <div class="preview-prod-name empty" id="prevNome">Nome do produto</div>
                        <div class="preview-price-row">
                            <div class="preview-price-label">Pre&ccedil;o</div>
                            <div class="preview-price-val empty" id="prevPreco">—</div>
                        </div>
                        <div class="preview-divider"></div>
                        <div class="preview-stock-section">
                            <div class="preview-stock-header">
                                <div class="preview-stock-label">Estoque</div>
                                <div class="preview-stock-nums" id="prevStockNums" style="color:var(--faint)">0 un</div>
                            </div>
                            <div class="stock-bar-track">
                                <div class="stock-bar-fill" id="stockBarFill" style="width:0%;background:var(--faint)"></div>
                            </div>
                            <div class="stock-bar-minmark" id="stockBarMin">M&iacute;nimo: 0 un</div>
                        </div>
                    </div>
                </div>

                <div class="preview-tip">
                    <strong>Dica:</strong> Defina o estoque m&iacute;nimo para receber alertas quando o produto estiver prestes a esgotar.
                </div>
            </aside>

        </div>

        <!-- ACTION BAR -->
        <div class="action-bar">
            <div class="action-hint"><span>*</span> Campos obrigat&oacute;rios</div>
            <div class="action-btns">
                <a href="/Produto" class="btn-cancel">Cancelar</a>
                <button type="submit" class="btn-submit">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                    </svg>
                    Cadastrar Produto
                </button>
            </div>
        </div>
    }

</main>

<script>
/* ── Category config ────────────────────────── */
var catConfig = {
    'Eletr\u00f4nicos': { icon: '💻', bg: 'rgba(59,130,246,0.18)',  badge: 'rgba(59,130,246,0.22)',  color: '#60a5fa' },
    'Alimentos':        { icon: '🍎', bg: 'rgba(52,211,153,0.14)',  badge: 'rgba(52,211,153,0.22)',  color: '#34d399' },
    'Roupas':           { icon: '👕', bg: 'rgba(244,114,182,0.14)', badge: 'rgba(244,114,182,0.22)', color: '#f472b6' },
    'Ferramentas':      { icon: '🔧', bg: 'rgba(251,146,60,0.14)',  badge: 'rgba(251,146,60,0.22)',  color: '#fb923c' },
    'Servi\u00e7os':   { icon: '⚙️', bg: 'rgba(167,139,250,0.14)', badge: 'rgba(167,139,250,0.22)', color: '#a78bfa' },
    'Bebidas':          { icon: '🥤', bg: 'rgba(45,212,191,0.14)',  badge: 'rgba(45,212,191,0.22)',  color: '#2dd4bf' },
    'Limpeza':          { icon: '🧹', bg: 'rgba(59,130,246,0.14)',  badge: 'rgba(59,130,246,0.20)',  color: '#60a5fa' },
    'Outros':           { icon: '📦', bg: 'rgba(201,168,76,0.14)',  badge: 'rgba(201,168,76,0.22)',  color: '#c9a84c' }
};
var defaultCat = { icon: '📦', bg: 'rgba(61,82,112,0.20)', badge: 'rgba(61,82,112,0.30)', color: '#7a9cc8' };

/* ── Elements ───────────────────────────────── */
var nomeInput        = document.getElementById('nomeInput');
var precoInput       = document.getElementById('precoInput');
var estoqueAtual     = document.getElementById('estoqueAtualInput');
var estoqueMinimo    = document.getElementById('estoqueMinimoInput');
var ativoCheck       = document.getElementById('ativoCheck');
var categoriaHidden  = document.getElementById('categoriaHidden');
var catCustom        = document.getElementById('catCustom');

var prevImgArea   = document.getElementById('prevImgArea');
var prevImgBg     = document.getElementById('prevImgBg');
var prevCatIcon   = document.getElementById('prevCatIcon');
var prevCatBadge  = document.getElementById('prevCatBadge');
var prevStatusPill = document.getElementById('prevStatusPill');
var prevNome      = document.getElementById('prevNome');
var prevPreco     = document.getElementById('prevPreco');
var prevStockNums = document.getElementById('prevStockNums');
var stockBarFill  = document.getElementById('stockBarFill');
var stockBarMin   = document.getElementById('stockBarMin');
var toggleRow     = document.getElementById('toggleRow');
var toggleSub     = document.getElementById('toggleSub');

var currentCat = '';

/* ── Category selection ─────────────────────── */
function selectCat(chip) {
    document.querySelectorAll('.cat-chip').forEach(function(c){ c.classList.remove('selected'); });
    chip.classList.add('selected');
    currentCat = chip.getAttribute('data-cat');
    categoriaHidden.value = currentCat;
    catCustom.value = '';
    updatePreview();
}

function onCatCustomInput(input) {
    document.querySelectorAll('.cat-chip').forEach(function(c){ c.classList.remove('selected'); });
    currentCat = input.value.trim();
    categoriaHidden.value = currentCat;
    updatePreview();
}

/* ── Price mask (R$ format) ─────────────────── */
precoInput.addEventListener('input', function() {
    var raw = this.value.replace(/[^0-9,\.]/g, '');
    categoriaHidden; // just reference to avoid lint
    updatePreview();
});

function parsePreco() {
    var v = precoInput.value.trim().replace(/\./g, '').replace(',', '.');
    var n = parseFloat(v);
    return isNaN(n) ? 0 : n;
}

function formatBRL(n) {
    return n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

/* ── Ativo toggle ───────────────────────────── */
function onAtivoChange(cb) {
    if (cb.checked) {
        toggleRow.classList.add('on');
        toggleSub.textContent = 'Este produto estar\u00e1 dispon\u00edvel para vendas';
    } else {
        toggleRow.classList.remove('on');
        toggleSub.textContent = 'Produto inativo n\u00e3o aparecer\u00e1 nas vendas';
    }
    updatePreview();
}

/* ── Main preview update ────────────────────── */
function updatePreview() {
    var cfg = catConfig[currentCat] || (currentCat ? defaultCat : defaultCat);

    /* Category icon + bg */
    prevCatIcon.textContent = cfg.icon;
    prevImgBg.style.background = 'linear-gradient(135deg, ' + cfg.bg + ', rgba(5,13,26,0.0))';
    prevImgArea.style.background = 'var(--panel)';

    /* Category badge */
    if (currentCat) {
        prevCatBadge.style.display = '';
        prevCatBadge.textContent = currentCat;
        prevCatBadge.style.background = cfg.badge;
        prevCatBadge.style.color = cfg.color;
        prevCatBadge.style.border = '1px solid ' + cfg.color + '33';
    } else {
        prevCatBadge.style.display = 'none';
    }

    /* Status pill */
    if (ativoCheck.checked) {
        prevStatusPill.className = 'preview-status-pill pill-ativo';
        prevStatusPill.textContent = 'Ativo';
    } else {
        prevStatusPill.className = 'preview-status-pill pill-inativo';
        prevStatusPill.textContent = 'Inativo';
    }

    /* Nome */
    var nome = nomeInput.value.trim();
    if (nome) {
        prevNome.textContent = nome;
        prevNome.classList.remove('empty');
    } else {
        prevNome.textContent = 'Nome do produto';
        prevNome.classList.add('empty');
    }

    /* Preço */
    var preco = parsePreco();
    if (preco > 0) {
        prevPreco.textContent = 'R$ ' + formatBRL(preco);
        prevPreco.classList.remove('empty');
        prevPreco.style.color = 'var(--green)';
    } else {
        prevPreco.textContent = '\u2014';
        prevPreco.classList.add('empty');
        prevPreco.style.color = '';
    }

    /* Stock bar */
    var atual = parseInt(estoqueAtual.value) || 0;
    var minimo = parseInt(estoqueMinimo.value) || 0;
    var max = Math.max(atual, minimo * 2, 10);
    var pct = Math.min(100, Math.round((atual / max) * 100));

    var barColor;
    if (atual === 0) {
        barColor = 'var(--red)';
        prevStockNums.style.color = 'var(--red)';
    } else if (minimo > 0 && atual <= minimo) {
        barColor = 'var(--orange)';
        prevStockNums.style.color = 'var(--orange)';
    } else {
        barColor = 'var(--green)';
        prevStockNums.style.color = 'var(--green)';
    }

    stockBarFill.style.width = pct + '%';
    stockBarFill.style.background = barColor;
    prevStockNums.textContent = atual + ' un';
    stockBarMin.textContent = 'M\u00ednimo: ' + minimo + ' un';
}

/* ── Event bindings ─────────────────────────── */
nomeInput.addEventListener('input', updatePreview);
precoInput.addEventListener('input', updatePreview);
estoqueAtual.addEventListener('input', updatePreview);
estoqueMinimo.addEventListener('input', updatePreview);

/* ── Price formatting on blur ───────────────── */
precoInput.addEventListener('blur', function() {
    var n = parsePreco();
    if (n > 0) this.value = formatBRL(n);
    updatePreview();
});

/* ── Initial render ─────────────────────────── */
updatePreview();
</script>

</body>
</html>
