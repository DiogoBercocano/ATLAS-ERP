@model ATLAS_ERP.Infrastructure.PagedResult<ATLAS_ERP.Models.Produto>
@using ATLAS_ERP.Helpers
@{
    ViewBag.Title = "Produtos - Atlas ERP";
    var paged        = Model ?? ATLAS_ERP.Infrastructure.PagedResult<ATLAS_ERP.Models.Produto>.Empty(20);
    var lista        = paged.Items;
    var totalProd    = paged.TotalItems;
    var totalAtivos  = lista.Count(p => p.Ativo);
    var baixoEstoque = lista.Count(p => p.EstoqueMinimo > 0 && p.EstoqueAtual <= p.EstoqueMinimo);
    var semEstoque   = lista.Count(p => p.EstoqueAtual == 0);
    var valorTotal   = lista.Sum(p => p.PrecoVenda * p.EstoqueAtual);
    var role         = Session["CargoNome"]?.ToString() ?? "";
    bool podeEditar  = role == "Admin" || role == "Gerente";
}

@section bgGlows {
    <div class="bg-glow" style="width:500px;height:500px;top:-180px;right:2%;background:rgba(20,50,110,0.18);"></div>
    <div class="bg-glow" style="width:350px;height:350px;bottom:5%;left:20%;background:rgba(20,80,40,0.08);"></div>
}

@section styles {
<style>
    /* PAGE HEADER */
    .page-header {
        position:sticky; top:0; z-index:50;
        background:rgba(5,13,26,0.94); backdrop-filter:blur(14px);
        border-bottom:1px solid var(--border);
        padding:16px 36px;
        display:flex; align-items:center; justify-content:space-between;
    }
    .breadcrumb { display:flex; align-items:center; gap:6px; font-size:12px; color:var(--faint); }
    .breadcrumb a { color:var(--faint); text-decoration:none; transition:color .15s; }
    .breadcrumb a:hover { color:var(--muted); }
    .breadcrumb-sep { opacity:.5; }
    .page-title { font-family:'Syne',sans-serif; font-size:20px; font-weight:700; margin-top:3px; }
    .header-actions { display:flex; gap:10px; align-items:center; }
    .btn-primary { display:inline-flex; align-items:center; gap:7px; background:var(--accent); border:none; border-radius:10px; color:white; font-family:'Syne',sans-serif; font-size:13px; font-weight:600; padding:10px 18px; cursor:pointer; text-decoration:none; transition:background .2s, transform .15s; box-shadow:0 4px 14px rgba(59,130,246,.25); }
    .btn-primary:hover { background:#2563eb; transform:translateY(-1px); }
    .btn-primary svg { width:14px; height:14px; }

    /* CONTENT */
    .content { padding:28px 36px; }

    /* STATS */
    .stats-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:14px; margin-bottom:24px; }
    .stat-card { background:var(--card); border:1px solid var(--border); border-radius:var(--radius); padding:18px 20px; display:flex; flex-direction:column; gap:6px; animation:fadeUp .4s ease both; transition:border-color .2s, transform .2s; }
    .stat-card:hover { border-color:var(--border-md); transform:translateY(-2px); }
    .stat-card:nth-child(2){animation-delay:.05s} .stat-card:nth-child(3){animation-delay:.10s} .stat-card:nth-child(4){animation-delay:.15s} .stat-card:nth-child(5){animation-delay:.20s}
    .stat-label { font-size:11px; color:var(--faint); text-transform:uppercase; letter-spacing:.06em; }
    .stat-val { font-family:'Syne',sans-serif; font-size:26px; font-weight:800; letter-spacing:-.02em; line-height:1; }
    .stat-sub { font-size:11px; color:var(--faint); }
    .stat-icon { width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; margin-bottom:4px; }
    .stat-icon svg { width:16px; height:16px; }
    .s-blue .stat-icon  { background:var(--accent-soft); color:var(--accent-light); } .s-blue .stat-val  { color:var(--accent-light); }
    .s-green .stat-icon { background:var(--green-soft);  color:var(--green); }        .s-green .stat-val { color:var(--green); }
    .s-red .stat-icon   { background:var(--red-soft);    color:var(--red); }          .s-red .stat-val   { color:var(--red); }
    .s-orange .stat-icon{ background:var(--orange-soft); color:var(--orange); }       .s-orange .stat-val{ color:var(--orange); }
    .s-gold .stat-icon  { background:var(--gold-soft);   color:var(--gold); }         .s-gold .stat-val  { color:var(--gold); }

    /* CONTROLS */
    .controls-bar { display:flex; align-items:center; gap:12px; margin-bottom:20px; flex-wrap:wrap; }
    .search-wrap { position:relative; flex:1; min-width:200px; }
    .search-icon { position:absolute; left:13px; top:50%; transform:translateY(-50%); color:var(--faint); pointer-events:none; }
    .search-icon svg { width:15px; height:15px; }
    .search-input { width:100%; height:42px; background:var(--card); border:1px solid var(--border); border-radius:10px; padding:0 14px 0 40px; font-family:'DM Sans',sans-serif; font-size:14px; color:var(--text); outline:none; transition:border-color .2s, box-shadow .2s; }
    .search-input::placeholder { color:var(--faint); }
    .search-input:focus { border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-glow); }
    .filter-select { height:42px; padding:0 14px; background:var(--card); border:1px solid var(--border); border-radius:10px; font-family:'DM Sans',sans-serif; font-size:13px; color:var(--muted); outline:none; cursor:pointer; transition:border-color .2s; -webkit-appearance:none; min-width:140px; }
    .filter-select:focus { border-color:var(--accent); }
    .view-toggle { display:flex; background:var(--card); border:1px solid var(--border); border-radius:10px; overflow:hidden; }
    .view-btn { width:40px; height:40px; display:flex; align-items:center; justify-content:center; cursor:pointer; color:var(--faint); transition:background .15s, color .15s; border:none; background:none; }
    .view-btn:hover { color:var(--muted); }
    .view-btn.active { background:var(--accent-soft); color:var(--accent-light); }
    .view-btn svg { width:15px; height:15px; }
    .results-info { font-size:12px; color:var(--faint); white-space:nowrap; }

    /* PRODUCT GRID */
    .prod-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:16px; }
    .prod-card { background:var(--card); border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; display:flex; flex-direction:column; transition:border-color .2s, transform .2s, box-shadow .2s; animation:fadeUp .45s ease both; }
    .prod-card:hover { border-color:var(--border-md); transform:translateY(-3px); box-shadow:0 8px 32px rgba(0,0,0,.25); }
    .card-img-area { height:120px; position:relative; display:flex; align-items:center; justify-content:center; overflow:hidden; }
    .card-img-bg { position:absolute; inset:0; }
    .card-cat-emoji { width:56px; height:56px; line-height:1; position:relative; z-index:1; filter:drop-shadow(0 2px 8px rgba(0,0,0,.3)); }
    .card-cat-emoji svg { width:100%; height:100%; }
    .card-status-pill { position:absolute; top:10px; right:10px; z-index:2; padding:3px 9px; border-radius:20px; font-size:10px; font-weight:600; letter-spacing:.04em; text-transform:uppercase; }
    .pill-ativo   { background:var(--green-soft); color:var(--green); border:1px solid rgba(52,211,153,.3); }
    .pill-inativo { background:var(--red-soft);   color:var(--red);   border:1px solid rgba(248,113,113,.2); }
    .card-cat-badge { position:absolute; bottom:8px; left:10px; z-index:2; padding:2px 8px; border-radius:20px; font-size:9px; font-weight:600; letter-spacing:.05em; text-transform:uppercase; }
    .card-body { padding:16px 18px; flex:1; display:flex; flex-direction:column; gap:10px; }
    .card-name { font-family:'Syne',sans-serif; font-size:14px; font-weight:700; color:var(--text); line-height:1.25; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .card-price { font-family:'Syne',sans-serif; font-size:20px; font-weight:800; color:var(--green); letter-spacing:-.01em; }
    .card-stock-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:5px; }
    .card-stock-label { font-size:10px; color:var(--faint); text-transform:uppercase; letter-spacing:.05em; }
    .card-stock-num { font-size:12px; font-weight:600; }
    .stock-track { height:4px; border-radius:2px; background:rgba(255,255,255,.06); overflow:hidden; }
    .stock-fill  { height:100%; border-radius:2px; transition:width .4s; }
    .card-alert { display:flex; align-items:center; gap:5px; font-size:10px; padding:5px 9px; border-radius:6px; }
    .alert-low   { background:var(--orange-soft); color:var(--orange); }
    .alert-empty { background:var(--red-soft);    color:var(--red); }
    .card-alert svg { width:11px; height:11px; flex-shrink:0; }
    .card-footer { padding:10px 18px 14px; display:flex; gap:8px; }
    .btn-edit { flex:1; height:34px; background:var(--accent-soft); border:1px solid rgba(59,130,246,.2); border-radius:8px; color:var(--accent-light); font-family:'DM Sans',sans-serif; font-size:12px; font-weight:500; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; gap:5px; transition:background .18s, border-color .18s; }
    .btn-edit:hover { background:rgba(59,130,246,.2); border-color:rgba(59,130,246,.4); }
    .btn-edit svg { width:12px; height:12px; }
    .btn-del { width:34px; height:34px; background:none; border:1px solid var(--border); border-radius:8px; color:var(--faint); cursor:pointer; display:inline-flex; align-items:center; justify-content:center; transition:background .18s, color .18s, border-color .18s; }
    .btn-del:hover { background:var(--red-soft); color:var(--red); border-color:rgba(248,113,113,.3); }
    .btn-del svg { width:13px; height:13px; }

    /* TABLE VIEW */
    .prod-table-wrap { overflow-x:auto; }
    .prod-table { width:100%; border-collapse:collapse; }
    .prod-table th { text-align:left; font-size:10px; font-weight:600; color:var(--faint); text-transform:uppercase; letter-spacing:.08em; padding:0 16px 12px; border-bottom:1px solid var(--border); }
    .prod-table th:last-child { text-align:right; }
    .prod-table td { padding:14px 16px; border-bottom:1px solid var(--border); vertical-align:middle; }
    .prod-table tr:last-child td { border-bottom:none; }
    .prod-table tr { transition:background .15s; }
    .prod-table tr:hover td { background:rgba(255,255,255,.015); }
    .tbl-name { font-weight:600; font-size:14px; color:var(--text); display:flex; align-items:center; gap:10px; }
    .tbl-emoji { width:24px; height:24px; line-height:1; display:inline-flex; align-items:center; justify-content:center; }
    .tbl-emoji svg { width:100%; height:100%; }
    .tbl-price { font-family:'Syne',sans-serif; font-size:15px; font-weight:700; color:var(--green); }
    .tbl-actions { display:flex; gap:6px; justify-content:flex-end; }

    /* EMPTY / NO RESULTS */
    .empty-state { text-align:center; padding:80px 20px; animation:fadeUp .5s ease both; }
    .empty-icon { font-size:72px; line-height:1; margin-bottom:20px; opacity:.5; }
    .empty-title { font-family:'Syne',sans-serif; font-size:20px; font-weight:700; color:var(--muted); margin-bottom:8px; }
    .empty-sub { font-size:14px; color:var(--faint); margin-bottom:28px; }
    .empty-cta { display:inline-flex; align-items:center; gap:8px; background:var(--accent); border:none; border-radius:10px; color:white; font-family:'Syne',sans-serif; font-size:14px; font-weight:600; padding:12px 24px; text-decoration:none; box-shadow:0 4px 16px rgba(59,130,246,.3); transition:background .2s, transform .15s; }
    .empty-cta:hover { background:#2563eb; transform:translateY(-2px); }
    .empty-cta svg { width:15px; height:15px; }
    .no-results { text-align:center; padding:60px 20px; font-size:14px; color:var(--faint); display:none; }
    .no-results strong { display:block; font-size:16px; color:var(--muted); margin-bottom:6px; }

    /* EDIT MODAL */
    .modal-overlay { position:fixed; inset:0; z-index:200; background:rgba(2,8,18,.75); backdrop-filter:blur(6px); display:flex; align-items:center; justify-content:center; opacity:0; pointer-events:none; transition:opacity .2s; }
    .modal-overlay.open { opacity:1; pointer-events:all; }
    .modal { background:var(--card); border:1px solid var(--border-md); border-radius:18px; padding:0; width:520px; max-width:calc(100vw - 32px); max-height:calc(100vh - 80px); overflow-y:auto; transform:scale(.95) translateY(16px); transition:transform .25s cubic-bezier(.34,1.56,.64,1); box-shadow:0 24px 80px rgba(0,0,0,.5); }
    .modal-overlay.open .modal { transform:scale(1) translateY(0); }
    .modal-header { padding:24px 28px 0; display:flex; align-items:flex-start; justify-content:space-between; }
    .modal-title { font-family:'Syne',sans-serif; font-size:17px; font-weight:700; }
    .modal-sub { font-size:12px; color:var(--faint); margin-top:2px; }
    .modal-close { width:32px; height:32px; border-radius:8px; background:none; border:1px solid var(--border); color:var(--muted); cursor:pointer; display:flex; align-items:center; justify-content:center; transition:background .15s, color .15s; flex-shrink:0; }
    .modal-close:hover { background:var(--red-soft); color:var(--red); border-color:rgba(248,113,113,.3); }
    .modal-close svg { width:14px; height:14px; }
    .modal-body { padding:24px 28px; }
    .modal .form-group { margin-bottom:18px; }
    .modal .form-label { display:block; font-size:11px; font-weight:500; color:var(--muted); margin-bottom:7px; text-transform:uppercase; letter-spacing:.06em; }
    .modal .form-control { width:100%; height:44px; background:var(--panel); border:1px solid var(--border); border-radius:10px; padding:0 14px; font-family:'DM Sans',sans-serif; font-size:14px; color:var(--text); outline:none; transition:border-color .2s, box-shadow .2s; -webkit-appearance:none; }
    .modal .form-control:focus { border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-glow); }
    .modal-toggle-row { display:flex; align-items:center; justify-content:space-between; padding:13px 16px; background:var(--panel); border:1px solid var(--border); border-radius:10px; cursor:pointer; transition:border-color .2s; }
    .modal-toggle-row.on { border-color:rgba(52,211,153,.3); background:rgba(52,211,153,.04); }
    .modal-toggle-title { font-size:14px; color:var(--text); }
    .toggle-switch { position:relative; width:44px; height:24px; flex-shrink:0; }
    .toggle-switch input { opacity:0; width:0; height:0; position:absolute; }
    .toggle-track { position:absolute; inset:0; border-radius:12px; background:var(--faint); transition:background .2s; cursor:pointer; }
    .toggle-switch input:checked + .toggle-track { background:var(--green); }
    .toggle-thumb { position:absolute; top:3px; left:3px; width:18px; height:18px; border-radius:50%; background:white; transition:transform .2s; pointer-events:none; }
    .toggle-switch input:checked ~ .toggle-thumb { transform:translateX(20px); }
    .modal-footer { padding:0 28px 24px; display:flex; align-items:center; justify-content:flex-end; gap:10px; }
    .btn-modal-cancel { height:42px; padding:0 20px; background:none; border:1px solid var(--border); border-radius:10px; color:var(--muted); font-family:'DM Sans',sans-serif; font-size:14px; cursor:pointer; transition:background .18s, color .18s; }
    .btn-modal-cancel:hover { background:var(--card-hover); color:var(--text); }
    .btn-modal-save { height:42px; padding:0 24px; background:var(--accent); border:none; border-radius:10px; color:white; font-family:'Syne',sans-serif; font-size:14px; font-weight:600; cursor:pointer; transition:background .2s; box-shadow:0 4px 14px rgba(59,130,246,.25); }
    .btn-modal-save:hover { background:#2563eb; }
    .del-modal { width:400px; }
    .del-icon-wrap { width:56px; height:56px; border-radius:14px; background:var(--red-soft); border:1px solid rgba(248,113,113,.25); display:flex; align-items:center; justify-content:center; margin-bottom:16px; }
    .del-icon-wrap svg { width:26px; height:26px; color:var(--red); }
    .del-title { font-family:'Syne',sans-serif; font-size:18px; font-weight:700; margin-bottom:6px; }
    .del-sub { font-size:13px; color:var(--muted); line-height:1.5; }
    .del-product-name { font-weight:600; color:var(--text); }
    .btn-modal-del { height:42px; padding:0 24px; background:var(--red); border:none; border-radius:10px; color:white; font-family:'Syne',sans-serif; font-size:14px; font-weight:600; cursor:pointer; transition:background .2s; }
    .btn-modal-del:hover { background:#ef4444; }

    @@media (max-width:1200px) { .stats-grid { grid-template-columns:repeat(3,1fr); } }
    @@media (max-width:900px)  { .stats-grid { grid-template-columns:repeat(2,1fr); } }
    @@media (max-width:700px)  { .content { padding:16px; } .page-header { padding:14px 16px; } .stats-grid { grid-template-columns:repeat(2,1fr); } }
</style>
}

<!-- MAIN -->
<main class="main" style="flex-direction:column">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div>
            <div class="breadcrumb">
                <a href="/Admin/Dashboard">Dashboard</a>
                <span class="breadcrumb-sep">/</span>
                <span style="color:var(--muted)">Produtos</span>
            </div>
            <div class="page-title">Produtos</div>
        </div>
        <div class="header-actions">
            @if (ViewBag.Erro != null) {
                <span style="font-size:12px;color:var(--red)">@ViewBag.Erro</span>
            }
            @if (TempData["UploadAviso"] != null) {
                <span style="font-size:12px;color:var(--orange);background:var(--orange-soft);border:1px solid rgba(251,146,60,.3);padding:6px 12px;border-radius:8px;">
                    ⚠ @TempData["UploadAviso"]
                </span>
            }
            @if (podeEditar) {
                <a href="/Produto/Create" class="btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    Novo Produto
                </a>
            }
        </div>
    </div>

    <div class="content">

        @if (totalProd == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">📦</div>
                <div class="empty-title">Nenhum produto cadastrado</div>
                <div class="empty-sub">Adicione produtos para começar a gerenciar seu estoque e realizar vendas.</div>
                @if (podeEditar) {
                    <a href="/Produto/Create" class="empty-cta">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                        Cadastrar primeiro produto
                    </a>
                }
            </div>
        }
        else
        {
            <!-- STATS -->
            <div class="stats-grid">
                <div class="stat-card s-blue">
                    <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div>
                    <div class="stat-val">@totalProd</div>
                    <div class="stat-label">Total de produtos</div>
                </div>
                <div class="stat-card s-green">
                    <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
                    <div class="stat-val">@totalAtivos</div>
                    <div class="stat-label">Ativos</div>
                    <div class="stat-sub">@(totalProd - totalAtivos) inativos</div>
                </div>
                <div class="stat-card s-orange">
                    <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
                    <div class="stat-val">@baixoEstoque</div>
                    <div class="stat-label">Estoque baixo</div>
                    <div class="stat-sub">abaixo do mínimo</div>
                </div>
                <div class="stat-card s-red">
                    <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><line x1="12" y1="12" x2="12" y2="16"/></svg></div>
                    <div class="stat-val">@semEstoque</div>
                    <div class="stat-label">Sem estoque</div>
                </div>
                <div class="stat-card s-gold">
                    <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
                    <div class="stat-val" style="font-size:18px">@valorTotal.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</div>
                    <div class="stat-label">Valor em estoque</div>
                </div>
            </div>

            <!-- CONTROLS -->
            <div class="controls-bar">
                <form action="/Produto" method="get" style="display:contents">
                    <div class="search-wrap">
                        <div class="search-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></div>
                        <input type="text" class="search-input" id="searchInput" name="search"
                               value="@paged.Search"
                               placeholder="Buscar produto (Enter para busca completa)..." />
                    </div>
                </form>
                <select class="filter-select" id="filterCat">
                    <option value="">Todas as categorias</option>
                    @foreach (var cat in lista.Select(p => p.Categoria ?? "Sem categoria").Distinct().OrderBy(c => c)) {
                        <option value="@cat">@cat</option>
                    }
                </select>
                <select class="filter-select" id="filterStatus" style="min-width:120px">
                    <option value="">Todos</option>
                    <option value="ativo">Ativos</option>
                    <option value="inativo">Inativos</option>
                    <option value="alerta">Estoque baixo</option>
                    <option value="zerado">Sem estoque</option>
                </select>
                <div class="view-toggle">
                    <button class="view-btn active" id="btnGrid" title="Grade">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                    </button>
                    <button class="view-btn" id="btnList" title="Lista">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                    </button>
                </div>
                <div class="results-info" id="resultsInfo">@totalProd produtos</div>
            </div>

            <!-- GRID VIEW -->
            <div id="viewGrid">
                <div class="prod-grid" id="prodGrid">
                    @foreach (var p in lista)
                    {
                        var cat        = p.Categoria ?? "";
                        var isLow      = p.EstoqueMinimo > 0 && p.EstoqueAtual > 0 && p.EstoqueAtual <= p.EstoqueMinimo;
                        var isEmpty    = p.EstoqueAtual == 0;
                        var maxStock   = Math.Max(p.EstoqueAtual, p.EstoqueMinimo * 2);
                        if (maxStock == 0) { maxStock = 10; }
                        var stockPct   = Math.Min(100, p.EstoqueAtual * 100 / maxStock);
                        var stockColor = isEmpty ? "#f87171" : (isLow ? "#fb923c" : "#34d399");
                        var stockNumColor = isEmpty ? "var(--red)" : (isLow ? "var(--orange)" : "var(--green)");

                        <div class="prod-card"
                             data-name="@p.Nome.ToLower()"
                             data-cat="@cat"
                             data-ativo="@(p.Ativo ? "ativo" : "inativo")"
                             data-low="@(isLow ? "true" : "false")"
                             data-empty="@(isEmpty ? "true" : "false")">

                            <div class="card-img-area">
                                @if (!string.IsNullOrEmpty(p.FotoUrl)) {
                                    <img src="@p.FotoUrl" alt="@p.Nome" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" />
                                } else {
                                    <div class="card-img-bg" id="bg-@p.ProdutoId"></div>
                                    <div class="card-cat-emoji" id="icon-@p.ProdutoId"></div>
                                }
                                <div class="card-status-pill @(p.Ativo ? "pill-ativo" : "pill-inativo")">@(p.Ativo ? "Ativo" : "Inativo")</div>
                                @if (!string.IsNullOrEmpty(cat)) {
                                    <div class="card-cat-badge" id="badge-@p.ProdutoId">@cat</div>
                                }
                            </div>

                            <div class="card-body">
                                <div class="card-name">@p.Nome</div>
                                <div class="card-price">@p.PrecoVenda.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</div>
                                <div class="card-stock">
                                    <div class="card-stock-header">
                                        <div class="card-stock-label">Estoque</div>
                                        <div class="card-stock-num" style="color:@stockNumColor">@p.EstoqueAtual un</div>
                                    </div>
                                    <div class="stock-track"><div class="stock-fill" style="width:@(stockPct)%;background:@stockColor"></div></div>
                                </div>
                                @if (isEmpty) {
                                    <div class="card-alert alert-empty">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                                        Sem estoque
                                    </div>
                                } else if (isLow) {
                                    <div class="card-alert alert-low">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                                        Estoque baixo (mín: @p.EstoqueMinimo)
                                    </div>
                                }
                            </div>

                            @if (podeEditar) {
                                <div class="card-footer">
                                    <button type="button" class="btn-edit js-edit-prod"
                                            data-id="@p.ProdutoId" data-nome="@p.Nome"
                                            data-cat="@(p.Categoria ?? "")"
                                            data-preco="@p.PrecoVenda.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-estoque-min="@p.EstoqueMinimo"
                                            data-ativo="@(p.Ativo ? "true" : "false")"
                                            data-foto="@(p.FotoUrl ?? "")">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                        Editar
                                    </button>
                                    <button type="button" class="btn-del js-del-prod"
                                            data-id="@p.ProdutoId" data-nome="@p.Nome" title="Excluir">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="no-results" id="noResults">
                    <strong>Nenhum produto encontrado</strong>
                    Tente outros termos ou remova os filtros.
                </div>
            </div>

            <!-- LIST VIEW -->
            <div id="viewList" style="display:none">
                <div class="prod-table-wrap">
                    <table class="prod-table" id="prodTable">
                        <thead>
                            <tr>
                                <th>Produto</th><th>Categoria</th><th>Preço</th><th>Estoque</th><th>Status</th>
                                @if (podeEditar) { <th>Ações</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in lista)
                            {
                                var cat2     = p.Categoria ?? "";
                                var isLow2   = p.EstoqueMinimo > 0 && p.EstoqueAtual > 0 && p.EstoqueAtual <= p.EstoqueMinimo;
                                var isEmpty2 = p.EstoqueAtual == 0;
                                var snColor  = isEmpty2 ? "var(--red)" : (isLow2 ? "var(--orange)" : "var(--green)");
                                <tr data-name="@p.Nome.ToLower()" data-cat="@cat2"
                                    data-ativo="@(p.Ativo ? "ativo" : "inativo")"
                                    data-low="@(isLow2 ? "true" : "false")"
                                    data-empty="@(isEmpty2 ? "true" : "false")">
                                    <td>
                                        <div class="tbl-name">
                                            @if (!string.IsNullOrEmpty(p.FotoUrl)) {
                                                <img src="@p.FotoUrl" alt="@p.Nome" style="width:32px;height:32px;object-fit:cover;border-radius:6px;flex-shrink:0;" />
                                            } else {
                                                <span class="tbl-emoji" id="tbl-icon-@p.ProdutoId"></span>
                                            }
                                            @p.Nome
                                        </div>
                                    </td>
                                    <td style="font-size:13px;color:var(--muted)">@(cat2 == "" ? "—" : cat2)</td>
                                    <td class="tbl-price">@p.PrecoVenda.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                                    <td style="font-size:13px;font-weight:600;color:@snColor">@p.EstoqueAtual un</td>
                                    <td><span class="card-status-pill @(p.Ativo ? "pill-ativo" : "pill-inativo")" style="position:static">@(p.Ativo ? "Ativo" : "Inativo")</span></td>
                                    @if (podeEditar) {
                                        <td>
                                            <div class="tbl-actions">
                                                <button type="button" class="btn-edit js-edit-prod" style="width:auto;padding:0 12px"
                                                        data-id="@p.ProdutoId" data-nome="@p.Nome"
                                                        data-cat="@(p.Categoria ?? "")"
                                                        data-preco="@p.PrecoVenda.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                        data-estoque-min="@p.EstoqueMinimo"
                                                        data-ativo="@(p.Ativo ? "true" : "false")"
                                                        data-foto="@(p.FotoUrl ?? "")">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                                    Editar
                                                </button>
                                                <button type="button" class="btn-del js-del-prod"
                                                        data-id="@p.ProdutoId" data-nome="@p.Nome">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                                </button>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @Html.Partial("_PaginationControls", (ATLAS_ERP.Infrastructure.IPagedResult)paged)

    </div>
</main>

@if (podeEditar)
{
    <div class="modal-overlay" id="editOverlay">
