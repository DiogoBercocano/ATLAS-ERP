@section scripts {
<script nonce="@Html.CspNonce()">
var catConfig = {
    'Eletrônicos': { bg:'linear-gradient(135deg,rgba(59,130,246,0.22),rgba(5,13,26,0))', badge:'rgba(59,130,246,0.22)', color:'#60a5fa' },
    'Alimentos':        { bg:'linear-gradient(135deg,rgba(52,211,153,0.18),rgba(5,13,26,0))',  badge:'rgba(52,211,153,0.22)',  color:'#34d399' },
    'Roupas':           { bg:'linear-gradient(135deg,rgba(244,114,182,0.18),rgba(5,13,26,0))', badge:'rgba(244,114,182,0.22)', color:'#f472b6' },
    'Ferramentas':      { bg:'linear-gradient(135deg,rgba(251,146,60,0.18),rgba(5,13,26,0))',  badge:'rgba(251,146,60,0.22)',  color:'#fb923c' },
    'Serviços':   { bg:'linear-gradient(135deg,rgba(167,139,250,0.18),rgba(5,13,26,0))', badge:'rgba(167,139,250,0.22)', color:'#a78bfa' },
    'Bebidas':          { bg:'linear-gradient(135deg,rgba(45,212,191,0.18),rgba(5,13,26,0))',  badge:'rgba(45,212,191,0.22)',  color:'#2dd4bf' },
    'Limpeza':          { bg:'linear-gradient(135deg,rgba(59,130,246,0.18),rgba(5,13,26,0))',  badge:'rgba(59,130,246,0.20)',  color:'#60a5fa' },
    'Outros':           { bg:'linear-gradient(135deg,rgba(201,168,76,0.18),rgba(5,13,26,0))',  badge:'rgba(201,168,76,0.22)',  color:'#c9a84c' }
};
var defaultCfg = { bg:'linear-gradient(135deg,rgba(61,82,112,0.22),rgba(5,13,26,0))', badge:'rgba(61,82,112,0.30)', color:'#7a9cc8' };

function getCategorySvg(cat) {
    var svgs = {
        'Eletrônicos':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="13" rx="1"/><path d="M3 17h18"/></svg>',
        'Alimentos':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/></svg>',
        'Roupas':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 5l3 2v9h6v-9l3-2M9 7h6"/></svg>',
        'Ferramentas':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.4 14.4L9.6 9.6"/></svg>',
        'Serviços':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v6m0 6v6M4.22 4.22l4.24 4.24m4.24 4.24l4.24 4.24M1 12h6m6 0h6M4.22 19.78l4.24-4.24m4.24-4.24l4.24-4.24"/></svg>',
        'Bebidas':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 4h10v8c0 2-2 4-5 4c-3 0-5-2-5-4z"/><path d="M8 16h8M7 20h10"/></svg>',
        'Limpeza':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l-2 3h-3l2 3H6l2 3H5l2 3H4l2 3H3l3 4h12l3-4h-3l2-3h-3l2-3h-3l2-3h-3l2-3h-3z"/></svg>',
        'Outros':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>'
    };
    return svgs[cat] || svgs['Outros'];
}
function getCfg(cat) { var b = catConfig[cat] || defaultCfg; return { svg: getCategorySvg(cat), bg: b.bg, badge: b.badge, color: b.color }; }

function applyCardStyles() {
    document.querySelectorAll('.prod-card').forEach(function(card) {
        var iconEl = card.querySelector('.card-cat-emoji');
        if (!iconEl) return;
        var cat = card.getAttribute('data-cat');
        var cfg = getCfg(cat);
        var id  = iconEl.id.replace('icon-','');
        var bgEl = document.getElementById('bg-'+id);
        var badgeEl = document.getElementById('badge-'+id);
        if (bgEl) bgEl.style.background = cfg.bg;
        iconEl.innerHTML = cfg.svg;
        if (badgeEl) { badgeEl.style.background = cfg.badge; badgeEl.style.color = cfg.color; badgeEl.style.border = '1px solid '+cfg.color+'44'; }
    });
    document.querySelectorAll('[id^="tbl-icon-"]').forEach(function(el) {
        var row = el.closest('tr');
        if (!row) return;
        el.innerHTML = getCfg(row.getAttribute('data-cat')).svg;
    });
}

var currentView = 'grid';
function setView(v) {
    currentView = v;
    document.getElementById('viewGrid').style.display = v === 'grid' ? '' : 'none';
    document.getElementById('viewList').style.display = v === 'list' ? '' : 'none';
    document.getElementById('btnGrid').classList.toggle('active', v === 'grid');
    document.getElementById('btnList').classList.toggle('active', v === 'list');
}

function applyFilters() {
    var q      = (document.getElementById('searchInput').value || '').toLowerCase().trim();
    var cat    = (document.getElementById('filterCat').value   || '').toLowerCase();
    var status = (document.getElementById('filterStatus').value || '');
    var visible = 0;
    document.querySelectorAll('#prodGrid .prod-card').forEach(function(card) {
        var show = matchItem(card, q, cat, status);
        card.style.display = show ? '' : 'none';
        if (show) visible++;
    });
    document.querySelectorAll('#prodTable tbody tr').forEach(function(row) {
        row.style.display = matchItem(row, q, cat, status) ? '' : 'none';
    });
    document.getElementById('resultsInfo').textContent = visible + ' produto' + (visible !== 1 ? 's' : '');
    var noR = document.getElementById('noResults');
    if (noR) noR.style.display = (visible === 0 && currentView === 'grid') ? 'block' : 'none';
}

function matchItem(el, q, cat, status) {
    var name  = el.getAttribute('data-name') || '';
    var elCat = (el.getAttribute('data-cat') || '').toLowerCase();
    var ativo = el.getAttribute('data-ativo') || '';
    var low   = el.getAttribute('data-low')   === 'true';
    var empty = el.getAttribute('data-empty') === 'true';
    if (q      && name.indexOf(q) === -1)    return false;
    if (cat    && elCat.indexOf(cat) === -1) return false;
    if (status === 'ativo'   && ativo !== 'ativo')   return false;
    if (status === 'inativo' && ativo !== 'inativo') return false;
    if (status === 'alerta'  && !low)   return false;
    if (status === 'zerado'  && !empty) return false;
    return true;
}

function openEdit(id, nome, cat, preco, estoqueMin, ativo, fotoUrl) {
    document.getElementById('editProdutoId').value  = id;
    document.getElementById('editNome').value        = nome;
    document.getElementById('editCategoria').value   = cat;
    document.getElementById('editPreco').value       = preco.replace('.', ',');
    document.getElementById('editEstoqueMin').value  = estoqueMin;
    var cb = document.getElementById('editAtivo');
    cb.checked = ativo === 'true';
    onEditAtivoChange(cb);
    document.getElementById('editModalSub').textContent = nome;
    var prev  = document.getElementById('editFotoPreview');
    var label = document.getElementById('editFotoLabel');
    document.getElementById('editFotoInput').value = '';
    if (fotoUrl) { prev.src = fotoUrl; prev.style.display = ''; label.textContent = 'Alterar foto…'; }
    else         { prev.src = '';      prev.style.display = 'none'; label.textContent = 'Adicionar foto…'; }
    document.getElementById('editOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
}
function onEditFotoChange(input) {
    if (input.files && input.files[0]) {
        var reader = new FileReader();
        reader.onload = function(e) {
            var prev = document.getElementById('editFotoPreview');
            prev.src = e.target.result; prev.style.display = '';
            document.getElementById('editFotoLabel').textContent = input.files[0].name;
        };
        reader.readAsDataURL(input.files[0]);
    }
}
function closeEdit() { document.getElementById('editOverlay').classList.remove('open'); document.body.style.overflow = ''; }
function closeEditIfOutside(e) { if (e.target === document.getElementById('editOverlay')) closeEdit(); }
function onEditAtivoChange(cb) {
    document.getElementById('editAtivoHidden').value = cb.checked ? 'true' : 'false';
    document.getElementById('editToggleRow').classList.toggle('on', cb.checked);
}
function submitEdit() {
    var precoEl = document.getElementById('editPreco');
    precoEl.value = precoEl.value.replace(',', '.');
    document.getElementById('editForm').submit();
}

function openDelete(id, nome) {
    document.getElementById('delProdutoId').value = id;
    document.getElementById('delProdNome').textContent = '“' + nome + '”';
    document.getElementById('delOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
}
function closeDel() { document.getElementById('delOverlay').classList.remove('open'); document.body.style.overflow = ''; }
function closeDelIfOutside(e) { if (e.target === document.getElementById('delOverlay')) closeDel(); }

document.addEventListener('keydown', function(e) { if (e.key === 'Escape') { closeEdit(); closeDel(); } });
document.addEventListener('click', function(e) {
    var btnEdit = e.target.closest('.js-edit-prod');
    if (btnEdit) { openEdit(btnEdit.dataset.id, btnEdit.dataset.nome||'', btnEdit.dataset.cat||'', btnEdit.dataset.preco||'0', btnEdit.dataset.estoqueMin||'0', btnEdit.dataset.ativo||'false', btnEdit.dataset.foto||''); return; }
    var btnDel = e.target.closest('.js-del-prod');
    if (btnDel) { openDelete(btnDel.dataset.id, btnDel.dataset.nome||''); }
});

applyCardStyles();

// Filtros e view toggle
document.getElementById('searchInput').addEventListener('input', applyFilters);
document.getElementById('filterCat').addEventListener('change', applyFilters);
document.getElementById('filterStatus').addEventListener('change', applyFilters);
document.getElementById('btnGrid').addEventListener('click', function() { setView('grid'); });
document.getElementById('btnList').addEventListener('click', function() { setView('list'); });

// Modal de edição
var editOverlayEl = document.getElementById('editOverlay');
if (editOverlayEl) {
    editOverlayEl.addEventListener('click', closeEditIfOutside);
    document.getElementById('editCloseBtn').addEventListener('click', closeEdit);
    document.getElementById('editCancelBtn').addEventListener('click', closeEdit);
    document.getElementById('editSaveBtn').addEventListener('click', submitEdit);
    document.getElementById('editFotoInput').addEventListener('change', function() { onEditFotoChange(this); });
    document.getElementById('editAtivo').addEventListener('change', function() { onEditAtivoChange(this); });
}

// Modal de exclusão
var delOverlayEl = document.getElementById('delOverlay');
if (delOverlayEl) {
    delOverlayEl.addEventListener('click', closeDelIfOutside);
    document.getElementById('delCancelBtn').addEventListener('click', closeDel);
}
</script>
}
