                <div>
                    <div class="modal-title">Editar Produto</div>
                    <div class="modal-sub" id="editModalSub">—</div>
                </div>
                <button class="modal-close" id="editCloseBtn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
