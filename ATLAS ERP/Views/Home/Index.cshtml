@{
    ViewBag.Title = "Atlas ERP — Gestão Comercial Inteligente";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Atlas ERP — Gestão Comercial Inteligente</title>
    <meta name="description" content="Atlas ERP: controle vendas, estoque, clientes, fornecedores e financeiro em uma única plataforma segura e multiempresa." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <style>
        /* ─────────────────────────────────────────────────────────────────────
           RESET
        ───────────────────────────────────────────────────────────────────── */
        *, *::before, *::after {
            margin: 0; padding: 0;
            box-sizing: border-box;
            -webkit-font-smoothing: antialiased;
        }

        /* ─────────────────────────────────────────────────────────────────────
           ACESSIBILIDADE
        ───────────────────────────────────────────────────────────────────── */
        .skip-link {
            position: absolute;
            top: -200%;
            left: 16px;
            background: var(--c-blue);
            color: #fff;
            padding: 10px 20px;
            border-radius: 0 0 var(--radius-sm) var(--radius-sm);
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            z-index: 9999;
            transition: top 0.15s;
        }
        .skip-link:focus-visible { top: 0; }

        :focus-visible {
            outline: 2px solid var(--c-blue-light);
            outline-offset: 3px;
            border-radius: 4px;
        }

        /* Garante que elementos com outline próprio não dupliquem */
        .btn-cta-primary:focus-visible,
        .btn-cta-ghost:focus-visible,
        .btn-ghost:focus-visible,
        .btn-solid:focus-visible {
            outline: 2px solid var(--c-blue-light);
            outline-offset: 3px;
        }

        /* ─────────────────────────────────────────────────────────────────────
           TOKENS
        ───────────────────────────────────────────────────────────────────── */
        :root {
            --c-bg:          #040c18;
            --c-surface-1:   #081220;
            --c-surface-2:   #0c1a2e;
            --c-surface-3:   #101f36;
            --c-border:      rgba(80, 140, 255, 0.09);
            --c-border-md:   rgba(80, 140, 255, 0.17);
            --c-border-hi:   rgba(80, 140, 255, 0.32);

            --c-blue:        #3b82f6;
            --c-blue-dark:   #1d4ed8;
            --c-blue-light:  #60a5fa;
            --c-blue-glow:   rgba(59, 130, 246, 0.18);

            --c-gold:        #d4a847;
            --c-teal:        #2dd4bf;
            --c-purple:      #a78bfa;
            --c-rose:        #fb7185;
            --c-green:       #4ade80;

            --c-text:        #dce8fd;
            --c-text-2:      #6b8fb5;
            --c-text-3:      #5e7ea0;

            --radius-sm:   8px;
            --radius-md:   14px;
            --radius-lg:   20px;
            --radius-xl:   28px;

            --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
            --ease-in-out:   cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* ─────────────────────────────────────────────────────────────────────
           BASE
        ───────────────────────────────────────────────────────────────────── */
        html {
            scroll-behavior: smooth;
            scroll-padding-top: 68px;
        }

        body {
            font-family: 'DM Sans', system-ui, sans-serif;
            background: var(--c-bg);
            color: var(--c-text);
            min-height: 100vh;
            overflow-x: hidden;
            line-height: 1;
        }

        /* ─────────────────────────────────────────────────────────────────────
           BACKGROUND CANVAS
        ───────────────────────────────────────────────────────────────────── */
        .canvas {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
        }

        .canvas-grid {
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(59,130,246,.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(59,130,246,.04) 1px, transparent 1px);
            background-size: 60px 60px;
            mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black, transparent);
        }

        .canvas-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(140px);
        }

        .canvas-ring {
            position: absolute;
            border-radius: 50%;
            border: 1px solid rgba(59,130,246,0.05);
        }

        /* ─────────────────────────────────────────────────────────────────────
           NAV
        ───────────────────────────────────────────────────────────────────── */
        nav {
            position: sticky;
            top: 0;
            z-index: 200;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 68px;
            padding: 0 48px;
            background: rgba(4, 12, 24, 0.75);
            backdrop-filter: blur(20px) saturate(1.4);
            -webkit-backdrop-filter: blur(20px) saturate(1.4);
            border-bottom: 1px solid var(--c-border);
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 11px;
            text-decoration: none;
            flex-shrink: 0;
        }

        .nav-brand img {
            height: 40px;
            width: auto;
            transition: opacity 0.2s;
        }

        .nav-brand:hover img { opacity: 0.85; }

        .nav-wordmark {
            font-family: 'Inter', sans-serif;
            font-size: 17px;
            font-weight: 800;
            color: var(--c-text);
            letter-spacing: -0.02em;
        }

        .nav-wordmark b {
            font-weight: 800;
            color: var(--c-blue-light);
        }

        .nav-menu {
            display: flex;
            align-items: center;
            gap: 36px;
            list-style: none;
        }

        .nav-menu a {
            font-size: 13px;
            font-weight: 400;
            color: var(--c-text-2);
            text-decoration: none;
            letter-spacing: 0.01em;
            transition: color 0.18s;
            position: relative;
        }

        .nav-menu a::after {
            content: '';
            position: absolute;
            bottom: -3px;
            left: 0; right: 0;
            height: 1px;
            background: var(--c-blue-light);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.25s var(--ease-out-expo);
        }

        .nav-menu a:hover { color: var(--c-text); }
        .nav-menu a:hover::after { transform: scaleX(1); }

        .nav-cta {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-ghost {
            display: inline-flex;
            align-items: center;
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.04em;
            padding: 8px 18px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--c-border-md);
            background: transparent;
            color: var(--c-text-2);
            text-decoration: none;
            transition: color 0.2s, border-color 0.2s, background 0.2s;
        }

        .btn-ghost:hover {
            color: var(--c-text);
            border-color: var(--c-border-hi);
            background: rgba(59,130,246,0.05);
        }

        .btn-solid {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.04em;
            padding: 9px 20px;
            border-radius: var(--radius-sm);
            border: none;
            background: var(--c-blue);
            color: #fff;
            text-decoration: none;
            cursor: pointer;
            transition: background 0.2s, transform 0.15s var(--ease-out-expo), box-shadow 0.2s;
            box-shadow: 0 1px 12px rgba(59,130,246,0.30), inset 0 1px 0 rgba(255,255,255,0.12);
        }

        .btn-solid:hover {
            background: var(--c-blue-dark);
            transform: translateY(-1px);
            box-shadow: 0 4px 20px rgba(59,130,246,0.40), inset 0 1px 0 rgba(255,255,255,0.12);
        }

        .btn-solid:active { transform: translateY(0); }

        /* ─────────────────────────────────────────────────────────────────────
           HERO
        ───────────────────────────────────────────────────────────────────── */
        .hero {
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            min-height: calc(100svh - 68px);
            padding: 96px 24px 72px;
            gap: 0;
        }

        .hero-eyebrow {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 32px;
            animation: slide-up 0.7s var(--ease-out-expo) both;
        }

        .hero-eyebrow-line {
            width: 32px;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--c-blue-light));
        }

        .hero-eyebrow-text {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--c-blue-light);
        }

        .hero-eyebrow-line-r {
            width: 32px;
            height: 1px;
            background: linear-gradient(90deg, var(--c-blue-light), transparent);
        }

        .hero-title {
            font-family: 'Inter', sans-serif;
            font-size: clamp(44px, 8.5vw, 88px);
            font-weight: 800;
            line-height: 0.96;
            letter-spacing: -0.03em;
            color: var(--c-text);
            max-width: 860px;
            margin-bottom: 28px;
            animation: slide-up 0.75s 0.08s var(--ease-out-expo) both;
        }

        .hero-title .hi {
            background: linear-gradient(135deg, var(--c-blue-light) 0%, #93c5fd 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-sub {
            font-size: clamp(15px, 2vw, 17px);
            font-weight: 400;
            color: var(--c-text-2);
            line-height: 1.65;
            max-width: 480px;
            margin-bottom: 48px;
            animation: slide-up 0.75s 0.16s var(--ease-out-expo) both;
        }

        .hero-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 80px;
            flex-wrap: wrap;
            justify-content: center;
            animation: slide-up 0.75s 0.24s var(--ease-out-expo) both;
        }

        .btn-cta-primary {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 0.01em;
            padding: 16px 36px;
            border-radius: var(--radius-md);
            border: none;
            background: linear-gradient(135deg, var(--c-blue) 0%, #2563eb 100%);
            color: #fff;
            text-decoration: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            transition: transform 0.2s var(--ease-out-expo), box-shadow 0.2s;
            box-shadow:
                0 4px 24px rgba(59,130,246,0.40),
                0 1px 0 rgba(255,255,255,0.12) inset,
                0 -1px 0 rgba(0,0,0,0.16) inset;
        }

        .btn-cta-primary::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, transparent 50%);
            pointer-events: none;
        }

        .btn-cta-primary:hover {
            transform: translateY(-2px);
            box-shadow:
                0 8px 36px rgba(59,130,246,0.50),
                0 1px 0 rgba(255,255,255,0.14) inset;
        }

        .btn-cta-primary:active { transform: translateY(0); }

        .btn-cta-primary svg { width: 16px; height: 16px; flex-shrink: 0; }

        .btn-cta-ghost {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 0.01em;
            padding: 16px 28px;
            border-radius: var(--radius-md);
            border: 1px solid var(--c-border-md);
            background: rgba(255,255,255,0.025);
            color: var(--c-text-2);
            text-decoration: none;
            cursor: pointer;
            transition: color 0.2s, border-color 0.2s, background 0.2s, transform 0.2s var(--ease-out-expo);
        }

        .btn-cta-ghost:hover {
            color: var(--c-text);
            border-color: var(--c-border-hi);
            background: rgba(59,130,246,0.06);
            transform: translateY(-2px);
        }

        .btn-cta-ghost svg { width: 16px; height: 16px; flex-shrink: 0; }

        /* Trust strip */
        .trust {
            display: flex;
            align-items: center;
            animation: slide-up 0.75s 0.34s var(--ease-out-expo) both;
        }

        .trust-pill {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 11px 22px;
            border: 1px solid var(--c-border);
            background: var(--c-surface-1);
            transition: border-color 0.2s;
        }

        .trust-pill:first-child  { border-radius: var(--radius-md) 0 0 var(--radius-md); }
        .trust-pill:last-child   { border-radius: 0 var(--radius-md) var(--radius-md) 0; border-left: none; }
        .trust-pill:not(:first-child):not(:last-child) { border-left: none; }

        .trust-pill:hover { border-color: var(--c-border-md); }

        .trust-ico { display: flex; color: var(--c-blue-light); }
        .trust-ico svg { width: 14px; height: 14px; }

        .trust-copy { font-size: 12px; font-weight: 500; color: var(--c-text-2); white-space: nowrap; }
        .trust-copy strong { color: var(--c-text); font-weight: 600; }

        /* ─────────────────────────────────────────────────────────────────────
           MODULES
        ───────────────────────────────────────────────────────────────────── */
        .section {
            position: relative;
            z-index: 1;
        }

        .section-inner {
            max-width: 1140px;
            margin: 0 auto;
            padding: 0 40px;
        }

        .section-header { margin-bottom: 52px; }

        .eyebrow {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 14px;
        }

        .eyebrow-dot {
            width: 5px; height: 5px;
            border-radius: 50%;
            background: var(--c-blue-light);
            box-shadow: 0 0 8px var(--c-blue-light);
        }

        .eyebrow-text {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--c-blue-light);
        }

        .section-h {
            font-family: 'Inter', sans-serif;
            font-size: clamp(28px, 4vw, 42px);
            font-weight: 800;
            letter-spacing: -0.025em;
            line-height: 1.08;
            color: var(--c-text);
            margin-bottom: 14px;
        }

        .section-h .hi { color: var(--c-blue-light); }

        .section-p {
            font-size: 15px;
            color: var(--c-text-2);
            line-height: 1.7;
            max-width: 460px;
        }

        /* Modules grid */
        .modules {
            padding: 112px 0;
        }

        .mods-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }

        .mod {
            position: relative;
            background: var(--c-surface-2);
            border: 1px solid var(--c-border);
            border-radius: var(--radius-lg);
            padding: 30px 28px 26px;
            overflow: hidden;
            transition:
                border-color 0.25s,
                transform 0.25s var(--ease-out-expo),
                box-shadow 0.25s;
            cursor: default;
        }

        /* Top accent bar — animates in on hover */
        .mod::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--mod-color, var(--c-blue-light)), transparent);
            opacity: 0;
            transition: opacity 0.3s;
        }

        /* Subtle radial glow behind icon on hover */
        .mod::after {
            content: '';
            position: absolute;
            top: 10px; left: 10px;
            width: 160px; height: 160px;
            border-radius: 50%;
            background: radial-gradient(circle, var(--mod-glow, rgba(59,130,246,0.08)) 0%, transparent 70%);
            opacity: 0;
            transition: opacity 0.4s;
            pointer-events: none;
        }

        .mod:hover {
            border-color: var(--c-border-md);
            transform: translateY(-4px);
            box-shadow: 0 16px 48px rgba(0,0,0,0.32), 0 1px 0 var(--c-border-md) inset;
        }

        .mod:hover::before { opacity: 1; }
        .mod:hover::after  { opacity: 1; }

        .mod-icon {
            width: 42px; height: 42px;
            border-radius: 11px;
            display: flex; align-items: center; justify-content: center;
            margin-bottom: 20px;
            background: var(--mod-icon-bg, rgba(59,130,246,0.10));
            position: relative; z-index: 1;
            transition: transform 0.25s var(--ease-out-expo);
        }

        .mod:hover .mod-icon { transform: scale(1.08); }

        .mod-icon svg {
            width: 19px; height: 19px;
            color: var(--mod-color, var(--c-blue-light));
        }

        .mod-name {
            font-family: 'Inter', sans-serif;
            font-size: 15px; font-weight: 700;
            color: var(--c-text);
            margin-bottom: 8px;
            position: relative; z-index: 1;
        }

        .mod-desc {
            font-size: 13px;
            color: var(--c-text-2);
            line-height: 1.65;
            position: relative; z-index: 1;
        }

        .mod-tag {
            display: inline-block;
            margin-top: 18px;
            font-size: 11px; font-weight: 700;
            letter-spacing: 0.09em;
            text-transform: uppercase;
            padding: 4px 10px;
            border-radius: 100px;
            background: var(--mod-tag-bg, rgba(59,130,246,0.08));
            color: var(--mod-color, var(--c-blue-light));
            position: relative; z-index: 1;
        }

        /* Color themes */
        .mod-blue   {
            --mod-color:   #60a5fa;
            --mod-glow:    rgba(59,130,246,0.10);
            --mod-icon-bg: rgba(59,130,246,0.10);
            --mod-tag-bg:  rgba(59,130,246,0.07);
        }
        .mod-teal   {
            --mod-color:   #2dd4bf;
            --mod-glow:    rgba(45,212,191,0.10);
            --mod-icon-bg: rgba(45,212,191,0.09);
            --mod-tag-bg:  rgba(45,212,191,0.07);
        }
        .mod-gold   {
            --mod-color:   #d4a847;
            --mod-glow:    rgba(212,168,71,0.10);
            --mod-icon-bg: rgba(212,168,71,0.09);
            --mod-tag-bg:  rgba(212,168,71,0.07);
        }
        .mod-purple {
            --mod-color:   #a78bfa;
            --mod-glow:    rgba(167,139,250,0.10);
            --mod-icon-bg: rgba(167,139,250,0.09);
            --mod-tag-bg:  rgba(167,139,250,0.07);
        }
        .mod-rose   {
            --mod-color:   #fb7185;
            --mod-glow:    rgba(251,113,133,0.10);
            --mod-icon-bg: rgba(251,113,133,0.09);
            --mod-tag-bg:  rgba(251,113,133,0.07);
        }
        .mod-green  {
            --mod-color:   #4ade80;
            --mod-glow:    rgba(74,222,128,0.10);
            --mod-icon-bg: rgba(74,222,128,0.09);
            --mod-tag-bg:  rgba(74,222,128,0.07);
        }

        /* ─────────────────────────────────────────────────────────────────────
           WHY ATLAS
        ───────────────────────────────────────────────────────────────────── */
        .why {
            padding: 112px 0;
            background: var(--c-surface-1);
            border-top: 1px solid var(--c-border);
            border-bottom: 1px solid var(--c-border);
        }

        .why-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-top: 52px;
        }

        .why-card {
            padding: 34px 30px;
            background: var(--c-surface-2);
            border: 1px solid var(--c-border);
            border-radius: var(--radius-lg);
            transition: border-color 0.22s, transform 0.22s var(--ease-out-expo);
        }

        .why-card:hover {
            border-color: var(--c-border-md);
            transform: translateY(-3px);
        }

        .why-num {
            font-family: 'Inter', sans-serif;
            font-size: 56px;
            font-weight: 800;
            letter-spacing: -0.06em;
            line-height: 1;
            color: transparent;
            -webkit-text-stroke: 1px var(--c-border-md);
            margin-bottom: 20px;
        }

        .why-title {
            font-family: 'Inter', sans-serif;
            font-size: 17px; font-weight: 700;
            color: var(--c-text);
            margin-bottom: 12px;
            line-height: 1.2;
        }

        .why-desc {
            font-size: 13px;
            color: var(--c-text-2);
            line-height: 1.7;
        }

        /* ─────────────────────────────────────────────────────────────────────
           SECURITY
        ───────────────────────────────────────────────────────────────────── */
        .security {
            padding: 112px 0;
        }

        .security-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 72px;
            align-items: center;
        }

        .sec-feats {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 36px;
        }

        .sec-feat {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            padding: 18px 20px;
            background: var(--c-surface-2);
            border: 1px solid var(--c-border);
            border-radius: var(--radius-md);
            transition: border-color 0.2s, transform 0.2s var(--ease-out-expo);
        }

        .sec-feat:hover {
            border-color: var(--c-border-md);
            transform: translateX(4px);
        }

        .sec-feat-ico {
            width: 36px; height: 36px;
            border-radius: 9px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
        }

        .sec-feat-ico svg { width: 16px; height: 16px; }

        .sec-feat-title {
            font-size: 13px; font-weight: 600;
            color: var(--c-text);
            margin-bottom: 4px; line-height: 1.3;
        }

        .sec-feat-desc {
            font-size: 12px;
            color: var(--c-text-2);
            line-height: 1.55;
        }

        /* Badge mosaic */
        .sec-mosaic {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .sec-tile {
            padding: 26px 22px;
            background: var(--c-surface-2);
            border: 1px solid var(--c-border);
            border-radius: var(--radius-lg);
            text-align: center;
            transition: border-color 0.22s, transform 0.22s var(--ease-out-expo);
        }

        .sec-tile:hover {
            border-color: var(--c-border-md);
            transform: translateY(-3px);
        }

        .sec-tile-val {
            font-family: 'Inter', sans-serif;
            font-size: 26px; font-weight: 800;
            letter-spacing: -0.03em;
            margin-bottom: 5px;
            line-height: 1;
        }

        .sec-tile-lbl {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.09em;
            text-transform: uppercase;
            color: var(--c-text-3);
        }

        .sec-tile.span2 { grid-column: span 2; }

        .sec-tile.span2 .sec-tile-val {
            font-size: 15px;
            letter-spacing: 0.04em;
            color: var(--c-text-2);
        }

        /* ─────────────────────────────────────────────────────────────────────
           CTA FINAL
        ───────────────────────────────────────────────────────────────────── */
        .cta-section { padding: 56px 0 112px; }

        .cta-box {
            max-width: 960px;
            margin: 0 auto;
            position: relative;
            overflow: hidden;
            border-radius: var(--radius-xl);
            border: 1px solid rgba(59,130,246,0.22);
            background: linear-gradient(160deg, #0a1f3d 0%, #07152c 55%, #0a1c36 100%);
            padding: 80px 60px;
            text-align: center;
        }

        /* Top shimmer line */
        .cta-box::before {
            content: '';
            position: absolute;
            top: 0; left: 10%; right: 10%;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(96,165,250,0.70), transparent);
        }

        /* Radial glows inside */
        .cta-box::after {
            content: '';
            position: absolute;
            top: -80px; left: 50%;
            transform: translateX(-50%);
            width: 500px; height: 260px;
            background: radial-gradient(ellipse at center, rgba(59,130,246,0.12) 0%, transparent 70%);
            pointer-events: none;
        }

        .cta-title {
            font-family: 'Inter', sans-serif;
            font-size: clamp(28px, 4.5vw, 46px);
            font-weight: 800;
            letter-spacing: -0.025em;
            line-height: 1.08;
            color: var(--c-text);
            margin-bottom: 18px;
            position: relative; z-index: 1;
        }

        .cta-title .hi {
            background: linear-gradient(135deg, var(--c-blue-light), #93c5fd);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .cta-sub {
            font-size: 15px;
            color: var(--c-text-2);
            line-height: 1.65;
            max-width: 400px;
            margin: 0 auto 40px;
            position: relative; z-index: 1;
        }

        .cta-btns {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
            position: relative; z-index: 1;
        }

        /* ─────────────────────────────────────────────────────────────────────
           FOOTER
        ───────────────────────────────────────────────────────────────────── */
        footer {
            position: relative; z-index: 1;
            border-top: 1px solid var(--c-border);
            padding: 28px 48px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
        }

        .footer-brand {
            font-family: 'Inter', sans-serif;
            font-size: 14px; font-weight: 800;
            letter-spacing: -0.02em;
            color: var(--c-text-3);
        }

        .footer-brand b { color: var(--c-blue-light); }

        .footer-copy {
            font-size: 12px;
            color: var(--c-text-3);
        }

        .footer-nav {
            display: flex;
            gap: 24px;
        }

        .footer-nav a {
            font-size: 12px;
            color: var(--c-text-3);
            text-decoration: none;
            transition: color 0.18s;
        }

        .footer-nav a:hover { color: var(--c-text-2); }

        /* ─────────────────────────────────────────────────────────────────────
           SCROLL REVEAL
        ───────────────────────────────────────────────────────────────────── */
        .reveal {
            opacity: 0;
            transform: translateY(28px);
            transition:
                opacity 0.65s var(--ease-out-expo),
                transform 0.65s var(--ease-out-expo);
        }

        .reveal.in { opacity: 1; transform: translateY(0); }
        .reveal.delay-1 { transition-delay: 0.10s; }
        .reveal.delay-2 { transition-delay: 0.20s; }
        .reveal.delay-3 { transition-delay: 0.30s; }

        /* ─────────────────────────────────────────────────────────────────────
           ANIMATIONS
        ───────────────────────────────────────────────────────────────────── */
        @@keyframes slide-up {
            from { opacity: 0; transform: translateY(22px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        @@keyframes pulse-dot {
            0%, 100% { opacity: 1; box-shadow: 0 0 6px var(--c-blue-light); }
            50%       { opacity: 0.35; box-shadow: none; }
        }

        /* ─────────────────────────────────────────────────────────────────────
           RESPONSIVE
        ───────────────────────────────────────────────────────────────────── */
        @@media (max-width: 1024px) {
            .mods-grid  { grid-template-columns: repeat(2, 1fr); }
            .why-grid   { grid-template-columns: 1fr 1fr; }
            .security-layout { grid-template-columns: 1fr; gap: 48px; }
            .sec-mosaic { grid-template-columns: repeat(4, 1fr); }
            .sec-tile.span2 { grid-column: span 4; }
        }

        @@media (max-width: 768px) {
            nav { padding: 0 20px; }
            .nav-menu { display: none; }

            .section-inner { padding: 0 20px; }

            .hero { padding: 64px 20px 48px; }
            .hero-actions { flex-direction: column; width: 100%; max-width: 300px; }
            .btn-cta-primary, .btn-cta-ghost { justify-content: center; width: 100%; }

            .trust { flex-direction: column; width: 100%; max-width: 320px; }
            .trust-pill {
                width: 100%; border-radius: 0 !important;
                border-left: 1px solid var(--c-border) !important;
                border-top: none;
            }
            .trust-pill:first-child { border-radius: var(--radius-md) var(--radius-md) 0 0 !important; border-top: 1px solid var(--c-border) !important; }
            .trust-pill:last-child  { border-radius: 0 0 var(--radius-md) var(--radius-md) !important; }

            .modules, .security, .cta-section { padding: 72px 0; }
            .why { padding: 72px 0; }

            .mods-grid  { grid-template-columns: 1fr; }
            .why-grid   { grid-template-columns: 1fr; }
            .sec-mosaic { grid-template-columns: 1fr 1fr; }
            .sec-tile.span2 { grid-column: span 2; }

            .cta-box { padding: 48px 24px; }
            .cta-btns { flex-direction: column; align-items: center; }
            .cta-btns .btn-cta-primary,
            .cta-btns .btn-cta-ghost { width: 100%; max-width: 280px; justify-content: center; }

            footer {
                flex-direction: column;
                align-items: center;
                text-align: center;
                padding: 28px 20px;
            }
        }

        @@media (max-width: 480px) {
            .hero-title { letter-spacing: -0.03em; }
        }
    </style>
</head>
<body>

