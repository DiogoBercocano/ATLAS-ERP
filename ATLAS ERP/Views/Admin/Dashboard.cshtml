@using ATLAS_ERP.Helpers
@{
    ViewBag.Title = "Dashboard - Atlas ERP";

    var vendas = ViewBag.UltimasVendas as List<ATLAS_ERP.Models.Venda>;
    decimal totalHoje = ViewBag.VendasHoje ?? 0;
    int totalProd = ViewBag.TotalProdutos ?? 0;
    int totalCli = ViewBag.TotalClientes ?? 0;
    int totalVendDia = ViewBag.TotalVendasDia ?? 0;
}

@section bgGlows {
    <div class="bg-glow-1"></div>
    <div class="bg-glow-2"></div>
}

@section styles {
<style>
    .bg-glow-1 { position:absolute; width:500px; height:500px; top:-120px; right:10%; background:rgba(30,60,130,0.20); border-radius:50%; filter:blur(90px); }
    .bg-glow-2 { position:absolute; width:300px; height:300px; bottom:-60px; left:var(--sidebar-w); background:rgba(15,40,100,0.18); border-radius:50%; filter:blur(70px); }

    .main { padding:32px 36px; position:relative; z-index:1; }
    .topbar { display:flex; align-items:center; justify-content:space-between; margin-bottom:32px; }
    .page-title { font-family:'Syne',sans-serif; font-size:22px; font-weight:700; }
    .page-subtitle { font-size:13px; color:var(--muted); margin-top:2px; }
    .topbar-right { display:flex; align-items:center; gap:12px; }
    .date-badge { font-size:12px; color:var(--muted); background:var(--card); border:1px solid var(--border); padding:7px 14px; border-radius:8px; }
    .btn-logout { display:flex; align-items:center; gap:7px; text-decoration:none; font-size:13px; font-weight:500; color:var(--red); background:var(--red-soft); border:1px solid rgba(248,113,113,0.18); padding:8px 14px; border-radius:8px; transition:background .18s; }
    .btn-logout:hover { background:rgba(248,113,113,0.18); }
    .btn-logout svg { width:14px; height:14px; }

    .metrics-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:24px; animation:fadeUp .5s ease both; }
    .metric-card { background:var(--card); border:1px solid var(--border); border-radius:var(--radius); padding:20px 22px; position:relative; overflow:hidden; transition:border-color .2s, transform .2s; cursor:default; }
    .metric-card:hover { border-color:var(--border-md); transform:translateY(-2px); }
    .metric-card::before { content:''; position:absolute; top:0; left:0; right:0; height:2px; }
    .metric-card.blue::before { background:var(--accent); }
    .metric-card.gold::before { background:var(--gold); }
    .metric-card.green::before { background:var(--green); }
    .metric-card.red::before { background:var(--red); }
    .metric-icon { width:34px; height:34px; border-radius:9px; display:flex; align-items:center; justify-content:center; margin-bottom:14px; }
    .metric-icon svg { width:16px; height:16px; }
    .metric-icon.blue { background:var(--accent-soft); color:var(--accent-light); }
    .metric-icon.gold { background:var(--gold-soft); color:var(--gold); }
    .metric-icon.green { background:var(--green-soft); color:var(--green); }
    .metric-icon.red { background:var(--red-soft); color:var(--red); }
    .metric-label { font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; margin-bottom:6px; }
    .metric-value { font-family:'Syne',sans-serif; font-size:26px; font-weight:700; color:var(--text); line-height:1; }
    .metric-sub { font-size:11px; color:var(--faint); margin-top:6px; }

    .bottom-grid { display:grid; grid-template-columns:1fr 280px; gap:18px; animation:fadeUp .6s ease .1s both; }

    thead th { font-size:11px; color:var(--faint); text-transform:uppercase; letter-spacing:.07em; font-weight:500; padding:10px 22px; text-align:left; background:rgba(0,0,0,0.15); }
    tbody tr { border-top:1px solid var(--border); transition:background .15s; }
    tbody tr:hover { background:var(--card-hover); }
    tbody td { padding:13px 22px; font-size:14px; }
    .td-muted { color:var(--muted); font-size:13px; }
    .status-badge { display:inline-flex; align-items:center; gap:5px; font-size:12px; padding:3px 10px; border-radius:20px; }
    .status-badge.pago { background:var(--green-soft); color:var(--green); }
    .status-badge.pendente { background:var(--gold-soft); color:var(--gold); }
    .status-badge.cancelado { background:var(--red-soft); color:var(--red); }
    .status-dot { width:5px; height:5px; border-radius:50%; background:currentColor; }

    .side-col { display:flex; flex-direction:column; gap:14px; }
    .quick-card { background:var(--card); border:1px solid var(--border); border-radius:var(--radius); padding:18px; }
    .quick-title { font-family:'Syne',sans-serif; font-size:13px; font-weight:700; margin-bottom:12px; }
    .quick-item { display:flex; align-items:center; gap:10px; text-decoration:none; color:var(--muted); font-size:13px; padding:9px 10px; border-radius:8px; transition:background .15s, color .15s; margin-bottom:2px; }
    .quick-item svg { width:15px; height:15px; flex-shrink:0; }
    .quick-item:hover { background:var(--card-hover); color:var(--text); }
    .alert-card { background:var(--gold-soft); border:1px solid rgba(201,168,76,.20); border-radius:var(--radius); padding:16px; font-size:13px; color:var(--gold); display:flex; gap:10px; align-items:flex-start; line-height:1.5; }
    .alert-card svg { width:15px; height:15px; flex-shrink:0; margin-top:2px; }

    @@media (max-width:1100px) { .metrics-grid { grid-template-columns:repeat(2,1fr); } }
    @@media (max-width:900px)  { .bottom-grid { grid-template-columns:1fr; } }
    @@media (max-width:700px)  { .metrics-grid { grid-template-columns:1fr; } }
</style>
}

<main class="main">

    <div class="topbar">
        <div>
            <div class="page-title">Dashboard</div>
            <div class="page-subtitle">Visão geral do sistema</div>
        </div>
        <div class="topbar-right">
            <span class="date-badge" id="dataAtual"></span>
            <a href="/Auth/Logout" class="btn-logout">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Sair
            </a>
        </div>
    </div>

    @if (ViewBag.UploadAviso != null)
    {
        <div style="display:flex;align-items:center;gap:10px;background:rgba(201,168,76,.12);border:1px solid rgba(201,168,76,.25);border-radius:10px;padding:12px 18px;margin-bottom:20px;font-size:13px;color:var(--gold);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:15px;height:15px;flex-shrink:0;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            @ViewBag.UploadAviso
        </div>
    }
    @if (ViewBag.ConfigErro != null)
    {
        <div style="display:flex;align-items:center;gap:10px;background:rgba(248,113,113,.10);border:1px solid rgba(248,113,113,.22);border-radius:10px;padding:12px 18px;margin-bottom:20px;font-size:13px;color:var(--red);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:15px;height:15px;flex-shrink:0;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            @ViewBag.ConfigErro
        </div>
    }

    <!-- METRICAS -->
    <div class="metrics-grid">
        <div class="metric-card blue">
            <div class="metric-icon blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="1" x2="12" y2="23" />
                    <path d="M17 5H9.5a3.5 3.5 0 1 0 0 7h5a3.5 3.5 0 1 1 0 7H6" />
                </svg>
            </div>
            <div class="metric-label">Vendas Hoje</div>
            <div class="metric-value">R$ @totalHoje.ToString("N2")</div>
            <div class="metric-sub">@totalVendDia venda(s) realizadas</div>
        </div>

        <div class="metric-card gold">
            <div class="metric-icon gold">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                </svg>
            </div>
            <div class="metric-label">Produtos Cadastrados</div>
            <div class="metric-value">@totalProd</div>
            <div class="metric-sub">no catálogo ativo</div>
        </div>

        <div class="metric-card green">
            <div class="metric-icon green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
            </div>
            <div class="metric-label">Clientes Ativos</div>
            <div class="metric-value">@totalCli</div>
            <div class="metric-sub">cadastrados no sistema</div>
        </div>

        <div class="metric-card red">
            <div class="metric-icon red">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
                </svg>
            </div>
            <div class="metric-label">Pedidos Hoje</div>
            <div class="metric-value">@totalVendDia</div>
            <div class="metric-sub">ordens processadas</div>
        </div>
    </div>

    <!-- TABELA + LATERAL -->
    <div class="bottom-grid">
        <div class="table-card">
            <div class="table-header">
                <span class="table-title">Últimas Vendas</span>
                <span class="badge-pill">@(vendas != null ? vendas.Count : 0) registros</span>
            </div>

            @if (vendas != null && vendas.Any())
            {
                <table>
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Data</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in vendas)
                        {
                            var statusClass = v.Status?.ToLower() == "pago" ? "pago"
                                            : v.Status?.ToLower() == "cancelado" ? "cancelado"
                                            : "pendente";
                            <tr>
                                <td>@(v.Cliente != null ? v.Cliente.Nome : "—")</td>
                                <td>R$ @v.Total.ToString("N2")</td>
                                <td>
                                    <span class="status-badge @statusClass">
                                        <span class="status-dot"></span>
                                        @v.Status
                                    </span>
                                </td>
                                <td class="td-muted">@v.DataVenda.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">Nenhuma venda registrada ainda.</div>
            }
        </div>

        <div class="side-col">
            <div class="quick-card">
                <div class="quick-title">Atalhos Rápidos</div>
                <a href="/Produto/Create" class="quick-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="16" /><line x1="8" y1="12" x2="16" y2="12" /></svg>
                    Novo Produto
                </a>
                <a href="/Cliente/Create" class="quick-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="16" /><line x1="8" y1="12" x2="16" y2="12" /></svg>
                    Novo Cliente
                </a>
                <a href="/Usuario/Create" class="quick-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="22" y1="11" x2="16" y2="11" /></svg>
                    Novo Funcionário
                </a>
                <a href="/Produto" class="quick-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                    Ver Produtos
                </a>
                <a href="/Cliente" class="quick-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                    Ver Clientes
                </a>
            </div>

            <div class="alert-card">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                    <line x1="12" y1="9" x2="12" y2="13" />
                    <line x1="12" y1="17" x2="12.01" y2="17" />
                </svg>
                <span>Verifique produtos com estoque baixo antes de realizar novas vendas.</span>
            </div>
        </div>
    </div>

</main>

@section scripts {
<script nonce="@Html.CspNonce()">
    var d = new Date();
    var opts = { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric' };
    document.getElementById('dataAtual').textContent = d.toLocaleDateString('pt-BR', opts);
</script>
}
