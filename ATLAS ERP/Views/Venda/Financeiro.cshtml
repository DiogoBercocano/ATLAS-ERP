@model ATLAS_ERP.Services.ResumoFinanceiro
@{
    ViewBag.Title = "Financeiro - Atlas ERP";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Atlas ERP – Financeiro</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
        :root{--bg:#050d1a;--panel:#0b1525;--card:#0f1e35;--card-hover:#132540;--border:rgba(100,160,255,0.10);--border-md:rgba(100,160,255,0.18);--accent:#3b82f6;--accent-soft:rgba(59,130,246,0.12);--accent-light:#60a5fa;--green:#34d399;--green-soft:rgba(52,211,153,0.10);--gold:#c9a84c;--gold-soft:rgba(201,168,76,0.12);--red:#f87171;--red-soft:rgba(248,113,113,0.10);--text:#e8f0fe;--muted:#7a9cc8;--faint:#3d5270;--sidebar-w:320px;--radius:14px;}
        *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}html,body{height:100%;}
        body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);display:flex;min-height:100vh;}
        .bg-layer{position:fixed;inset:0;pointer-events:none;z-index:0;}
        .bg-dots{position:absolute;inset:0;background-image:radial-gradient(circle,rgba(59,130,246,.10) 1px,transparent 1px);background-size:36px 36px;mask-image:radial-gradient(ellipse 70% 70% at 60% 40%,black,transparent);}
        .sidebar{width:var(--sidebar-w);height:100vh;background:var(--panel);border-right:1px solid var(--border);position:fixed;top:0;left:0;display:flex;flex-direction:column;padding:28px 16px;z-index:100;}
        .sidebar-logo{display:flex;align-items:center;justify-content:center;margin-bottom:36px;}
        .sidebar-logo a{display:flex;align-items:center;justify-content:center;width:100%;}
        .sidebar-logo img{width:300px;max-width:100%;}
        .sidebar-divider{height:1px;background:var(--border);margin:8px 0 16px;}
        .menu-label{font-size:10px;font-weight:500;color:var(--faint);text-transform:uppercase;letter-spacing:.10em;padding:0 12px;margin-bottom:6px;}
        .menu-item{display:flex;align-items:center;gap:10px;color:var(--muted);text-decoration:none;font-size:14px;padding:10px 12px;border-radius:10px;margin-bottom:2px;transition:background .18s,color .18s;position:relative;}
        .menu-item svg{width:16px;height:16px;flex-shrink:0;opacity:.7;}
        .menu-item:hover{background:var(--card);color:var(--text);}
        .menu-item.active{background:var(--accent-soft);color:var(--accent-light);font-weight:500;}
        .menu-item.active::before{content:'';position:absolute;left:0;top:20%;bottom:20%;width:3px;background:var(--accent);border-radius:0 3px 3px 0;}
        .menu-item.danger{color:var(--red);}
        .menu-item.danger:hover{background:var(--red-soft);}
        .sidebar-spacer{flex:1;}
        .sidebar-user{display:flex;align-items:center;gap:10px;padding:12px;border-radius:10px;border:1px solid var(--border);background:var(--card);}
        .user-avatar{width:34px;height:34px;border-radius:50%;background:var(--accent-soft);border:1px solid var(--border-md);display:flex;align-items:center;justify-content:center;font-family:'Syne',sans-serif;font-size:13px;font-weight:700;color:var(--accent-light);flex-shrink:0;}
        .user-name{font-size:13px;font-weight:500;color:var(--text);}
        .user-role{font-size:11px;color:var(--faint);}
        .main{margin-left:var(--sidebar-w);flex:1;padding:32px 40px;position:relative;z-index:1;}
        .topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;}
        .page-title{font-family:'Syne',sans-serif;font-size:22px;font-weight:700;}
        .page-subtitle{font-size:13px;color:var(--muted);margin-top:2px;}
        .btn-back{display:inline-flex;align-items:center;gap:7px;color:var(--muted);text-decoration:none;font-size:13px;background:var(--card);border:1px solid var(--border);padding:9px 16px;border-radius:10px;transition:background .18s,color .18s;}
        .btn-back:hover{background:var(--card-hover);color:var(--text);}
        .btn-back svg{width:14px;height:14px;}
        /* métricas */
        .metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px;}
        .metric-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:20px 22px;position:relative;overflow:hidden;transition:border-color .2s;}
        .metric-card:hover{border-color:var(--border-md);}
        .metric-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;}
        .metric-card.blue::before{background:var(--accent);}
        .metric-card.green::before{background:var(--green);}
        .metric-card.gold::before{background:var(--gold);}
        .metric-card.red::before{background:var(--red);}
        .metric-label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px;}
        .metric-value{font-family:'Syne',sans-serif;font-size:24px;font-weight:700;}
        .metric-sub{font-size:12px;color:var(--faint);margin-top:4px;}
        /* grid inferior */
        .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;}
        .table-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;}
        .table-header{display:flex;align-items:center;justify-content:space-between;padding:16px 22px;border-bottom:1px solid var(--border);}
        .table-title{font-family:'Syne',sans-serif;font-size:14px;font-weight:700;}
        table{width:100%;border-collapse:collapse;}
        thead th{font-size:11px;color:var(--faint);text-transform:uppercase;letter-spacing:.06em;font-weight:500;padding:9px 16px;text-align:left;background:rgba(0,0,0,.15);}
        tbody tr{border-top:1px solid var(--border);transition:background .15s;}
        tbody tr:hover{background:var(--card-hover);}
        tbody td{padding:11px 16px;font-size:13px;}
        .td-muted{color:var(--muted);}
        .badge-pago{font-size:11px;background:var(--green-soft);color:var(--green);padding:2px 9px;border-radius:20px;}
        .badge-pendente{font-size:11px;background:var(--gold-soft);color:var(--gold);padding:2px 9px;border-radius:20px;}
        .badge-vencer{font-size:11px;background:var(--red-soft);color:var(--red);padding:2px 9px;border-radius:20px;}
        .empty-state{padding:40px;text-align:center;color:var(--faint);font-size:13px;}
        @@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
        @@media(max-width:1100px){.metrics{grid-template-columns:repeat(2,1fr)}}
        @@media(max-width:800px){.grid-2{grid-template-columns:1fr}.sidebar{display:none}.main{margin-left:0;padding:20px}}
    </style>
</head>
<body>
<div class="bg-layer"><div class="bg-dots"></div></div>

<aside class="sidebar">
    <div class="sidebar-logo">
        <a href="/Admin/Dashboard"><img src="~/Content/images/logos/atlas_erp_diamante.svg" alt="Atlas ERP" /></a>
    </div>
    <span class="menu-label">Principal</span>
    <a href="/Admin/Dashboard" class="menu-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>Dashboard</a>
    <a href="/Venda" class="menu-item active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>Vendas</a>
    <a href="/Produto" class="menu-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>Produtos</a>
    <a href="/Cliente" class="menu-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>Clientes</a>
    <a href="/Fornecedor" class="menu-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg>Fornecedores</a>
    <a href="/Usuario" class="menu-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>Funcionários</a>
    <div class="sidebar-divider"></div>
    <span class="menu-label">Sistema</span>
    <a href="/Auth/Logout" class="menu-item danger"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>Sair</a>
    <div class="sidebar-spacer"></div>
    <div class="sidebar-user">
        @{ var nm = Session["UsuarioLogado"]?.ToString() ?? "Usuário"; }
        <div class="user-avatar">@(nm.Length > 0 ? nm[0].ToString().ToUpper() : "U")</div>
        <div><div class="user-name">@nm</div><div class="user-role">@(Session["Role"]?.ToString())</div></div>
    </div>
</aside>

<main class="main">
    <div class="topbar">
        <div><div class="page-title">Financeiro</div><div class="page-subtitle">Resumo financeiro da empresa</div></div>
        <a href="/Venda" class="btn-back"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>Voltar</a>
    </div>

    <div class="metrics">
        <div class="metric-card blue">
            <div class="metric-label">Receita Total</div>
            <div class="metric-value">R$ @Model.ReceitaTotal.ToString("N2")</div>
            <div class="metric-sub">@Model.TotalVendas venda(s) concluída(s)</div>
        </div>
        <div class="metric-card green">
            <div class="metric-label">Receita deste Mês</div>
            <div class="metric-value">R$ @Model.ReceitaMes.ToString("N2")</div>
            <div class="metric-sub">@Model.VendasMes venda(s) no mês</div>
        </div>
        <div class="metric-card gold">
            <div class="metric-label">A Receber</div>
            <div class="metric-value">R$ @Model.ContasPendentes.ToString("N2")</div>
            <div class="metric-sub">Contas em aberto</div>
        </div>
        <div class="metric-card green" style="--green:#34d399;">
            <div class="metric-label">Total Recebido</div>
            <div class="metric-value">R$ @Model.ContasRecebidas.ToString("N2")</div>
            <div class="metric-sub">Contas pagas</div>
        </div>
    </div>

    <div class="grid-2">
        <!-- top produtos -->
        <div class="table-card">
            <div class="table-header"><span class="table-title">Top Produtos</span></div>
            @if (Model.TopProdutos != null && Model.TopProdutos.Count > 0)
            {
                <table>
                    <thead><tr><th>Produto</th><th>Qtd Vendida</th><th>Receita</th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.TopProdutos)
                        {
                            <tr>
                                <td><strong>@p.Nome</strong></td>
                                <td class="td-muted">@p.TotalVendido un.</td>
                                <td><strong>R$ @p.ReceitaGerada.ToString("N2")</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else { <div class="empty-state">Sem dados de vendas ainda.</div> }
        </div>

        <!-- contas a vencer -->
        <div class="table-card">
            <div class="table-header"><span class="table-title">Contas a Vencer (30 dias)</span></div>
            @if (Model.ContasVencer != null && Model.ContasVencer.Count > 0)
            {
                <table>
                    <thead><tr><th>Vencimento</th><th>Valor</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.ContasVencer)
                        {
                            var dias = (c.DataVencimento.Date - DateTime.Today).Days;
                            var badgeClass = dias <= 3 ? "badge-vencer" : "badge-pendente";
                            <tr>
                                <td>@c.DataVencimento.ToString("dd/MM/yyyy")</td>
                                <td><strong>R$ @c.Valor.ToString("N2")</strong></td>
                                <td><span class="@badgeClass">@(dias == 0 ? "Hoje" : dias < 0 ? "Vencida" : "Em " + dias + " dia(s)")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else { <div class="empty-state">Nenhuma conta a vencer nos próximos 30 dias.</div> }
        </div>
    </div>

    <!-- últimas vendas -->
    <div class="table-card">
        <div class="table-header"><span class="table-title">Últimas 10 Vendas</span></div>
        @if (Model.UltimasVendas != null && Model.UltimasVendas.Count > 0)
        {
            <table>
                <thead><tr><th>#</th><th>Data</th><th>Cliente</th><th>Total</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var v in Model.UltimasVendas)
                    {
                        <tr>
                            <td class="td-muted">#@v.VendaId</td>
                            <td class="td-muted">@v.DataVenda.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><strong>@v.Cliente</strong></td>
                            <td><strong>R$ @v.Total.ToString("N2")</strong></td>
                            <td>
                                <span class="@(v.Status?.ToLower() == "concluida" ? "badge-pago" : "badge-pendente")">@v.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else { <div class="empty-state">Nenhuma venda registrada ainda.</div> }
    </div>
</main>
</body>
</html>
