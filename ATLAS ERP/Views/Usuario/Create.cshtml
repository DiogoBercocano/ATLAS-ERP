@model ATLAS_ERP.Models.Usuario
@{
    ViewBag.Title = "Novo Funcionário - Atlas ERP";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Atlas ERP – Novo Funcionário</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg: #050d1a;
            --panel: #0b1525;
            --card: #0f1e35;
            --card-hover: #132540;
            --border: rgba(100,160,255,0.10);
            --border-md: rgba(100,160,255,0.18);
            --accent: #3b82f6;
            --accent-soft: rgba(59,130,246,0.12);
            --accent-glow: rgba(59,130,246,0.20);
            --accent-light: #60a5fa;
            --gold: #c9a84c;
            --gold-soft: rgba(201,168,76,0.12);
            --green: #34d399;
            --green-soft: rgba(52,211,153,0.12);
            --purple: #a78bfa;
            --purple-soft: rgba(167,139,250,0.12);
            --red: #f87171;
            --red-soft: rgba(248,113,113,0.10);
            --text: #e8f0fe;
            --muted: #7a9cc8;
            --faint: #3d5270;
            --sidebar-w: 320px;
            --radius: 14px;
        }

        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100%; }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg);
            color: var(--text);
            display: flex;
            min-height: 100vh;
        }

        /* BG */
        .bg-layer { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
        .bg-dots {
            position: absolute; inset: 0;
            background-image: radial-gradient(circle, rgba(59,130,246,0.10) 1px, transparent 1px);
            background-size: 36px 36px;
            mask-image: radial-gradient(ellipse 70% 70% at 60% 40%, black, transparent);
        }
        .bg-glow { position: absolute; border-radius: 50%; filter: blur(90px); }

        /* SIDEBAR */
        .sidebar {
            width: var(--sidebar-w);
            height: 100vh;
            background: var(--panel);
            border-right: 1px solid var(--border);
            position: fixed;
            top: 0; left: 0;
            display: flex;
            flex-direction: column;
            padding: 28px 16px;
            z-index: 100;
        }

        .sidebar-logo {
            display: flex; align-items: center; justify-content: center;
            padding: 0; margin-bottom: 36px;
        }
        .sidebar-logo a { display: flex; align-items: center; justify-content: center; width: 100%; }
        .sidebar-logo img { width: 300px; max-width: 100%; }

        .sidebar-divider { height: 1px; background: var(--border); margin: 8px 0 16px; }

        .menu-label {
            font-size: 10px; font-weight: 500; color: var(--faint);
            text-transform: uppercase; letter-spacing: 0.10em;
            padding: 0 12px; margin-bottom: 6px;
        }

        .menu-item {
            display: flex; align-items: center; gap: 10px;
            color: var(--muted); text-decoration: none; font-size: 14px;
            padding: 10px 12px; border-radius: 10px; margin-bottom: 2px;
            transition: background 0.18s, color 0.18s; position: relative;
        }
        .menu-item svg { width: 16px; height: 16px; flex-shrink: 0; opacity: 0.7; }
        .menu-item:hover { background: var(--card); color: var(--text); }
        .menu-item:hover svg { opacity: 1; }
        .menu-item.active { background: var(--accent-soft); color: var(--accent-light); font-weight: 500; }
        .menu-item.active svg { opacity: 1; }
        .menu-item.active::before {
            content: ''; position: absolute; left: 0; top: 20%; bottom: 20%;
            width: 3px; background: var(--accent); border-radius: 0 3px 3px 0;
        }
        .menu-item.danger { color: var(--red); }
        .menu-item.danger:hover { background: var(--red-soft); }

        .sidebar-spacer { flex: 1; }

        .sidebar-user {
            display: flex; align-items: center; gap: 10px;
            padding: 12px; border-radius: 10px;
            border: 1px solid var(--border); background: var(--card);
        }

        .user-avatar {
            width: 34px; height: 34px; border-radius: 50%;
            background: var(--accent-soft); border: 1px solid var(--border-md);
            display: flex; align-items: center; justify-content: center;
            font-family: 'Syne', sans-serif; font-size: 13px; font-weight: 700;
            color: var(--accent-light); flex-shrink: 0;
        }

        .user-name { font-size: 13px; font-weight: 500; color: var(--text); }
        .user-role { font-size: 11px; color: var(--faint); }

        /* MAIN */
        .main {
            margin-left: var(--sidebar-w);
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            position: relative;
            z-index: 1;
        }

        /* PAGE HEADER */
        .page-header {
            position: sticky; top: 0; z-index: 50;
            background: rgba(5,13,26,0.92);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
            padding: 16px 36px;
            display: flex; align-items: center; justify-content: space-between;
        }

        .breadcrumb {
            display: flex; align-items: center; gap: 6px;
            font-size: 12px; color: var(--faint);
        }
        .breadcrumb a { color: var(--faint); text-decoration: none; transition: color 0.15s; }
        .breadcrumb a:hover { color: var(--muted); }
        .breadcrumb-sep { opacity: 0.5; }
        .breadcrumb-current { color: var(--muted); }

        .page-title-block { margin-top: 4px; }
        .page-title {
            font-family: 'Syne', sans-serif;
            font-size: 20px; font-weight: 700;
        }

        .btn-back {
            display: inline-flex; align-items: center; gap: 7px;
            color: var(--muted); text-decoration: none; font-size: 13px;
            background: var(--card); border: 1px solid var(--border);
            padding: 9px 16px; border-radius: 10px;
            transition: background 0.18s, color 0.18s;
        }
        .btn-back:hover { background: var(--card-hover); color: var(--text); }
        .btn-back svg { width: 14px; height: 14px; }

        /* CONTENT */
        .content-wrap {
            flex: 1;
            padding: 32px 36px;
            display: flex;
            gap: 28px;
            align-items: flex-start;
        }

        /* FORM AREA */
        .form-area { flex: 1; min-width: 0; }

        /* SECTIONS */
        .section-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 28px 32px;
            margin-bottom: 20px;
            animation: fadeUp 0.45s ease both;
        }
        .section-card:nth-child(2) { animation-delay: 0.06s; }

        .section-head {
            display: flex; align-items: flex-start; gap: 14px;
            margin-bottom: 24px;
        }
        .section-num {
            width: 28px; height: 28px; border-radius: 8px;
            background: var(--accent-soft); border: 1px solid rgba(59,130,246,0.25);
            display: flex; align-items: center; justify-content: center;
            font-family: 'Syne', sans-serif; font-size: 12px; font-weight: 700;
            color: var(--accent-light); flex-shrink: 0; margin-top: 1px;
        }
        .section-info {}
        .section-title {
            font-family: 'Syne', sans-serif;
            font-size: 14px; font-weight: 700; color: var(--text);
            margin-bottom: 2px;
        }
        .section-desc { font-size: 12px; color: var(--faint); }

        .form-group { margin-bottom: 20px; }
        .form-group:last-child { margin-bottom: 0; }

        .form-label {
            display: block; font-size: 11px; font-weight: 500;
            color: var(--muted); margin-bottom: 7px;
            text-transform: uppercase; letter-spacing: 0.06em;
        }
        .form-label span { color: var(--red); margin-left: 2px; }

        .input-wrapper { position: relative; }
        .input-icon {
            position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
            color: var(--faint); pointer-events: none; display: flex;
        }
        .input-icon svg { width: 15px; height: 15px; }

        .form-control {
            width: 100%; height: 46px;
            background: var(--panel); border: 1px solid var(--border);
            border-radius: 10px; padding: 0 14px 0 42px;
            font-family: 'DM Sans', sans-serif; font-size: 14px; color: var(--text);
            outline: none; transition: border-color 0.2s, box-shadow 0.2s;
            -webkit-appearance: none;
        }
        .form-control::placeholder { color: var(--faint); }
        .form-control:hover { border-color: var(--border-md); }
        .form-control:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); }
        select.form-control { padding-left: 42px; cursor: pointer; }

        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

        .field-error { font-size: 12px; color: var(--red); margin-top: 5px; }

        .validation-summary {
            background: var(--red-soft); border: 1px solid rgba(248,113,113,0.2);
            border-radius: 10px; padding: 12px 16px; margin-bottom: 20px;
            font-size: 13px; color: var(--red);
        }

        /* PASSWORD STRENGTH */
        .password-strength-bar {
            height: 3px; border-radius: 2px;
            background: var(--border); margin-top: 8px; overflow: hidden;
        }
        .password-strength-fill {
            height: 100%; border-radius: 2px;
            transition: width 0.3s, background 0.3s;
            width: 0%;
        }
        .strength-hint {
            font-size: 11px; color: var(--faint); margin-top: 4px;
        }

        /* ROLE BADGE */
        .role-desc {
            font-size: 11px; color: var(--faint); margin-top: 6px; line-height: 1.4;
        }

        /* PREVIEW SIDEBAR */
        .preview-aside {
            width: 300px; flex-shrink: 0;
            position: sticky; top: 84px;
        }

        .preview-card {
            background: var(--card); border: 1px solid var(--border);
            border-radius: var(--radius); overflow: hidden;
            animation: fadeUp 0.5s ease 0.1s both;
        }

        .preview-header {
            background: linear-gradient(135deg, rgba(59,130,246,0.15), rgba(167,139,250,0.10));
            border-bottom: 1px solid var(--border);
            padding: 24px; text-align: center;
        }

        .preview-avatar {
            width: 72px; height: 72px; border-radius: 50%;
            background: var(--accent-soft); border: 2px solid rgba(59,130,246,0.30);
            display: flex; align-items: center; justify-content: center;
            font-family: 'Syne', sans-serif; font-size: 28px; font-weight: 700;
            color: var(--accent-light); margin: 0 auto 14px;
            transition: all 0.3s;
        }
        .preview-name {
            font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 700;
            color: var(--text); margin-bottom: 4px; min-height: 22px;
        }
        .preview-email {
            font-size: 12px; color: var(--muted); min-height: 18px;
            word-break: break-all;
        }

        .preview-body { padding: 20px 24px; }

        .preview-row {
            display: flex; align-items: center; gap: 10px;
            padding: 9px 0; border-bottom: 1px solid var(--border);
            font-size: 13px;
        }
        .preview-row:last-child { border-bottom: none; }
        .preview-row-icon { color: var(--faint); flex-shrink: 0; }
        .preview-row-icon svg { width: 14px; height: 14px; }
        .preview-row-label { font-size: 11px; color: var(--faint); min-width: 60px; }
        .preview-row-val { color: var(--text); font-weight: 500; flex: 1; }
        .preview-row-val.empty { color: var(--faint); font-style: italic; font-weight: 400; }

        .role-badge {
            display: inline-flex; align-items: center;
            padding: 3px 10px; border-radius: 20px;
            font-size: 11px; font-weight: 600;
            letter-spacing: 0.04em; text-transform: uppercase;
        }
        .role-badge.admin { background: var(--gold-soft); color: var(--gold); border: 1px solid rgba(201,168,76,0.2); }
        .role-badge.gerente { background: var(--purple-soft); color: var(--purple); border: 1px solid rgba(167,139,250,0.2); }
        .role-badge.funcionario { background: var(--accent-soft); color: var(--accent-light); border: 1px solid rgba(59,130,246,0.2); }
        .role-badge.empty-badge { background: var(--border); color: var(--faint); border: 1px solid transparent; font-style: italic; text-transform: none; }

        .preview-tip {
            background: rgba(59,130,246,0.06); border: 1px solid rgba(59,130,246,0.12);
            border-radius: 10px; padding: 14px 16px; margin-top: 14px;
            font-size: 12px; color: var(--faint); line-height: 1.5;
        }
        .preview-tip strong { color: var(--muted); }

        /* ACTION BAR */
        .action-bar {
            position: sticky; bottom: 0; z-index: 50;
            background: rgba(5,13,26,0.95);
            backdrop-filter: blur(12px);
            border-top: 1px solid var(--border);
            padding: 14px 36px;
            display: flex; align-items: center; justify-content: space-between;
        }

        .action-hint { font-size: 12px; color: var(--faint); }
        .action-hint span { color: var(--red); }

        .action-btns { display: flex; gap: 12px; }

        .btn-cancel {
            height: 44px; padding: 0 22px;
            background: none; border: 1px solid var(--border); border-radius: 10px;
            color: var(--muted); font-family: 'DM Sans', sans-serif; font-size: 14px;
            cursor: pointer; text-decoration: none;
            display: inline-flex; align-items: center;
            transition: background 0.18s, color 0.18s;
        }
        .btn-cancel:hover { background: var(--card-hover); color: var(--text); }

        .btn-submit {
            height: 44px; padding: 0 28px;
            background: var(--accent); border: none; border-radius: 10px;
            font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 600;
            color: white; cursor: pointer; letter-spacing: 0.02em;
            transition: background 0.2s, transform 0.15s;
            box-shadow: 0 4px 16px rgba(59,130,246,0.25);
            display: inline-flex; align-items: center; gap: 8px;
        }
        .btn-submit:hover { background: #2563eb; transform: translateY(-1px); }
        .btn-submit:active { transform: translateY(0); }
        .btn-submit svg { width: 15px; height: 15px; }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(18px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 1100px) { .preview-aside { display: none; } }
        @@media (max-width: 700px) {
            .sidebar { display: none; }
            .main { margin-left: 0; }
            .content-wrap { padding: 20px 16px; }
            .page-header { padding: 14px 16px; }
            .action-bar { padding: 12px 16px; }
            .form-row { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <div class="bg-layer">
        <div class="bg-dots"></div>
        <div class="bg-glow" style="width:420px;height:420px;top:-120px;right:4%;background:rgba(30,60,130,0.18);"></div>
        <div class="bg-glow" style="width:280px;height:280px;bottom:10%;left:30%;background:rgba(60,30,120,0.10);"></div>
    </div>

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="sidebar-logo">
            <a href="/Admin/Dashboard">
                <img src="~/Content/images/logos/atlas_erp_diamante.svg" alt="Atlas ERP" />
            </a>
        </div>

        <span class="menu-label">Principal</span>
        @{
            var cargoNome = Session["CargoNome"]?.ToString() ?? "";
        }

        <a href="/Admin/Dashboard" class="menu-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7" rx="1" />
                <rect x="14" y="3" width="7" height="7" rx="1" />
                <rect x="3" y="14" width="7" height="7" rx="1" />
                <rect x="14" y="14" width="7" height="7" rx="1" />
            </svg>
            Dashboard
        </a>

        <a href="/Venda" class="menu-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                <line x1="3" y1="6" x2="21" y2="6" />
                <path d="M16 10a4 4 0 0 1-8 0" />
            </svg>
            Vendas
        </a>

        <a href="/Produto" class="menu-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
            </svg>
            Produtos
        </a>

        <a href="/Cliente" class="menu-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
            Clientes
        </a>

        <a href="/Fornecedor" class="menu-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
            </svg>
            Fornecedores
        </a>

        <a href="/Usuario" class="menu-item active">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
                <line x1="19" y1="8" x2="19" y2="14" />
                <line x1="22" y1="11" x2="16" y2="11" />
            </svg>
            Funcionários
        </a>

        <a href="/Cargo" class="menu-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
            </svg>
            Cargos
        </a>

        <div class="sidebar-divider"></div>
        <span class="menu-label">Sistema</span>

        <button class="menu-item" onclick="abrirConfig()" style="background: none; border: none; cursor: pointer; width: 100%; text-align: left;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3" />
                <path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14" />
            </svg>
            Configurações
        </button>

        <a href="/Auth/Logout" class="menu-item danger">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
            </svg>
            Sair
        </a>

        <div class="sidebar-spacer"></div>

        <div class="sidebar-user">
            @{
                var nomeUsuario = Session["UsuarioLogado"]?.ToString() ?? "Usuário";
                var inicial = nomeUsuario.Length > 0 ? nomeUsuario[0].ToString().ToUpper() : "U";
            }
            <div class="user-avatar">@inicial</div>
            <div>
                <div class="user-name">@nomeUsuario</div>
                <div class="user-role">Administrador</div>
            </div>
        </div>
    </aside>

    <!-- MAIN -->
    <main class="main">

        <!-- PAGE HEADER -->
        <div class="page-header">
            <div>
                <div class="breadcrumb">
                    <a href="/Admin/Dashboard">Dashboard</a>
                    <span class="breadcrumb-sep">/</span>
                    <a href="/Usuario">Funcionários</a>
                    <span class="breadcrumb-sep">/</span>
                    <span class="breadcrumb-current">Novo</span>
                </div>
                <div class="page-title-block">
                    <div class="page-title">Novo Funcionário</div>
                </div>
            </div>
            <a href="/Usuario" class="btn-back">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15 18 9 12 15 6" />
                </svg>
                Voltar
            </a>
        </div>

        @using (Html.BeginForm("Create", "Usuario", FormMethod.Post, new { id = "formUsuario" }))
        {
            @Html.AntiForgeryToken()

            <!-- CONTENT -->
            <div class="content-wrap">

                <!-- FORM AREA -->
                <div class="form-area">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="validation-summary">
                            @Html.ValidationSummary(false)
                        </div>
                    }

                    <!-- SECTION 1 -->
                    <div class="section-card">
                        <div class="section-head">
                            <div class="section-num">1</div>
                            <div class="section-info">
                                <div class="section-title">Identificação</div>
                                <div class="section-desc">Nome e e-mail do funcionário</div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Nome completo <span>*</span></label>
                            <div class="input-wrapper">
                                @Html.TextBoxFor(m => m.Name, new {
                                    @class = "form-control",
                                    id = "nomeInput",
                                    placeholder = "Ex: João da Silva",
                                    autocomplete = "off"
                                })
                                <span class="input-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                        <circle cx="12" cy="7" r="4" />
                                    </svg>
                                </span>
                            </div>
                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "field-error" })
                        </div>

                        <div class="form-group">
                            <label class="form-label">E-mail <span>*</span></label>
                            <div class="input-wrapper">
                                @Html.TextBoxFor(m => m.Email, new {
                                    @class = "form-control",
                                    id = "emailInput",
                                    placeholder = "funcionario@empresa.com",
                                    type = "email"
                                })
                                <span class="input-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="2" y="4" width="20" height="16" rx="2" />
                                        <path d="m2 7 10 7L22 7" />
                                    </svg>
                                </span>
                            </div>
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-error" })
                        </div>
                    </div>

                    <!-- SECTION 2 -->
                    <div class="section-card">
                        <div class="section-head">
                            <div class="section-num">2</div>
                            <div class="section-info">
                                <div class="section-title">Acesso ao Sistema</div>
                                <div class="section-desc">Defina a senha e o nível de permissão</div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Senha <span>*</span></label>
                                <div class="input-wrapper">
                                    @Html.PasswordFor(m => m.SenhaHash, new {
                                        @class = "form-control",
                                        id = "senhaInput",
                                        placeholder = "••••••••"
                                    })
                                    <span class="input-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="11" width="18" height="11" rx="2" />
                                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                        </svg>
                                    </span>
                                </div>
                                <div class="password-strength-bar">
                                    <div class="password-strength-fill" id="strengthFill"></div>
                                </div>
                                <div class="strength-hint" id="strengthHint"></div>
                                @Html.ValidationMessageFor(m => m.SenhaHash, "", new { @class = "field-error" })
                            </div>

                            <div class="form-group">
                                <label class="form-label">Cargo <span>*</span></label>
                                <div class="input-wrapper">
                                    @{
                                        var cargos = ViewBag.Cargos as List<ATLAS_ERP.Models.Cargo> ?? new List<ATLAS_ERP.Models.Cargo>();
                                    }
                                    @Html.DropDownListFor(m => m.CargoId,
                                        new SelectList(cargos, "CargoId", "Nome"),
                                        "Selecione um cargo...",
                                        new { @class = "form-control", id = "cargoSelect" }
                                    )
                                    <span class="input-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2z" />
                                            <path d="M12 8v4l3 3" />
                                        </svg>
                                    </span>
                                </div>
                                @Html.ValidationMessageFor(m => m.CargoId, "", new { @class = "field-error" })
                            </div>
                        </div>
                    </div>

                </div>

                <!-- PREVIEW -->
                <aside class="preview-aside">
                    <div class="preview-card">
                        <div class="preview-header">
                            <div class="preview-avatar" id="prevAvatar">?</div>
                            <div class="preview-name" id="prevNome">Nome do funcionário</div>
                            <div class="preview-email" id="prevEmail">email@empresa.com</div>
                        </div>
                        <div class="preview-body">
                            <div class="preview-row">
                                <div class="preview-row-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2z" />
                                        <path d="M12 8v4l3 3" />
                                    </svg>
                                </div>
                                <div class="preview-row-label">Cargo</div>
                                <div class="preview-row-val" id="prevRole">
                                    <span class="role-badge empty-badge">não definido</span>
                                </div>
                            </div>
                            <div class="preview-row">
                                <div class="preview-row-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="11" width="18" height="11" rx="2" />
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                    </svg>
                                </div>
                                <div class="preview-row-label">Senha</div>
                                <div class="preview-row-val" id="prevSenha">
                                    <span class="empty">não definida</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="preview-tip">
                        <strong>Dica:</strong> O funcionário poderá alterar sua senha após o primeiro acesso. Escolha um cargo adequado às responsabilidades.
                    </div>
                </aside>

            </div>

            <!-- ACTION BAR -->
            <div class="action-bar">
                <div class="action-hint"><span>*</span> Campos obrigatórios</div>
                <div class="action-btns">
                    <a href="/Usuario" class="btn-cancel">Cancelar</a>
                    <button type="submit" class="btn-submit">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <line x1="19" y1="8" x2="19" y2="14" />
                            <line x1="22" y1="11" x2="16" y2="11" />
                        </svg>
                        Criar Funcionário
                    </button>
                </div>
            </div>
        }

    </main>

    <script>
        var nomeInput  = document.getElementById('nomeInput');
        var emailInput = document.getElementById('emailInput');
        var senhaInput = document.getElementById('senhaInput');
        var cargoSelect = document.getElementById('cargoSelect');

        var prevAvatar = document.getElementById('prevAvatar');
        var prevNome   = document.getElementById('prevNome');
        var prevEmail  = document.getElementById('prevEmail');
        var prevRole   = document.getElementById('prevRole');
        var prevSenha  = document.getElementById('prevSenha');
        var strengthFill = document.getElementById('strengthFill');
        var strengthHint = document.getElementById('strengthHint');

        function updatePreview() {
            // Avatar + nome
            var nome = nomeInput.value.trim();
            if (nome) {
                prevAvatar.textContent = nome.charAt(0).toUpperCase();
                prevAvatar.style.background = '';
                prevNome.textContent = nome;
                prevNome.classList.remove('empty');
            } else {
                prevAvatar.textContent = '?';
                prevAvatar.style.background = '';
                prevNome.innerHTML = 'Nome do funcion\u00e1rio';
                prevNome.classList.add('empty');
            }

            // Email
            var email = emailInput.value.trim();
            if (email) {
                prevEmail.textContent = email;
                prevEmail.classList.remove('empty');
            } else {
                prevEmail.textContent = 'email@empresa.com';
                prevEmail.classList.add('empty');
            }

            // Cargo
            var cargoSelected = cargoSelect.options[cargoSelect.selectedIndex];
            if (cargoSelected && cargoSelected.value) {
                var cargoNome = cargoSelected.text;
                prevRole.innerHTML = '<span class="role-badge">' + cargoNome + '</span>';
            } else {
                prevRole.innerHTML = '<span class="role-badge empty-badge">n\u00e3o definido</span>';
            }

            // Senha strength
            var pwd = senhaInput.value;
            if (!pwd) {
                prevSenha.innerHTML = '<span class="empty">n\u00e3o definida</span>';
                strengthFill.style.width = '0%';
                strengthFill.style.background = '';
                strengthHint.textContent = '';
            } else {
                var score = 0;
                if (pwd.length >= 8)  score++;
                if (/[A-Z]/.test(pwd)) score++;
                if (/[0-9]/.test(pwd)) score++;
                if (/[^A-Za-z0-9]/.test(pwd)) score++;

                var levels = [
                    { pct: '25%',  color: '#f87171', label: 'Fraca' },
                    { pct: '50%',  color: '#fb923c', label: 'Razo\u00e1vel' },
                    { pct: '75%',  color: '#facc15', label: 'Boa' },
                    { pct: '100%', color: '#34d399', label: 'Forte' }
                ];
                var lvl = levels[Math.max(0, score - 1)];
                strengthFill.style.width  = lvl.pct;
                strengthFill.style.background = lvl.color;
                strengthHint.textContent  = 'Senha ' + lvl.label;
                strengthHint.style.color  = lvl.color;

                var dots = '';
                for (var i = 0; i < pwd.length && i < 12; i++) dots += '\u2022';
                if (pwd.length > 12) dots += '\u2026';
                prevSenha.innerHTML = '<span style="letter-spacing:2px;">' + dots + '</span> <span style="font-size:11px;color:var(--faint);">(' + lvl.label + ')</span>';
            }
        }

        nomeInput.addEventListener('input',  updatePreview);
        emailInput.addEventListener('input', updatePreview);
        senhaInput.addEventListener('input', updatePreview);
        cargoSelect.addEventListener('change', updatePreview);

        updatePreview();
    </script>

    <!-- MODAL CONFIGURACOES -->
    <div class="modal-overlay" id="modalConfig" onclick="fecharFora(event)" style="position: fixed; inset: 0; z-index: 999; background: rgba(0,0,0,0.65); backdrop-filter: blur(4px); display: none; align-items: center; justify-content: center; padding: 20px;">
        <div class="modal" style="background: var(--card); border: 1px solid var(--border-md); border-radius: 18px; padding: 32px 36px; width: 100%; max-width: 480px; position: relative; animation: fadeUp 0.25s ease both;">
            <button class="modal-close" onclick="fecharConfig()" style="position: absolute; top: 16px; right: 16px; background: var(--panel); border: 1px solid var(--border); border-radius: 8px; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--muted); transition: background 0.15s, color 0.15s;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 14px; height: 14px;">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>

            <div style="font-family: 'Syne',sans-serif; font-size: 17px; font-weight: 700; margin-bottom: 4px;">Configurações da Empresa</div>
            <div style="font-size: 13px; color: var(--muted); margin-bottom: 22px;">Atualize as informações da sua empresa</div>
            <div style="height: 1px; background: var(--border); margin-bottom: 22px;"></div>

            <form method="POST" action="/Empresa/Configuracoes" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div style="margin-bottom: 16px;">
                    <label style="display: block; font-size: 11px; font-weight: 500; color: var(--muted); margin-bottom: 7px; text-transform: uppercase; letter-spacing: 0.05em;">E-mail da Empresa</label>
                    <input type="email" name="Email" style="width: 100%; height: 42px; background: var(--panel); border: 1px solid var(--border); border-radius: 9px; padding: 0 14px; font-family: 'DM Sans',sans-serif; font-size: 14px; color: var(--text); outline: none;" placeholder="contato@suaempresa.com" />
                </div>

                <div style="margin-bottom: 16px;">
                    <label style="display: block; font-size: 11px; font-weight: 500; color: var(--muted); margin-bottom: 7px; text-transform: uppercase; letter-spacing: 0.05em;">Logo da Empresa</label>
                    <div style="border: 2px dashed var(--border); border-radius: 10px; padding: 20px; text-align: center; cursor: pointer; transition: border-color 0.2s, background 0.2s;" id="uploadArea">
                        <input type="file" name="Logo" accept="image/*" id="logoInput" onchange="previewLogo(this)" style="position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%;" />
                        <div style="color: var(--faint); margin-bottom: 8px;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width: 28px; height: 28px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg></div>
                        <div style="font-size: 13px; color: var(--muted);">Clique para selecionar uma imagem</div>
                        <div style="font-size: 11px; color: var(--faint); margin-top: 4px;">PNG, JPG ou SVG — máx. 2MB</div>
                    </div>
                </div>

                <div style="display: flex; gap: 10px; margin-top: 24px;">
                    <button type="button" class="modal-btn-cancel" onclick="fecharConfig()" style="height: 44px; padding: 0 20px; background: none; border: 1px solid var(--border); border-radius: 9px; color: var(--muted); font-size: 14px; cursor: pointer; transition: background 0.15s, color 0.15s;">Cancelar</button>
                    <button type="submit" style="flex: 1; height: 44px; background: var(--accent); border: none; border-radius: 9px; font-family: 'Syne',sans-serif; font-size: 14px; font-weight: 600; color: white; cursor: pointer; transition: background 0.2s, transform 0.15s;">Salvar alterações</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function abrirConfig() {
            document.getElementById('modalConfig').style.display = 'flex';
        }

        function fecharConfig() {
            document.getElementById('modalConfig').style.display = 'none';
        }

        function fecharFora(e) {
            if (e.target === document.getElementById('modalConfig')) fecharConfig();
        }

        function previewLogo(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    console.log('Logo preview loaded');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') fecharConfig();
        });
    </script>

</body>
</html>
