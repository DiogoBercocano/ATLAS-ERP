@{
    var empresa = ViewBag.Empresa as ATLAS_ERP.Models.Empresa;
}

<div class="modal-overlay" id="modalConfig" onclick="if(event.target===this)fecharConfig()">
    <div class="modal" style="max-width:480px">
        <div class="modal-header">
            <div>
                <div class="modal-title">Configurações da Empresa</div>
                <div class="modal-sub">Atualize as informações da sua empresa</div>
            </div>
            <button class="modal-close" onclick="fecharConfig()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>

        @if (ViewBag.ConfigSucesso != null)
        {
            <div class="alert-success">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12" />
                </svg>
                @ViewBag.ConfigSucesso
            </div>
        }

        @if (ViewBag.ConfigErro != null)
        {
            <div style="display:flex;align-items:center;gap:8px;background:rgba(248,113,113,.10);border:1px solid rgba(248,113,113,.22);border-radius:8px;padding:10px 14px;margin-bottom:12px;font-size:13px;color:var(--red);">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;flex-shrink:0;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                @ViewBag.ConfigErro
            </div>
        }

        @if (empresa != null)
        {
            <div class="empresa-info">
                <div class="empresa-avatar">
                    @(empresa.Nome?.Length > 0 ? empresa.Nome[0].ToString().ToUpper() : "E")
                </div>
                <div>
                    <div class="empresa-nome">@empresa.Nome</div>
                    <div class="empresa-cnpj">CNPJ: @empresa.CNPJ</div>
                </div>
            </div>
        }

        <div class="modal-divider"></div>

        <form method="POST" action="/Empresa/Configuracoes" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="modal-form-group">
                <label class="modal-form-label">E-mail da Empresa</label>
                <input type="email" name="Email" class="modal-input"
                       placeholder="contato@suaempresa.com"
                       value="@(empresa != null ? empresa.Email : "")" />
            </div>

            <div class="modal-form-group">
                <label class="modal-form-label">Logo da Empresa</label>
                <div class="upload-area" id="configUploadArea">
                    <input type="file" name="Logo" accept="image/jpeg,image/png,image/webp,image/gif"
                           id="configLogoInput" onchange="previewConfigLogo(this)" />
                    <div class="upload-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                            <polyline points="17 8 12 3 7 8" />
                            <line x1="12" y1="3" x2="12" y2="15" />
                        </svg>
                    </div>
                    <div class="upload-text">Clique para selecionar uma imagem</div>
                    <div class="upload-hint">PNG, JPG ou WebP — máx. 2MB</div>
                </div>
                <div class="upload-preview" id="configUploadPreview">
                    <img id="configPreviewImg" src="" alt="preview" />
                    <span class="upload-preview-name" id="configPreviewName"></span>
                    <button type="button" class="upload-preview-remove" onclick="removerConfigLogo()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
                        </svg>
                    </button>
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="modal-btn-cancel" onclick="fecharConfig()">Cancelar</button>
                <button type="submit" class="modal-btn-submit">Salvar alterações</button>
            </div>
        </form>
    </div>
</div>

<script nonce="@Html.CspNonce()">
    function abrirConfig() { document.getElementById('modalConfig').classList.add('open'); document.body.style.overflow = 'hidden'; }
    function fecharConfig() { document.getElementById('modalConfig').classList.remove('open'); document.body.style.overflow = ''; }
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') fecharConfig(); });
    function previewConfigLogo(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('configPreviewImg').src = e.target.result;
                document.getElementById('configPreviewName').textContent = input.files[0].name;
                document.getElementById('configUploadPreview').classList.add('visible');
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
    function removerConfigLogo() {
        document.getElementById('configLogoInput').value = '';
        document.getElementById('configUploadPreview').classList.remove('visible');
    }
    @if (ViewBag.ConfigSucesso != null || ViewBag.ConfigErro != null)
    {
        <text>window.addEventListener('load', function () { abrirConfig(); });</text>
    }
</script>
