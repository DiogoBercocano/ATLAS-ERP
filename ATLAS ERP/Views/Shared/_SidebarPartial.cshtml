@using ATLAS_ERP.Helpers
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction     = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    System.Func<string, string> activeIf = c =>
        string.Equals(currentController, c, System.StringComparison.OrdinalIgnoreCase) ? " active" : "";

    var classDashboard   = "menu-item" + ((currentController == "Admin" && currentAction == "Dashboard") ? " active" : "");
    var classProduto     = "menu-item" + activeIf("Produto");
    var classCliente     = "menu-item" + activeIf("Cliente");
    var classFornecedor  = "menu-item" + activeIf("Fornecedor");
    var classUsuario     = "menu-item" + activeIf("Usuario");
    var classVenda       = "menu-item" + activeIf("Venda");
    var classCargo       = "menu-item" + activeIf("Cargo");

    System.Func<string, string> ariaCurrent = cls =>
        cls.Contains("active") ? "page" : null;

    var nomeUsuario = Session["UsuarioLogado"]?.ToString() ?? "Usuário";
    var cargoNomeSb = Session["CargoNome"]?.ToString() ?? "Sem cargo";
    var inicial     = nomeUsuario.Length > 0 ? nomeUsuario[0].ToString().ToUpper() : "U";
}

<aside class="sidebar" aria-label="Menu de navegação">
    <div class="sidebar-logo">
        <a href="/Admin/Dashboard" aria-label="Atlas ERP — ir para o Dashboard">
            <img src="/Content/images/logos/atlas_erp_diamante.svg" alt="" aria-hidden="true" />
        </a>
    </div>

    <nav class="sidebar-nav" aria-label="Navegação principal">

        <span class="menu-label" aria-hidden="true">Principal</span>

        @if (PermissaoHelper.UsuarioTemPermissao("dashboard_view"))
        {
            <a href="/Admin/Dashboard" class="@classDashboard" aria-current="@ariaCurrent(classDashboard)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                    <rect x="3" y="3" width="7" height="7" rx="1" />
                    <rect x="14" y="3" width="7" height="7" rx="1" />
                    <rect x="3" y="14" width="7" height="7" rx="1" />
                    <rect x="14" y="14" width="7" height="7" rx="1" />
                </svg>
                Dashboard
            </a>
        }

        @if (PermissaoHelper.UsuarioTemPermissao("produtos_view"))
        {
            <a href="/Produto" class="@classProduto" aria-current="@ariaCurrent(classProduto)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                </svg>
                Produtos
            </a>
        }

        @if (PermissaoHelper.UsuarioTemPermissao("clientes_view"))
        {
            <a href="/Cliente" class="@classCliente" aria-current="@ariaCurrent(classCliente)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
                Clientes
            </a>
        }

        @if (PermissaoHelper.UsuarioTemPermissao("fornecedores_view"))
        {
            <a href="/Fornecedor" class="@classFornecedor" aria-current="@ariaCurrent(classFornecedor)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                    <polyline points="9 22 9 12 15 12 15 22" />
                </svg>
                Fornecedores
            </a>
        }

        @if (PermissaoHelper.UsuarioTemPermissao("usuarios_view"))
        {
            <a href="/Usuario" class="@classUsuario" aria-current="@ariaCurrent(classUsuario)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                    <line x1="19" y1="8" x2="19" y2="14" />
                    <line x1="22" y1="11" x2="16" y2="11" />
                </svg>
                Funcionários
            </a>
        }

        @if (PermissaoHelper.UsuarioTemPermissao("vendas_view"))
        {
            <a href="/Venda" class="@classVenda" aria-current="@ariaCurrent(classVenda)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                    <line x1="12" y1="1" x2="12" y2="23" />
                    <path d="M17 5H9.5a3.5 3.5 0 1 0 0 7h5a3.5 3.5 0 1 1 0 7H6" />
                </svg>
                Vendas
            </a>
        }

        @if (PermissaoHelper.UsuarioTemPermissao("cargos_manage"))
        {
            <a href="/Cargo" class="@classCargo" aria-current="@ariaCurrent(classCargo)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
                Cargos
            </a>
        }

        <div class="sidebar-divider" aria-hidden="true"></div>
        <span class="menu-label" aria-hidden="true">Sistema</span>

        <button type="button" onclick="abrirConfig()" class="menu-item" aria-label="Abrir configurações">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="3" />
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
            </svg>
            Configurações
        </button>

        <a href="/Auth/Logout" class="menu-item danger">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
            </svg>
            Sair
        </a>

    </nav>

    <div class="sidebar-user" role="status" aria-label="Usuário logado: @nomeUsuario, @cargoNomeSb">
        <div class="user-avatar" aria-hidden="true">@inicial</div>
        <div>
            <div class="user-name">@nomeUsuario</div>
            <div class="user-role">@cargoNomeSb</div>
        </div>
    </div>
</aside>
