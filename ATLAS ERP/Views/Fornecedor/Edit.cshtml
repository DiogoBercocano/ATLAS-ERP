@model ATLAS_ERP.Models.Fornecedor
@using ATLAS_ERP.Infrastructure
@{
    ViewBag.Title = "Editar Fornecedor - Atlas ERP";
    var cnpjFormatado = string.IsNullOrEmpty(Model.CNPJ) ? "" : DocumentoValidator.FormatarCNPJ(Model.CNPJ);
}

@section styles {
<style>
    .main { padding:32px 40px; }
    .page-header { padding:0 0 18px; margin-bottom:28px; background:none; backdrop-filter:none; position:static; }
</style>
}

<main class="main">
    <div class="page-header">
        <div>
            <div class="page-title">Editar Fornecedor</div>
            <div class="page-subtitle">@Model.Nome</div>
        </div>
        <a href="/Fornecedor" class="btn-back">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
            Voltar
        </a>
    </div>

    @if (ViewBag.Erro != null)
    {
        <div class="alert-erro">@ViewBag.Erro</div>
    }

    <div class="form-card">
        <form method="post" action="/Fornecedor/Edit" id="formEdit">
            @Html.AntiForgeryToken()
            <input type="hidden" name="FornecedorId" value="@Model.FornecedorId" />

            <div class="form-section">
                <div class="section-title">Identificação</div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="Nome">Razão Social *</label>
                        <input class="form-control" id="Nome" name="Nome" value="@Model.Nome" required maxlength="200" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="CNPJ">CNPJ *</label>
                        <input class="form-control" id="CNPJ" name="CNPJ" value="@cnpjFormatado" oninput="onCnpjInput(this)" maxlength="18" required />
                        <div class="input-help" id="cnpjHelp">Apenas números, ou com formatação. Validação automática.</div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="section-title">Contato</div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="Email">E-mail</label>
                        <input type="email" class="form-control" id="Email" name="Email" value="@Model.Email" maxlength="200" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="Telefone">Telefone</label>
                        <input class="form-control" id="Telefone" name="Telefone" value="@Model.Telefone" oninput="this.value=maskTel(this.value)" maxlength="15" />
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <a href="/Fornecedor" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">Salvar alterações</button>
            </div>
        </form>
    </div>
</main>

@section scripts {
<script nonce="@Html.CspNonce()">
    function maskCNPJ(v){v=v.replace(/\D/g,'').slice(0,14);v=v.replace(/^(\d{2})(\d)/,'$1.$2');v=v.replace(/^(\d{2})\.(\d{3})(\d)/,'$1.$2.$3');v=v.replace(/\.(\d{3})(\d)/,'.$1/$2');v=v.replace(/(\d{4})(\d)/,'$1-$2');return v;}
    function maskTel(v){v=v.replace(/\D/g,'').slice(0,11);v=v.replace(/^(\d{2})(\d)/,'($1) $2');v=v.replace(/(\d{5})(\d)/,'$1-$2');return v;}

    function validarCNPJ(cnpj){
        cnpj=cnpj.replace(/\D/g,'');
        if(cnpj.length!==14||/^(\d)\1{13}$/.test(cnpj))return false;
        var p1=[5,4,3,2,9,8,7,6,5,4,3,2],p2=[6,5,4,3,2,9,8,7,6,5,4,3,2];
        var s=0; for(var i=0;i<12;i++)s+=parseInt(cnpj[i])*p1[i];
        var r=s%11, dv1=r<2?0:11-r; if(dv1!==parseInt(cnpj[12]))return false;
        s=0; for(i=0;i<13;i++)s+=parseInt(cnpj[i])*p2[i];
        r=s%11; var dv2=r<2?0:11-r; return dv2===parseInt(cnpj[13]);
    }

    function onCnpjInput(el){
        el.value = maskCNPJ(el.value);
        var d = el.value.replace(/\D/g,'');
        var help = document.getElementById('cnpjHelp');
        if (d.length === 0) { help.textContent='CNPJ é obrigatório.'; help.style.color='var(--gold)'; return; }
        if (d.length === 14) {
            help.textContent = validarCNPJ(d) ? '✓ CNPJ válido' : '✗ CNPJ inválido';
            help.style.color = validarCNPJ(d) ? 'var(--green)' : 'var(--red)';
        } else {
            help.textContent = 'CNPJ incompleto (' + d.length + '/14 dígitos)';
            help.style.color = 'var(--gold)';
        }
    }

    document.getElementById('formEdit').addEventListener('submit', function(e){
        var d = document.getElementById('CNPJ').value.replace(/\D/g,'');
        if (d.length !== 14) {
            e.preventDefault();
            alert('CNPJ é obrigatório (14 dígitos).');
            return;
        }
        if (!validarCNPJ(d)) {
            e.preventDefault();
            alert('CNPJ inválido.');
        }
    });
</script>
}
