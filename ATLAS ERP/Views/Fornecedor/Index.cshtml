@model ATLAS_ERP.Infrastructure.PagedResult<ATLAS_ERP.Models.Fornecedor>
@{
    ViewBag.Title = "Fornecedores - Atlas ERP";
    var paged = Model ?? ATLAS_ERP.Infrastructure.PagedResult<ATLAS_ERP.Models.Fornecedor>.Empty(20);
    var lista = paged.Items;
}

@section styles {
<style>
    .main { padding:32px 40px; }
    .topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;}
    .btn-new{display:inline-flex;align-items:center;gap:7px;background:var(--accent);color:white;text-decoration:none;font-size:13px;font-weight:600;padding:10px 18px;border-radius:10px;transition:background .18s,transform .15s;box-shadow:0 4px 14px rgba(59,130,246,.3);}
    .btn-new:hover{background:#2563eb;transform:translateY(-1px);}
    .btn-new svg{width:14px;height:14px;}
    .table-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;animation:fadeUp .5s ease both;}
    .table-header{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;border-bottom:1px solid var(--border);}
    .table-title{font-family:'Syne',sans-serif;font-size:15px;font-weight:700;}
    .badge-pill{font-size:11px;background:var(--accent-soft);color:var(--accent-light);border:1px solid rgba(59,130,246,.2);padding:3px 10px;border-radius:20px;}
    table{width:100%;border-collapse:collapse;}
    thead th{font-size:11px;color:var(--faint);text-transform:uppercase;letter-spacing:.07em;font-weight:500;padding:10px 20px;text-align:left;background:rgba(0,0,0,.15);}
    tbody tr{border-top:1px solid var(--border);transition:background .15s;}
    tbody tr:hover{background:var(--card-hover);}
    tbody td{padding:13px 20px;font-size:14px;}
    .td-muted{color:var(--muted);font-size:13px;}
    .actions{display:flex;gap:6px;}
    .btn-act{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:500;padding:6px 11px;border-radius:7px;border:1px solid;cursor:pointer;background:none;transition:background .15s,transform .12s;white-space:nowrap;}
    .btn-act:hover{transform:translateY(-1px);}
    .btn-act svg{width:12px;height:12px;}
    .btn-edit{border-color:rgba(59,130,246,.25);color:var(--accent-light);background:var(--accent-soft);}
    .btn-edit:hover{background:rgba(59,130,246,.2);}
    .btn-del{border-color:rgba(248,113,113,.25);color:var(--red);background:var(--red-soft);}
    .btn-del:hover{background:rgba(248,113,113,.2);}
    .empty-state{padding:60px;text-align:center;color:var(--faint);}
    .empty-state svg{width:48px;height:48px;margin-bottom:16px;opacity:.3;}
    .modal-overlay{position:fixed;inset:0;z-index:999;background:rgba(0,0,0,.65);backdrop-filter:blur(4px);display:none;align-items:center;justify-content:center;padding:20px;}
    .modal-overlay.open{display:flex;}
    .modal{background:var(--card);border:1px solid var(--border-md);border-radius:18px;padding:28px 32px;width:100%;max-width:460px;position:relative;animation:fadeUp .25s ease both;}
    .modal-title{font-family:'Syne',sans-serif;font-size:16px;font-weight:700;margin-bottom:20px;}
    .modal-close{position:absolute;top:16px;right:16px;background:var(--panel);border:1px solid var(--border);border-radius:8px;width:30px;height:30px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--muted);}
    .modal-close svg{width:14px;height:14px;}
    .modal-form-group{margin-bottom:14px;}
    .modal-form-label{display:block;font-size:11px;font-weight:500;color:var(--muted);margin-bottom:6px;text-transform:uppercase;letter-spacing:.05em;}
    .modal-input{width:100%;height:42px;background:var(--panel);border:1px solid var(--border);border-radius:9px;padding:0 14px;font-family:'DM Sans',sans-serif;font-size:14px;color:var(--text);outline:none;transition:border-color .2s;}
    .modal-input:focus{border-color:var(--accent);}
    .modal-row-2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
    .modal-divider{height:1px;background:var(--border);margin:16px 0;}
    .modal-actions{display:flex;gap:10px;margin-top:20px;}
    .modal-btn-cancel{flex:1;height:42px;background:none;border:1px solid var(--border);border-radius:9px;color:var(--muted);font-size:14px;cursor:pointer;transition:background .15s;}
    .modal-btn-cancel:hover{background:var(--card-hover);color:var(--text);}
    .modal-btn-submit{flex:1;height:42px;background:var(--accent);border:none;border-radius:9px;font-family:'Syne',sans-serif;font-size:14px;font-weight:600;color:white;cursor:pointer;transition:background .2s;}
    .modal-btn-submit:hover{background:#2563eb;}
    .modal-btn-delete{flex:1;height:42px;background:var(--red);border:none;border-radius:9px;font-family:'Syne',sans-serif;font-size:14px;font-weight:600;color:white;cursor:pointer;transition:background .2s;}
    .modal-btn-delete:hover{background:#ef4444;}
    .modal-danger-icon{width:48px;height:48px;border-radius:50%;background:var(--red-soft);border:2px solid rgba(248,113,113,.2);display:flex;align-items:center;justify-content:center;margin:0 auto 14px;color:var(--red);}
    .modal-danger-icon svg{width:22px;height:22px;}
</style>
}

<main class="main">
    <div class="topbar">
        <div>
            <div class="page-title">Fornecedores</div>
            <div class="page-subtitle">Gerencie os fornecedores da empresa</div>
        </div>
        <a href="/Fornecedor/Create" class="btn-new">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Novo Fornecedor
        </a>
    </div>

    <div class="table-card">
        <div class="table-header">
            <span class="table-title">Todos os Fornecedores</span>
            <span class="badge-pill">@paged.TotalItems registro(s)</span>
        </div>
        @if (lista.Count > 0)
        {
            <table>
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>CNPJ</th>
                        <th>Telefone</th>
                        <th>E-mail</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in lista)
                    {
                        <tr>
                            <td><strong>@f.Nome</strong></td>
                            <td class="td-muted">@(f.CNPJ ?? "—")</td>
                            <td class="td-muted">@(f.Telefone ?? "—")</td>
                            <td class="td-muted">@(f.Email ?? "—")</td>
                            <td>
                                <div class="actions">
                                    <button class="btn-act btn-edit"
                                        data-id="@f.FornecedorId"
                                        data-nome="@Html.AttributeEncode(f.Nome)"
                                        data-cnpj="@Html.AttributeEncode(f.CNPJ ?? "")"
                                        data-tel="@Html.AttributeEncode(f.Telefone ?? "")"
                                        data-email="@Html.AttributeEncode(f.Email ?? "")"
                                        onclick="abrirEditar(this)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                        Editar
                                    </button>
                                    <button class="btn-act btn-del"
                                        data-id="@f.FornecedorId"
                                        data-nome="@Html.AttributeEncode(f.Nome)"
                                        onclick="abrirExcluir(this)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M9 6V4h6v2"/></svg>
                                        Excluir
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                <p>Nenhum fornecedor cadastrado ainda.</p>
            </div>
        }
        @Html.Partial("_PaginationControls", (ATLAS_ERP.Infrastructure.IPagedResult)paged)
    </div>
</main>

<!-- MODAL EDITAR -->
<div class="modal-overlay" id="modalEditar" onclick="fecharFora(event,'modalEditar')">
    <div class="modal">
        <button class="modal-close" onclick="fechar('modalEditar')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
        <div class="modal-title">Editar Fornecedor</div>
        <div class="modal-divider"></div>
        <form method="POST" action="/Fornecedor/Edit">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editId" name="FornecedorId" value="" />
            <div class="modal-form-group">
                <label class="modal-form-label">Nome / Razão Social</label>
                <input type="text" id="editNome" name="Nome" class="modal-input" required />
            </div>
            <div class="modal-row-2">
                <div class="modal-form-group">
                    <label class="modal-form-label">CNPJ</label>
                    <input type="text" id="editCNPJ" name="CNPJ" class="modal-input" />
                </div>
                <div class="modal-form-group">
                    <label class="modal-form-label">Telefone</label>
                    <input type="text" id="editTelefone" name="Telefone" class="modal-input" />
                </div>
            </div>
            <div class="modal-form-group">
                <label class="modal-form-label">E-mail</label>
                <input type="email" id="editEmail" name="Email" class="modal-input" />
            </div>
            <div class="modal-actions">
                <button type="button" class="modal-btn-cancel" onclick="fechar('modalEditar')">Cancelar</button>
                <button type="submit" class="modal-btn-submit">Salvar</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL EXCLUIR -->
<div class="modal-overlay" id="modalExcluir" onclick="fecharFora(event,'modalExcluir')">
    <div class="modal" style="max-width:380px;text-align:center;">
        <button class="modal-close" onclick="fechar('modalExcluir')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
        <div class="modal-danger-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M9 6V4h6v2"/></svg></div>
        <div class="modal-title" style="margin-bottom:6px;">Excluir fornecedor?</div>
        <div class="td-muted" id="excluirNome" style="margin-bottom:20px;font-size:13px;"></div>
        <form method="POST" action="/Fornecedor/Delete">
            @Html.AntiForgeryToken()
            <input type="hidden" id="excluirId" name="fornecedorId" value="" />
            <div class="modal-actions">
                <button type="button" class="modal-btn-cancel" onclick="fechar('modalExcluir')">Cancelar</button>
                <button type="submit" class="modal-btn-delete">Sim, excluir</button>
            </div>
        </form>
    </div>
</div>

@section scripts {
<script nonce="@Html.CspNonce()">
    function abrirEditar(btn) {
        document.getElementById('editId').value       = btn.dataset.id;
        document.getElementById('editNome').value     = btn.dataset.nome;
        document.getElementById('editCNPJ').value     = btn.dataset.cnpj;
        document.getElementById('editTelefone').value = btn.dataset.tel;
        document.getElementById('editEmail').value    = btn.dataset.email;
        document.getElementById('modalEditar').classList.add('open');
    }
    function abrirExcluir(btn) {
        document.getElementById('excluirId').value      = btn.dataset.id;
        document.getElementById('excluirNome').textContent = btn.dataset.nome;
        document.getElementById('modalExcluir').classList.add('open');
    }
    function fechar(id) { document.getElementById(id).classList.remove('open'); }
    function fecharFora(e, id) { if (e.target === document.getElementById(id)) fechar(id); }
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') { fechar('modalEditar'); fechar('modalExcluir'); } });
</script>
}
