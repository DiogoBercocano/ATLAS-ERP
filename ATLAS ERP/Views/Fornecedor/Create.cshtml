@model ATLAS_ERP.Models.Fornecedor
@{
    ViewBag.Title = "Novo Fornecedor - Atlas ERP";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Atlas ERP – Novo Fornecedor</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg: #050d1a; --panel: #0b1525; --card: #0f1e35; --card-hover: #132540;
            --border: rgba(100,160,255,0.10); --border-md: rgba(100,160,255,0.18);
            --accent: #3b82f6; --accent-soft: rgba(59,130,246,0.12); --accent-glow: rgba(59,130,246,0.20); --accent-light: #60a5fa;
            --green: #34d399; --green-soft: rgba(52,211,153,0.10);
            --red: #f87171; --red-soft: rgba(248,113,113,0.10);
            --gold: #c9a84c; --gold-soft: rgba(201,168,76,0.12);
            --text: #e8f0fe; --muted: #7a9cc8; --faint: #3d5270;
            --sidebar-w: 320px; --radius: 14px;
        }
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100%; }
        body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text); display: flex; min-height: 100vh; }

        /* BG */
        .bg-layer { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
        .bg-dots { position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(59,130,246,0.08) 1px, transparent 1px); background-size: 36px 36px; mask-image: radial-gradient(ellipse 70% 70% at 60% 40%, black, transparent); }

        /* SIDEBAR */
        .sidebar { width: var(--sidebar-w); height: 100vh; background: var(--panel); border-right: 1px solid var(--border); position: fixed; top: 0; left: 0; display: flex; flex-direction: column; padding: 28px 16px; z-index: 100; }
        .sidebar-logo { display: flex; align-items: center; justify-content: center; margin-bottom: 36px; }
        .sidebar-logo a { display: flex; align-items: center; justify-content: center; width: 100%; }
        .sidebar-logo img { width: 300px; max-width: 100%; }
        .sidebar-divider { height: 1px; background: var(--border); margin: 8px 0 16px; }
        .menu-label { font-size: 10px; font-weight: 500; color: var(--faint); text-transform: uppercase; letter-spacing: .10em; padding: 0 12px; margin-bottom: 6px; }
        .menu-item { display: flex; align-items: center; gap: 10px; color: var(--muted); text-decoration: none; font-size: 14px; padding: 10px 12px; border-radius: 10px; margin-bottom: 2px; transition: background .18s, color .18s; position: relative; }
        .menu-item svg { width: 16px; height: 16px; flex-shrink: 0; opacity: .7; }
        .menu-item:hover { background: var(--card); color: var(--text); }
        .menu-item:hover svg { opacity: 1; }
        .menu-item.active { background: var(--accent-soft); color: var(--accent-light); font-weight: 500; }
        .menu-item.active svg { opacity: 1; }
        .menu-item.active::before { content: ''; position: absolute; left: 0; top: 20%; bottom: 20%; width: 3px; background: var(--accent); border-radius: 0 3px 3px 0; }
        .menu-item.danger { color: var(--red); }
        .menu-item.danger:hover { background: var(--red-soft); }
        .sidebar-spacer { flex: 1; }
        .sidebar-user { display: flex; align-items: center; gap: 10px; padding: 12px; border-radius: 10px; border: 1px solid var(--border); background: var(--card); }
        .user-avatar { width: 34px; height: 34px; border-radius: 50%; background: var(--accent-soft); border: 1px solid var(--border-md); display: flex; align-items: center; justify-content: center; font-family: 'Syne', sans-serif; font-size: 13px; font-weight: 700; color: var(--accent-light); flex-shrink: 0; }
        .user-name { font-size: 13px; font-weight: 500; color: var(--text); }
        .user-role { font-size: 11px; color: var(--faint); }

        /* MAIN */
        .main { margin-left: var(--sidebar-w); flex: 1; display: flex; flex-direction: column; min-height: 100vh; position: relative; z-index: 1; }

        /* PAGE HEADER */
        .page-header { padding: 28px 40px 22px; border-bottom: 1px solid var(--border); background: rgba(11,21,37,0.6); backdrop-filter: blur(8px); position: sticky; top: 0; z-index: 10; }
        .breadcrumb { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--faint); margin-bottom: 10px; }
        .breadcrumb a { color: var(--muted); text-decoration: none; transition: color .15s; }
        .breadcrumb a:hover { color: var(--text); }
        .breadcrumb-sep { opacity: .4; }
        .header-row { display: flex; align-items: center; justify-content: space-between; }
        .page-title { font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 700; }
        .page-subtitle { font-size: 13px; color: var(--muted); margin-top: 3px; }
        .btn-back { display: inline-flex; align-items: center; gap: 7px; color: var(--muted); text-decoration: none; font-size: 13px; background: var(--card); border: 1px solid var(--border); padding: 9px 16px; border-radius: 10px; transition: background .18s, color .18s; }
        .btn-back:hover { background: var(--card-hover); color: var(--text); }
        .btn-back svg { width: 14px; height: 14px; }

        /* CONTENT */
        .page-content { flex: 1; padding: 32px 40px; display: grid; grid-template-columns: 1fr 320px; gap: 28px; align-items: start; }

        /* FORM SECTIONS */
        .form-section { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; margin-bottom: 14px; transition: border-color .2s; }
        .form-section:last-child { margin-bottom: 0; }
        .form-section:focus-within { border-color: var(--border-md); }
        .section-head { display: flex; align-items: center; gap: 14px; padding: 16px 22px; border-bottom: 1px solid var(--border); background: rgba(0,0,0,0.12); }
        .section-num { width: 26px; height: 26px; border-radius: 7px; background: var(--accent-soft); border: 1px solid rgba(59,130,246,0.22); display: flex; align-items: center; justify-content: center; font-family: 'Syne', sans-serif; font-size: 11px; font-weight: 700; color: var(--accent-light); flex-shrink: 0; }
        .section-title { font-family: 'Syne', sans-serif; font-size: 13px; font-weight: 700; }
        .section-desc { font-size: 11px; color: var(--faint); margin-top: 2px; }
        .section-body { padding: 22px 22px 18px; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .form-group { margin-bottom: 16px; }
        .form-group:last-child { margin-bottom: 0; }
        .form-label { display: flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 600; color: var(--muted); margin-bottom: 8px; text-transform: uppercase; letter-spacing: .06em; }
        .input-wrap { position: relative; }
        .input-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--faint); pointer-events: none; display: flex; transition: color .2s; }
        .input-icon svg { width: 15px; height: 15px; }
        .form-control { width: 100%; height: 46px; background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 0 14px 0 44px; font-family: 'DM Sans', sans-serif; font-size: 14px; color: var(--text); outline: none; transition: border-color .2s, box-shadow .2s; -webkit-appearance: none; }
        .form-control::placeholder { color: var(--faint); }
        .form-control:hover { border-color: var(--border-md); }
        .form-control:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); }
        .form-control:focus ~ .input-icon { color: var(--accent-light); }
        .form-control-lookup { padding-right: 115px; }
        .field-error { font-size: 12px; color: var(--red); margin-top: 5px; }

        /* API BADGE */
        .api-badge { font-size: 11px; font-weight: 500; display: none; align-items: center; gap: 5px; white-space: nowrap; border-radius: 6px; padding: 2px 8px; }
        .api-badge.show { display: inline-flex; }
        .api-badge.loading { color: var(--muted); background: rgba(100,160,255,0.08); }
        .api-badge.ok { color: var(--green); background: var(--green-soft); }
        .api-badge.err { color: var(--red); background: var(--red-soft); }
        .spinner { width: 11px; height: 11px; border: 2px solid var(--border-md); border-top-color: var(--accent-light); border-radius: 50%; animation: spin .7s linear infinite; display: inline-block; }
        @@keyframes spin { to { transform: rotate(360deg); } }

        /* PREVIEW CARD */
        .preview-sticky { position: sticky; top: calc(28px + 22px + 56px + 28px); }
        .preview-label { font-size: 11px; font-weight: 600; color: var(--faint); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 10px; }
        .preview-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
        .preview-top { padding: 28px 22px 22px; border-bottom: 1px solid var(--border); display: flex; flex-direction: column; align-items: center; text-align: center; background: linear-gradient(160deg, #0f1e35 0%, #0b1a30 100%); }
        .preview-avatar { width: 56px; height: 56px; border-radius: 14px; background: var(--accent-soft); border: 1px solid rgba(59,130,246,0.22); display: flex; align-items: center; justify-content: center; font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 700; color: var(--accent-light); margin-bottom: 12px; transition: background .3s; }
        .preview-name { font-family: 'Syne', sans-serif; font-size: 15px; font-weight: 700; color: var(--text); margin-bottom: 4px; max-width: 100%; word-break: break-word; }
        .preview-cnpj { font-size: 12px; color: var(--faint); font-family: monospace; letter-spacing: .04em; }
        .preview-body { padding: 18px 22px; display: flex; flex-direction: column; gap: 12px; }
        .preview-row { display: flex; align-items: flex-start; gap: 12px; }
        .preview-icon { width: 30px; height: 30px; border-radius: 8px; background: var(--panel); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: var(--faint); }
        .preview-icon svg { width: 13px; height: 13px; }
        .preview-field-label { font-size: 10px; text-transform: uppercase; letter-spacing: .07em; color: var(--faint); font-weight: 500; margin-bottom: 2px; }
        .preview-field-val { font-size: 13px; color: var(--text); }
        .preview-field-val.empty { color: var(--faint); font-style: italic; }
        .preview-tip { margin-top: 14px; display: flex; align-items: flex-start; gap: 9px; background: rgba(59,130,246,0.06); border: 1px solid rgba(59,130,246,0.12); border-radius: 10px; padding: 12px 14px; font-size: 12px; color: var(--muted); line-height: 1.5; }
        .preview-tip svg { width: 14px; height: 14px; flex-shrink: 0; color: var(--accent-light); margin-top: 1px; }

        /* ACTION BAR */
        .action-bar { padding: 18px 40px; border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; background: rgba(5,13,26,0.85); backdrop-filter: blur(10px); position: sticky; bottom: 0; z-index: 10; }
        .action-hint { font-size: 12px; color: var(--faint); }
        .action-hint span { color: var(--red); }
        .action-btns { display: flex; gap: 10px; }
        .btn-cancel { height: 44px; padding: 0 22px; background: none; border: 1px solid var(--border); border-radius: 10px; color: var(--muted); font-size: 14px; text-decoration: none; display: inline-flex; align-items: center; transition: background .15s, color .15s; }
        .btn-cancel:hover { background: var(--card-hover); color: var(--text); }
        .btn-submit { height: 44px; padding: 0 28px; background: var(--accent); border: none; border-radius: 10px; font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 600; color: white; cursor: pointer; transition: background .2s, transform .15s; box-shadow: 0 4px 16px rgba(59,130,246,.25); display: inline-flex; align-items: center; gap: 8px; }
        .btn-submit svg { width: 15px; height: 15px; }
        .btn-submit:hover { background: #2563eb; transform: translateY(-1px); }

        @@keyframes fadeIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
        .form-section { animation: fadeIn .4s ease both; }
        .form-section:nth-child(2) { animation-delay: .05s; }
        .form-section:nth-child(3) { animation-delay: .10s; }

        @@media (max-width: 1100px) { .page-content { grid-template-columns: 1fr; } .preview-sticky { position: static; } }
        @@media (max-width: 700px) { .sidebar { display: none; } .main { margin-left: 0; } .page-header, .page-content, .action-bar { padding-left: 20px; padding-right: 20px; } .form-row { grid-template-columns: 1fr; } }
    </style>
</head>
<body>

<div class="bg-layer"><div class="bg-dots"></div></div>

<aside class="sidebar">
    <div class="sidebar-logo">
        <a href="/Admin/Dashboard"><img src="~/Content/images/logos/atlas_erp_diamante.svg" alt="Atlas ERP" /></a>
    </div>
    <span class="menu-label">Principal</span>
    <a href="/Admin/Dashboard" class="menu-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>Dashboard</a>
    <a href="/Venda" class="menu-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>Vendas</a>
    <a href="/Produto" class="menu-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>Produtos</a>
    <a href="/Cliente" class="menu-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>Clientes</a>
    <a href="/Fornecedor" class="menu-item active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg>Fornecedores</a>
    <a href="/Usuario" class="menu-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>Funcionários</a>
    @if (PermissaoHelper.UsuarioTemPermissao("cargos_manage"))
    {
        <a href="/Cargo" class="menu-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Cargos</a>
    }
    <div class="sidebar-divider"></div>
    <span class="menu-label">Sistema</span>
    <button class="menu-item" onclick="abrirConfig()" style="background: none; border: none; cursor: pointer; width: 100%; text-align: left;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>Configurações</button>
    <a href="/Auth/Logout" class="menu-item danger"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>Sair</a>
    <div class="sidebar-spacer"></div>
    <div class="sidebar-user">
        @{ var nm = Session["UsuarioLogado"]?.ToString() ?? "Usuário"; }
        <div class="user-avatar">@(nm.Length > 0 ? nm[0].ToString().ToUpper() : "U")</div>
        <div><div class="user-name">@nm</div><div class="user-role">@(Session["CargoNome"]?.ToString())</div></div>
    </div>
</aside>

@using (Html.BeginForm("Create", "Fornecedor", FormMethod.Post, new { id = "mainForm" }))
{
    @Html.AntiForgeryToken()

    <div class="main">

        <div class="page-header">
            <div class="breadcrumb">
                <a href="/Admin/Dashboard">Dashboard</a>
                <span class="breadcrumb-sep">›</span>
                <a href="/Fornecedor">Fornecedores</a>
                <span class="breadcrumb-sep">›</span>
                <span>Novo cadastro</span>
            </div>
            <div class="header-row">
                <div>
                    <div class="page-title">Novo Fornecedor</div>
                    <div class="page-subtitle">Preencha o CNPJ para autocompletar ou insira os dados manualmente</div>
                </div>
                <a href="/Fornecedor" class="btn-back">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
                    Voltar
                </a>
            </div>
        </div>

        <div class="page-content">

            <!-- FORM SECTIONS -->
            <div class="form-col">

                <!-- SEÇÃO 1: IDENTIFICAÇÃO -->
                <div class="form-section">
                    <div class="section-head">
                        <div class="section-num">1</div>
                        <div>
                            <div class="section-title">Identificação</div>
                            <div class="section-desc">CNPJ — dados preenchidos automaticamente via Receita Federal</div>
                        </div>
                    </div>
                    <div class="section-body">
                        <div class="form-group">
                            <label class="form-label">
                                CNPJ <span class="api-badge" id="cnpjBadge"></span>
                            </label>
                            <div class="input-wrap">
                                @Html.TextBoxFor(m => m.CNPJ, new { @class = "form-control form-control-lookup", placeholder = "00.000.000/0000-00", id = "cnpjInput", autocomplete = "off" })
                                <span class="input-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SEÇÃO 2: DADOS -->
                <div class="form-section">
                    <div class="section-head">
                        <div class="section-num">2</div>
                        <div>
                            <div class="section-title">Dados da Empresa</div>
                            <div class="section-desc">Razão social e informações de contato</div>
                        </div>
                    </div>
                    <div class="section-body">
                        <div class="form-group">
                            <label class="form-label">Nome / Razão Social <span style="color:var(--red)">*</span></label>
                            <div class="input-wrap">
                                @Html.TextBoxFor(m => m.Nome, new { @class = "form-control", placeholder = "Ex: Distribuidora Silva Ltda", id = "nomeInput", required = "required" })
                                <span class="input-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg></span>
                            </div>
                            @Html.ValidationMessageFor(m => m.Nome, "", new { @class = "field-error" })
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Telefone</label>
                                <div class="input-wrap">
                                    @Html.TextBoxFor(m => m.Telefone, new { @class = "form-control", placeholder = "(00) 00000-0000", id = "telInput" })
                                    <span class="input-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.8a16 16 0 0 0 6.29 6.29l.95-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="form-label">E-mail</label>
                                <div class="input-wrap">
                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "contato@empresa.com", id = "emailInput", type = "email" })
                                    <span class="input-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7L22 7"/></svg></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SEÇÃO 3: LOCALIZAÇÃO -->
                <div class="form-section">
                    <div class="section-head">
                        <div class="section-num">3</div>
                        <div>
                            <div class="section-title">Localização</div>
                            <div class="section-desc">CEP — endereço preenchido automaticamente</div>
                        </div>
                    </div>
                    <div class="section-body">
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">
                                    CEP <span class="api-badge" id="cepBadge"></span>
                                </label>
                                <div class="input-wrap">
                                    <input type="text" id="cepInput" class="form-control form-control-lookup" placeholder="00000-000" maxlength="9" autocomplete="off" />
                                    <span class="input-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Endereço</label>
                            <div class="input-wrap">
                                @Html.TextBoxFor(m => m.Endereco, new { @class = "form-control", placeholder = "Rua, número, bairro, cidade — UF", id = "enderecoInput" })
                                <span class="input-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span>
                            </div>
                        </div>
                    </div>
                </div>

            </div><!-- /form-col -->

            <!-- PREVIEW -->
            <div class="preview-sticky">
                <div class="preview-label">Prévia do cadastro</div>
                <div class="preview-card">
                    <div class="preview-top">
                        <div class="preview-avatar" id="previewAvatar">?</div>
                        <div class="preview-name" id="previewNome">Nome do fornecedor</div>
                        <div class="preview-cnpj" id="previewCNPJ">CNPJ não informado</div>
                    </div>
                    <div class="preview-body">
                        <div class="preview-row">
                            <div class="preview-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12"/><path d="M1.61 3.4a2 2 0 0 1 2-.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.8a16 16 0 0 0 6.29 6.29"/></svg></div>
                            <div>
                                <div class="preview-field-label">Telefone</div>
                                <div class="preview-field-val empty" id="previewTel">Não informado</div>
                            </div>
                        </div>
                        <div class="preview-row">
                            <div class="preview-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7L22 7"/></svg></div>
                            <div>
                                <div class="preview-field-label">E-mail</div>
                                <div class="preview-field-val empty" id="previewEmail">Não informado</div>
                            </div>
                        </div>
                        <div class="preview-row">
                            <div class="preview-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></div>
                            <div>
                                <div class="preview-field-label">Endereço</div>
                                <div class="preview-field-val empty" id="previewEndereco">Não informado</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="preview-tip">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    Digite o CNPJ para preencher os dados automaticamente via Receita Federal (BrasilAPI).
                </div>
            </div>

        </div><!-- /page-content -->

        <!-- ACTION BAR -->
        <div class="action-bar">
            <span class="action-hint"><span>*</span> Campos obrigatórios</span>
            <div class="action-btns">
                <a href="/Fornecedor" class="btn-cancel">Cancelar</a>
                <button type="submit" class="btn-submit">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                    Cadastrar Fornecedor
                </button>
            </div>
        </div>

    </div><!-- /main -->
}

<script>
    function maskCNPJ(v) { v=v.replace(/\D/g,'').slice(0,14); v=v.replace(/^(\d{2})(\d)/,'$1.$2'); v=v.replace(/^(\d{2})\.(\d{3})(\d)/,'$1.$2.$3'); v=v.replace(/\.(\d{3})(\d)/,'.$1/$2'); v=v.replace(/(\d{4})(\d)/,'$1-$2'); return v; }
    function maskTel(v)  { v=v.replace(/\D/g,'').slice(0,11); v=v.replace(/^(\d{2})(\d)/,'($1) $2'); v=v.replace(/(\d{5})(\d)/,'$1-$2'); return v; }
    function maskCEP(v)  { v=v.replace(/\D/g,'').slice(0,8); v=v.replace(/^(\d{5})(\d)/,'$1-$2'); return v; }

    function badge(id, state, msg) {
        var el=document.getElementById(id);
        el.className='api-badge show '+state;
        el.innerHTML=state==='loading'?'<span class="spinner"></span> '+msg:msg;
    }
    function hideBadge(id) { document.getElementById(id).className='api-badge'; }

    function setPreview(field, value) {
        var el=document.getElementById(field);
        if (!el) return;
        if (value) { el.textContent=value; el.classList.remove('empty'); }
        else       { el.classList.add('empty'); }
    }

    function updatePreview() {
        var nome=document.getElementById('nomeInput').value.trim();
        var cnpj=document.getElementById('cnpjInput').value.trim();
        var tel =document.getElementById('telInput').value.trim();
        var email=document.getElementById('emailInput').value.trim();
        var end =document.getElementById('enderecoInput').value.trim();

        document.getElementById('previewNome').textContent = nome || 'Nome do fornecedor';
        document.getElementById('previewCNPJ').textContent = cnpj || 'CNPJ não informado';
        var av = document.getElementById('previewAvatar');
        av.textContent = nome ? nome[0].toUpperCase() : '?';

        setPreview('previewTel',   tel   || null);
        if (!tel)   document.getElementById('previewTel').textContent='Não informado';
        setPreview('previewEmail', email || null);
        if (!email) document.getElementById('previewEmail').textContent='Não informado';
        setPreview('previewEndereco', end || null);
        if (!end)   document.getElementById('previewEndereco').textContent='Não informado';
    }

    ['nomeInput','cnpjInput','telInput','emailInput','enderecoInput'].forEach(function(id){
        var el=document.getElementById(id);
        if(el) el.addEventListener('input', updatePreview);
    });

    document.getElementById('cnpjInput').addEventListener('input', function(e) {
        e.target.value=maskCNPJ(e.target.value);
        updatePreview();
        if(e.target.value.replace(/\D/g,'').length===14) buscarCNPJ(e.target.value.replace(/\D/g,''));
    });
    document.getElementById('telInput').addEventListener('input', function(e){ e.target.value=maskTel(e.target.value); });
    document.getElementById('cepInput').addEventListener('input', function(e){
        e.target.value=maskCEP(e.target.value);
        if(e.target.value.replace(/\D/g,'').length===8) buscarCEP(e.target.value.replace(/\D/g,''));
    });

    function buscarCNPJ(digits) {
        badge('cnpjBadge','loading','Consultando...');
        fetch('https://brasilapi.com.br/api/cnpj/v1/'+digits)
            .then(function(r){ return r.ok?r.json():Promise.reject('CNPJ não encontrado'); })
            .then(function(d){
                var nome=d.razao_social||d.nome_fantasia||'';
                var tel=d.ddd_telefone_1?d.ddd_telefone_1.replace(/\D/g,''):'';
                var end=[d.logradouro,d.numero,d.bairro,d.municipio,d.uf].filter(Boolean).join(', ');
                if(nome)    document.getElementById('nomeInput').value=nome;
                if(tel)     document.getElementById('telInput').value=maskTel(tel);
                if(d.email) document.getElementById('emailInput').value=d.email;
                if(end)     document.getElementById('enderecoInput').value=end;
                updatePreview();
                badge('cnpjBadge','ok','✓ Dados preenchidos');
                setTimeout(function(){ hideBadge('cnpjBadge'); },3000);
            })
            .catch(function(err){
                badge('cnpjBadge','err','✗ '+(typeof err==='string'?err:'Erro na consulta'));
                setTimeout(function(){ hideBadge('cnpjBadge'); },4000);
            });
    }

    function buscarCEP(digits) {
        badge('cepBadge','loading','Buscando...');
        fetch('https://brasilapi.com.br/api/cep/v2/'+digits)
            .then(function(r){ return r.ok?r.json():Promise.reject('CEP não encontrado'); })
            .then(function(d){
                var end=[d.street,d.neighborhood,d.city,d.state].filter(Boolean).join(', ');
                if(end){ document.getElementById('enderecoInput').value=end; updatePreview(); }
                badge('cepBadge','ok','✓ Endereço preenchido');
                setTimeout(function(){ hideBadge('cepBadge'); },3000);
            })
            .catch(function(err){
                badge('cepBadge','err','✗ '+(typeof err==='string'?err:'CEP inválido'));
                setTimeout(function(){ hideBadge('cepBadge'); },4000);
            });
    }
        function abrirConfig() { document.getElementById('modalConfig').classList.add('open'); }
        function fecharConfig() { document.getElementById('modalConfig').classList.remove('open'); }
        function fecharFora(e) { if (e.target === document.getElementById('modalConfig')) fecharConfig(); }
        function previewLogo(input) { if (input.files && input.files[0]) { var reader = new FileReader(); reader.onload = function(e) { document.getElementById('previewImg').src = e.target.result; document.getElementById('previewName').textContent = input.files[0].name; document.getElementById('uploadPreview').classList.add('visible'); }; reader.readAsDataURL(input.files[0]); } }
        function removerLogo() { document.getElementById('logoInput').value = ''; document.getElementById('uploadPreview').classList.remove('visible'); }
        document.addEventListener('keydown', function(e) { if (e.key === 'Escape') fecharConfig(); });
    </script>
    <div class="modal-overlay" id="modalConfig" onclick="fecharFora(event)">
        <div class="modal">
            <button class="modal-close" onclick="fecharConfig()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg></button>
            <div class="modal-title">Configurações da Empresa</div>
            <div class="modal-sub">Atualize as informações da sua empresa</div>
            <div class="modal-divider"></div>
            <form method="POST" action="/Empresa/Configuracoes" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-form-group">
                    <label class="modal-form-label">E-mail da Empresa</label>
                    <input type="email" name="Email" class="modal-input" placeholder="contato@suaempresa.com" />
                </div>
                <div class="modal-form-group">
                    <label class="modal-form-label">Logo da Empresa</label>
                    <div class="upload-area" id="uploadArea">
                        <input type="file" name="Logo" accept="image/*" id="logoInput" onchange="previewLogo(this)" />
                        <div class="upload-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg></div>
                        <div class="upload-text">Clique para selecionar uma imagem</div>
                        <div class="upload-hint">PNG, JPG ou SVG — máx. 2MB</div>
                    </div>
                    <div class="upload-preview" id="uploadPreview">
                        <img id="previewImg" src="" alt="preview" />
                        <span class="upload-preview-name" id="previewName"></span>
                        <button type="button" class="upload-preview-remove" onclick="removerLogo()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg></button>
                    </div>
                </div>
                <div class="modal-actions">
                    <button type="button" class="modal-btn-cancel" onclick="fecharConfig()">Cancelar</button>
                    <button type="submit" class="modal-btn-submit">Salvar alterações</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
