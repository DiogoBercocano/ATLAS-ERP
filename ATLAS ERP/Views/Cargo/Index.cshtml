@using ATLAS_ERP.Helpers
@model List<ATLAS_ERP.Models.Cargo>
@{
    ViewBag.Title = "Gerenciar Cargos - Atlas ERP";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cargos - Atlas ERP</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg: #050d1a;
            --panel: #0b1525;
            --card: #0f1e35;
            --card-hover: #132540;
            --border: rgba(100,160,255,0.15);
            --accent: #3b82f6;
            --accent-dark: #1e40af;
            --accent-soft: rgba(59,130,246,0.12);
            --text: #e8f0fe;
            --muted: #7a9cc8;
            --faint: #3d5270;
            --red: #f87171;
            --green: #34d399;
            --sidebar-w: 280px;
            --radius: 16px;
        }

        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text); display: flex; min-height: 100vh; }

        .sidebar {
            width: var(--sidebar-w);
            height: 100vh;
            background: linear-gradient(135deg, var(--panel) 0%, #0a0f1e 100%);
            border-right: 1px solid var(--border);
            position: fixed;
            top: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            padding: 32px 16px;
            z-index: 100;
            overflow-y: auto;
        }

        .sidebar-logo { display: flex; align-items: center; justify-content: center; margin-bottom: 48px; }
        .sidebar-logo img { width: 280px; max-width: 100%; }

        .menu-section-title {
            font-size: 10px;
            font-weight: 600;
            color: var(--faint);
            text-transform: uppercase;
            letter-spacing: 0.12em;
            padding: 0 12px;
            margin-bottom: 12px;
            margin-top: 24px;
        }
        .menu-section-title:first-of-type { margin-top: 0; }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--muted);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            padding: 11px 14px;
            border-radius: 10px;
            margin-bottom: 4px;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }
        .menu-item:hover {
            background: rgba(59,130,246,0.1);
            color: var(--accent-light);
            transform: translateX(4px);
        }
        .menu-item.active {
            background: var(--accent-soft);
            color: var(--accent);
            font-weight: 600;
            box-shadow: inset 0 0 0 1px var(--accent);
        }
        .menu-item svg { width: 18px; height: 18px; flex-shrink: 0; }

        .main {
            flex: 1;
            margin-left: var(--sidebar-w);
            padding: 48px 40px;
            position: relative;
            z-index: 1;
            background: linear-gradient(135deg, #050d1a 0%, #0a1428 100%);
        }
        .content { max-width: 1400px; margin: 0 auto; }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 48px;
            padding-bottom: 24px;
            border-bottom: 1px solid var(--border);
        }
        .header h1 {
            font-family: 'Syne', sans-serif;
            font-size: 36px;
            font-weight: 800;
            background: linear-gradient(135deg, #e8f0fe 0%, #60a5fa 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .btn-new {
            background: linear-gradient(135deg, var(--accent) 0%, #2563eb 100%);
            color: white;
            border: none;
            padding: 13px 28px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(59,130,246,0.3);
        }
        .btn-new:hover {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(59,130,246,0.4);
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
            gap: 24px;
        }

        .card {
            background: linear-gradient(135deg, var(--card) 0%, #0d2139 100%);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 28px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }
        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(59,130,246,0.5), transparent);
        }
        .card:hover {
            border-color: rgba(59,130,246,0.4);
            background: linear-gradient(135deg, #132540 0%, #1a3a52 100%);
            box-shadow: 0 12px 40px rgba(59,130,246,0.15);
            transform: translateY(-6px);
        }

        .card-icon {
            width: 48px;
            height: 48px;
            background: var(--accent-soft);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
            font-size: 24px;
        }

        .card-title {
            font-family: 'Syne', sans-serif;
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 8px;
            color: var(--text);
        }
        .card-desc {
            font-size: 13px;
            color: var(--faint);
            margin-bottom: 20px;
            line-height: 1.6;
            min-height: 39px;
        }

        .card-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 0;
            margin-bottom: 16px;
            border-top: 1px solid rgba(100,160,255,0.08);
            border-bottom: 1px solid rgba(100,160,255,0.08);
            font-size: 12px;
        }

        .status-badge {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .status-badge.ativo {
            background: rgba(52,211,153,0.2);
            color: #6ee7b7;
            border: 1px solid rgba(52,211,153,0.3);
        }
        .status-badge.inativo {
            background: rgba(248,113,113,0.2);
            color: #fca5a5;
            border: 1px solid rgba(248,113,113,0.3);
        }

        .card-date {
            color: var(--muted);
        }

        .card-actions {
            display: flex;
            gap: 8px;
        }
        .btn-action {
            flex: 1;
            padding: 10px 12px;
            border: 1px solid var(--border);
            background: transparent;
            color: var(--text);
            border-radius: 10px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-action:hover {
            background: var(--accent-soft);
            border-color: var(--accent);
            color: var(--accent);
        }
        .btn-action.danger {
            color: var(--red);
            border-color: rgba(248,113,113,0.2);
        }
        .btn-action.danger:hover {
            background: rgba(248,113,113,0.1);
            border-color: var(--red);
        }

        .empty-state {
            text-align: center;
            padding: 80px 40px;
            color: var(--faint);
        }
        .empty-state-icon {
            font-size: 64px;
            margin-bottom: 24px;
            opacity: 0.5;
        }
        .empty-state h3 {
            font-family: 'Syne', sans-serif;
            font-size: 22px;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 8px;
        }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-logo">
            <a href="/"><img src="~/Content/images/logos/atlas_erp_diamante.svg" alt="Atlas ERP" /></a>
    }
        </div>

        <div class="menu-section-title">Admin</div>
        <a href="/Cargo" class="menu-item active">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
            </svg>
            Cargos
        </a>
    }

        <div class="menu-section-title">Menu</div>
        <a href="/Admin/Dashboard" class="menu-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7" rx="1" />
                <rect x="14" y="3" width="7" height="7" rx="1" />
                <rect x="3" y="14" width="7" height="7" rx="1" />
                <rect x="14" y="14" width="7" height="7" rx="1" />
            </svg>
            Dashboard
        </a>
    }

        <div style="flex: 1;"></div>

        <a href="/Auth/Logout" class="menu-item" style="color: var(--red); margin-top: 24px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
            </svg>
            Sair
        </a>
    }
    </aside>

    <main class="main">
        <div class="content">
            <div class="header">
                <h1>Cargos</h1>
                <a href="/Cargo/Create" class="btn-new">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width: 18px; height: 18px;">
                        <line x1="12" y1="5" x2="12" y2="19" />
                        <line x1="5" y1="12" x2="19" y2="12" />
                    </svg>
                    Novo Cargo
                </a>
    }
            </div>

            @if (Model.Count == 0)
            {
                <div class="empty-state">
                    <h3>Nenhum cargo criado</h3>
                    <p style="margin-top: 8px; font-size: 14px;">Crie seu primeiro cargo para começar a atribuir funcionários</p>
                </div>
            }
            else
            {
                <div class="cards-grid">
                    @foreach (var cargo in Model.OrderBy(c => c.Nome))
                    {
                        <div class="card">
                            <div class="card-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 24px; height: 24px;">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                    <circle cx="12" cy="7" r="4" />
                                </svg>
                            </div>
                            <div class="card-title">@cargo.Nome</div>
                            <div class="card-desc">@(string.IsNullOrEmpty(cargo.Descricao) ? "Sem descrição" : cargo.Descricao)</div>

                            <div class="card-meta">
                                <span class="status-badge @(cargo.Ativo ? "ativo" : "inativo")">
                                    @(cargo.Ativo ? "Ativo" : "Inativo")
                                </span>
                                <span class="card-date">@cargo.DataCriacao.ToString("dd/MM/yyyy")</span>
                            </div>

                            <div class="card-actions">
                                <button class="btn-action" onclick="window.location.href='/Cargo/Permissoes/@cargo.CargoId'">Permissoes</button>
                                <button class="btn-action" onclick="window.location.href='/Cargo/Edit/@cargo.CargoId'">Editar</button>
                                <form action="/Cargo/Delete/@cargo.CargoId" method="POST" style="flex: 1; margin: 0;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-action danger" onclick="return confirm('Tem certeza que deseja deletar este cargo?')" style="width: 100%;">Deletar</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </main>
</body>
</html>
